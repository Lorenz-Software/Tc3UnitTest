<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CreateAssertionTextValue_Real" Id="{4197326a-d0cb-4d0d-ae62-a367e4e7fcf8}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Formats REAL diagnostics without floating-point arithmetic or native real-to-string conversion.</summary>
<description>Configurable significant decimal digits (default 6, clamped to 1..9), ties-to-even; NaN, +Inf, -Inf and signed zero are explicit.
Scientific notation keeps extreme values within AssertionValueLength. Does not determine Assertion validity.</description>
*)
{endregion}
FUNCTION INTERNAL CreateAssertionTextValue_Real : STRING(GVL_Constants.AssertionValueLength) //! Bounded diagnostic text; not a value for subsequent numeric comparison.
VAR_INPUT
    Value : REAL; //! Value to render as diagnostic text; formatting does not change comparison semantics.
    SignificantDigits : UINT := 6; //! Significant decimal digits; default 6, clamped to 1..9.
END_VAR
VAR
    Representation : AssertionRealRepresentation;
    Fraction : ULINT;
    ExponentField : INT;
    Exponent : INT;
    Negative : BOOL;
END_VAR
VAR CONSTANT
    SignMask : DWORD := DWORD#16#80000000;
    FractionMask : DWORD := DWORD#16#007FFFFF;
    ExponentMask : DWORD := DWORD#16#000000FF;
    FractionBits : INT := 23;
    ExponentBias : INT := 127;
    SpecialExponent : INT := 255;
    ImplicitBit : ULINT := ULINT#8388608;
    MaximumSignificantDigits : UINT := 9;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[Representation.Value := Value;
Negative := (Representation.Bits AND SignMask) <> 0;
Fraction := DWORD_TO_ULINT(Representation.Bits AND FractionMask);
ExponentField := DWORD_TO_INT(SHR(Representation.Bits, FractionBits) AND ExponentMask);
IF ExponentField = SpecialExponent THEN
    IF Fraction <> 0 THEN
        CreateAssertionTextValue_Real := 'NaN';
    ELSIF Negative THEN
        CreateAssertionTextValue_Real := '-Inf';
    ELSE
        CreateAssertionTextValue_Real := '+Inf';
    END_IF;
    RETURN;
END_IF;

IF ExponentField = 0 THEN
    Exponent := 1 - ExponentBias - FractionBits;
ELSE
    Fraction := Fraction + ImplicitBit;
    Exponent := ExponentField - ExponentBias - FractionBits;
END_IF;
CreateAssertionTextValue_Real := CreateAssertionTextValue_BinaryFloat(Significand := Fraction,
    BinaryExponent := Exponent,
    Negative := Negative,
    SignificantDigits := UINT_TO_INT(LIMIT(UINT#1, SignificantDigits, MaximumSignificantDigits)));]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>