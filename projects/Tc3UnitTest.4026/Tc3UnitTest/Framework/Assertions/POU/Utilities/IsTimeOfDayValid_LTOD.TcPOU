<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IsTimeOfDayValid_LTOD" Id="{435d5324-23f8-464a-8007-409e122e04a8}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks the native time-of-day range without changing or normalizing Value.</summary>
*)
{endregion}
FUNCTION INTERNAL IsTimeOfDayValid_LTOD : BOOL //! TRUE for a time of day below 24 hours; the value is not normalized.
VAR_INPUT
    Value : LTOD; //! Time-of-day value checked against the interval from midnight inclusive to the next midnight exclusive.
END_VAR
VAR CONSTANT
    MaximumTimeOfDay : LTOD := LTOD#23:59:59.999999999;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IsTimeOfDayValid_LTOD := Value <= MaximumTimeOfDay;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>