<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IsWithinTolerance_Real" Id="{b83d722d-5fa6-406c-9b8b-6a769a9d3701}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Tests absolute tolerance without overflowing the typed difference. Requires finite inputs and a finite, non-negative tolerance; the caller validates them.</summary>
*)
{endregion}
FUNCTION INTERNAL IsWithinTolerance_Real : BOOL //! TRUE when the absolute difference is within Tolerance; caller must supply finite valid inputs.
VAR_INPUT
    IN : REAL; //! Actual value checked or observed by this Assertion.
    Expected : REAL; //! Reference value for comparison with IN.
    Tolerance : REAL; //! Maximum absolute difference accepted as equal; must be finite and non-negative.
END_VAR
VAR
    ActualMagnitude : REAL;
    ExpectedMagnitude : REAL;
    LargeMagnitude : REAL;
    SmallMagnitude : REAL;
    RemainingMagnitude : REAL;
    Difference : REAL;
END_VAR
VAR CONSTANT
    MaxFinite : REAL := REAL#3.40282346638528859811704183484516925440E38;
    HalfMaxFinite : REAL := MaxFinite / REAL#2.0;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IsWithinTolerance_Real := FALSE;

IF ((IN < 0.0) AND (Expected > 0.0)) OR ((IN > 0.0) AND (Expected < 0.0)) THEN
    ActualMagnitude := ABS(IN);
    ExpectedMagnitude := ABS(Expected);
    LargeMagnitude := MAX(ActualMagnitude, ExpectedMagnitude);
    SmallMagnitude := MIN(ActualMagnitude, ExpectedMagnitude);

    IF LargeMagnitude >= HalfMaxFinite THEN
        // Exact subtraction: MaxFinite and LargeMagnitude are within a factor of two.
        RemainingMagnitude := MaxFinite - LargeMagnitude;
        IF SmallMagnitude > RemainingMagnitude THEN
            RETURN;
        END_IF;
    END_IF;
END_IF;

Difference := ABS(IN - Expected);
IsWithinTolerance_Real := Difference <= Tolerance;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>