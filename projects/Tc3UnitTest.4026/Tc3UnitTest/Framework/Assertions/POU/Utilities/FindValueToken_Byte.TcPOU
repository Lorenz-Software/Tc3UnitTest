<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FindValueToken_Byte" Id="{100ee83d-2138-49a0-baac-90658f982559}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Finds the first masked value token in the selected range. Caller validates stable references, a nonempty in-bounds range.</summary>
*)
{endregion}
FUNCTION INTERNAL FindValueToken_Byte : BOOL //! TRUE when a token was found; Index is its absolute array index and may legitimately be zero.
VAR_INPUT
    StartIndex : DINT; //! First selected index in IN; uses the array's declared index range, not a zero-based offset.
    Length : USINT; //! Number of selected elements starting at StartIndex; must fit the array range; valid range 1..255.
    Token : BYTE; //! Value searched for in the selected range; Mask selects the compared bits.
    Mask : BYTE; //! Bits included in the comparison; bits outside the mask are ignored.
END_VAR
VAR_OUTPUT
    Index : DINT; //! Absolute matching index; zero when no match exists. Use the BOOL result to distinguish.
END_VAR
VAR_IN_OUT CONSTANT
    IN : ARRAY[*] OF BYTE; //! Read-only actual data; the selected range must remain stable during the call.
END_VAR
VAR
    CandidateOffset : LINT;
    InIndex : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[FindValueToken_Byte := FALSE;
Index := 0;

FOR CandidateOffset := 0 TO USINT_TO_LINT(Length) - 1 DO
    InIndex := LINT_TO_DINT(DINT_TO_LINT(StartIndex) + CandidateOffset);
    IF (IN[InIndex] AND Mask) = (Token AND Mask) THEN
        Index := LINT_TO_DINT(DINT_TO_LINT(StartIndex) + CandidateOffset);
        FindValueToken_Byte := TRUE;
        RETURN;
    END_IF;
END_FOR;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>