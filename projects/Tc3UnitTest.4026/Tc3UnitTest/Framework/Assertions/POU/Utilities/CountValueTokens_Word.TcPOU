<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CountValueTokens_Word" Id="{1a8378e7-c6bf-47e8-ba4f-d1422f2f99f4}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Counts all masked value matches in the selected range. Caller validates stable references, a nonempty in-bounds range.</summary>
*)
{endregion}
FUNCTION INTERNAL CountValueTokens_Word : UINT //! Number of masked value matches in the selected range.
VAR_INPUT
    StartIndex : DINT; //! First selected index in IN; uses the array's declared index range, not a zero-based offset.
    Length : USINT; //! Number of selected elements starting at StartIndex; must fit the array range; valid range 1..255.
    Token : WORD; //! Value searched for in the selected range; Mask selects the compared bits.
    Mask : WORD; //! Bits included in the comparison; bits outside the mask are ignored.
END_VAR
VAR_IN_OUT CONSTANT
    IN : ARRAY[*] OF WORD; //! Read-only actual data; the selected range must remain stable during the call.
END_VAR
VAR
    CandidateOffset : LINT;
    InIndex : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CountValueTokens_Word := 0;

FOR CandidateOffset := 0 TO USINT_TO_LINT(Length) - 1 DO
    InIndex := LINT_TO_DINT(DINT_TO_LINT(StartIndex) + CandidateOffset);
    IF (IN[InIndex] AND Mask) = (Token AND Mask) THEN
        CountValueTokens_Word := CountValueTokens_Word + 1;
    END_IF;
END_FOR;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>