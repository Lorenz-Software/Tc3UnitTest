<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="IsAssertionStringLengthValid" Id="{6362cc49-8ec9-4c1d-8505-c4884ee635c7}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks for a terminator within the configured content capacity, including empty text. Reads at most capacity + 1 code units and stops at the first terminator.</summary>
*)
{endregion}
FUNCTION INTERNAL IsAssertionStringLengthValid : BOOL //! TRUE when a terminator occurs within the configured capacity, including empty text.
VAR_IN_OUT CONSTANT
    Value : STRING(Param_Assertions.AssertionStringLength); //! Read-only text to check for termination within its configured capacity.
END_VAR
VAR
    CharacterIndex : DINT;
END_VAR
VAR CONSTANT
    Terminator : BYTE := 0;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IsAssertionStringLengthValid := FALSE;
FOR CharacterIndex := 0 TO UINT_TO_DINT(Param_Assertions.AssertionStringLength) DO
    // SA0175: Exact byte comparison; caller validates termination/capacity and indices stay in bounds.
    {analysis -175}
    IF Value[CharacterIndex] = Terminator THEN
    {analysis +175}
        IsAssertionStringLengthValid := TRUE;
        RETURN;
    END_IF;
END_FOR;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>