<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertArrayHasNoInfinity_Real" Id="{373350dc-e66b-48cc-9936-68539d636682}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that the selected range contains no infinity; NaN is allowed.</summary>
<description>

Invalid binding/range is Error; a classification mismatch is Failed. Only the selected
range is inspected.

StartIndex is an absolute declared IN index, not an offset. Length selects 1..255
elements; the complete selected range must fit IN. Invalid references or ranges report
Error.

Keep supplied arrays stable for the call. Input data is read, not copied or retained as a
snapshot.

NaN and either infinity are legitimate checked data, not configuration errors.
Classification mismatch reports Failed. Bit-based classification does not perform an ordered
floating-point comparison.

Numeric diagnostics use the formatter's default six significant digits; rounding affects
the message only, not the comparison.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertArrayHasNoInfinity_Real EXTENDS AssertionBase
VAR_INPUT
    StartIndex : DINT; //! First selected index in IN; uses the array's declared index range, not a zero-based offset.
    Length : USINT; //! Number of inspected elements, from 1 through 255.
END_VAR
VAR_IN_OUT CONSTANT
    IN : ARRAY[*] OF REAL; //! Read-only checked data; keep stable during the call.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{a6310003-0000-4000-8000-000000000005}" />
    <Method Name="Assert" Id="{a6310003-0001-4000-8000-000000000005}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validates the selected range, then classifies element representations.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    InLowerIndex : DINT;
    InUpperIndex : DINT;
    EndIndex : LINT;
    Offset : LINT;
    InIndex : DINT;
    ValueFound : BOOL;
    Representation : AssertionRealRepresentation;
    Message : STRING(GVL_Constants.MessageLength);
END_VAR
VAR CONSTANT
    ExponentMask : DWORD := DWORD#16#7F800000;
    FractionMask : DWORD := DWORD#16#007FFFFF;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

// C0371: FB input is checked here before any reference access.
{warning disable C0371}
IF NOT __ISVALIDREF(IN) THEN
    Error(Message := 'Assertion error: IN reference is invalid.');
    RETURN;
END_IF;

InLowerIndex := LOWER_BOUND(IN, 1);
InUpperIndex := UPPER_BOUND(IN, 1);
EndIndex := DINT_TO_LINT(StartIndex) + USINT_TO_LINT(Length) - 1;

IF (Length = 0)
    OR (StartIndex < InLowerIndex) OR (StartIndex > InUpperIndex)
    OR (EndIndex > DINT_TO_LINT(InUpperIndex)) THEN
    Message := CONCAT('Assertion error: array range is invalid. StartIndex = ',
        DINT_TO_STRING(StartIndex));
    Message := CONCAT(Message, ', Length = ');
    Message := CONCAT(Message, USINT_TO_STRING(Length));
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

ValueFound := FALSE;
FOR Offset := 0 TO USINT_TO_LINT(Length) - 1 DO
    InIndex := LINT_TO_DINT(DINT_TO_LINT(StartIndex) + Offset);
    Representation.Value := IN[InIndex];
    ValueFound := ((Representation.Bits AND ExponentMask) = ExponentMask)
        AND ((Representation.Bits AND FractionMask) = 0);
    IF ValueFound THEN
        EXIT;
    END_IF;
END_FOR;

IF ValueFound THEN
    Message := 'Assertion failed: array range contains infinity.';
    Message := CONCAT(Message, ' Actual[');
    Message := CONCAT(Message, DINT_TO_STRING(InIndex));
    Message := CONCAT(Message, '] = ');
    Message := CONCAT(Message, CreateAssertionTextValue_Real(Value := Representation.Value));
    Message := CONCAT(Message, ', Range = [');
    Message := CONCAT(Message, DINT_TO_STRING(StartIndex));
    Message := CONCAT(Message, '..');
    Message := CONCAT(Message, LINT_TO_STRING(EndIndex));
    Message := CONCAT(Message, '].');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();
{warning restore C0371}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>