<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertEqualArray_Real" Id="{566e887f-cf30-48f3-9195-59e2bada133b}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Compares the entire Expected array with IN starting at StartIndex.</summary>
<description>

StartIndex is an absolute declared IN index. The entire Expected array, starting at its
own lower bound, determines the compared length and must fit IN. Invalid references or ranges
report Error.

Keep supplied arrays stable for the call. Input data is read, not copied or retained as a
snapshot.

Every Expected element must be finite; otherwise Error. A non-finite actual element is a
mismatch (Failed), not an invalid Expected value.

Tolerance is absolute, in the same units as the values, finite and non-negative. Its
default zero requests exact comparison. The equality boundary is inclusive; larger differences
are unequal. Difference checking avoids overflow for large finite operands.

Numeric diagnostics use the formatter's default six significant digits; rounding affects
the message only, not the comparison.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertEqualArray_Real EXTENDS AssertionBase
VAR_INPUT
    Tolerance : REAL := 0.0; //! Maximum absolute allowed difference; finite and non-negative.
    StartIndex : DINT; //! First compared index in IN; Expected starts at its own lower bound.
END_VAR
VAR_IN_OUT CONSTANT
    IN : ARRAY[*] OF REAL; //! Read-only actual data; the selected range must remain stable during the call.
    Expected : ARRAY[*] OF REAL; //! Read-only expected sequence starting at its own lower bound; must fit the selected actual range.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{c84a22af-ae9e-4d59-889f-4d7225c7e196}" />
    <Method Name="Assert" Id="{ea370c26-ee25-4da7-aef8-8c889f274dba}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validate the selected range and expectations before comparing elements.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    ReferenceValue : REAL;
    ValuesEqual : BOOL;
    Value : REAL;
    InLowerIndex : DINT;
    InUpperIndex : DINT;
    ExpectedLowerIndex : DINT;
    ExpectedUpperIndex : DINT;
    ExpectedLength : LINT;
    EndIndex : LINT;
    Offset : LINT;
    InIndex : DINT;
    ExpectedIndex : DINT;
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

// C0371: FB inputs are checked here before any reference access.
{warning disable C0371}
IF NOT __ISVALIDREF(IN) THEN
    Error(Message := 'Assertion error: IN reference is invalid.');
    RETURN;
END_IF;

IF NOT __ISVALIDREF(Expected) THEN
    Error(Message := 'Assertion error: Expected reference is invalid.');
    RETURN;
END_IF;

IF NOT Tc2_Utilities.RealIsFinite(x := Tolerance) THEN
    Error(Message := 'Assertion error: Tolerance must be finite.');
    RETURN;
END_IF;

IF Tolerance < 0.0 THEN
    Error(Message := 'Assertion error: Tolerance must not be negative.');
    RETURN;
END_IF;

InLowerIndex := LOWER_BOUND(IN, 1);
InUpperIndex := UPPER_BOUND(IN, 1);
ExpectedLowerIndex := LOWER_BOUND(Expected, 1);
ExpectedUpperIndex := UPPER_BOUND(Expected, 1);
ExpectedLength := DINT_TO_LINT(ExpectedUpperIndex) - DINT_TO_LINT(ExpectedLowerIndex) + 1;
EndIndex := DINT_TO_LINT(StartIndex) + ExpectedLength - 1;

IF (ExpectedLength <= 0)
    OR (StartIndex < InLowerIndex) OR (StartIndex > InUpperIndex)
    OR (EndIndex > DINT_TO_LINT(InUpperIndex)) THEN
    Message := CONCAT('Assertion error: array range is invalid. StartIndex = ',
        DINT_TO_STRING(StartIndex));
    Message := CONCAT(Message, ', EndIndex = ');
    Message := CONCAT(Message, LINT_TO_STRING(EndIndex));
    Message := CONCAT(Message, ', InLowerIndex = ');
    Message := CONCAT(Message, DINT_TO_STRING(InLowerIndex));
    Message := CONCAT(Message, ', InUpperIndex = ');
    Message := CONCAT(Message, DINT_TO_STRING(InUpperIndex));
    Message := CONCAT(Message, ', ExpectedLength = ');
    Message := CONCAT(Message, LINT_TO_STRING(ExpectedLength));
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

FOR Offset := 0 TO ExpectedLength - 1 DO
    ExpectedIndex := LINT_TO_DINT(DINT_TO_LINT(ExpectedLowerIndex) + Offset);
    Value := Expected[ExpectedIndex];
    IF NOT Tc2_Utilities.RealIsFinite(x := Value) THEN
        Message := CONCAT('Assertion error: Expected element must be finite. Index = ',
            DINT_TO_STRING(ExpectedIndex));
        Message := CONCAT(Message, '.');
        Error(Message := Message);
        RETURN;
    END_IF;
END_FOR;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

FOR Offset := 0 TO ExpectedLength - 1 DO
    InIndex := LINT_TO_DINT(DINT_TO_LINT(StartIndex) + Offset);
    ExpectedIndex := LINT_TO_DINT(DINT_TO_LINT(ExpectedLowerIndex) + Offset);
    Value := IN[InIndex];
    ReferenceValue := Expected[ExpectedIndex];
    ValuesEqual := FALSE;
    IF NOT Tc2_Utilities.RealIsNaN(x := Value) THEN
        IF Value = ReferenceValue THEN
            ValuesEqual := TRUE;
        ELSIF Tc2_Utilities.RealIsFinite(x := Value)
            AND Tc2_Utilities.RealIsFinite(x := ReferenceValue) THEN
            ValuesEqual := IsWithinTolerance_Real(IN := Value,
                Expected := ReferenceValue,
                Tolerance := Tolerance);
        END_IF;
    END_IF;
    IF NOT ValuesEqual THEN
        ExpectedText := CreateAssertionTextValue_Real(Value := Expected[ExpectedIndex]);
        Value := IN[InIndex];
        IF Tc2_Utilities.RealIsFinite(x := Value) THEN
            ActualText := CreateAssertionTextValue_Real(Value := IN[InIndex]);
        ELSE
            ActualText := '<non-finite>';
        END_IF;
        Message := CONCAT('Assertion failed: array elements differ. Expected[',
            DINT_TO_STRING(ExpectedIndex));
        Message := CONCAT(Message, '] = ');
        Message := CONCAT(Message, ExpectedText);
        Message := CONCAT(Message, ', IN[');
        Message := CONCAT(Message, DINT_TO_STRING(InIndex));
        Message := CONCAT(Message, '] = ');
        Message := CONCAT(Message, ActualText);
        Message := CONCAT(Message, '.');
        Message := CONCAT(Message, ' Tolerance = ');
        Message := CONCAT(Message, CreateAssertionTextValue_Real(Value := Tolerance));
        Fail(Message := Message);
        RETURN;
    END_IF;
END_FOR;

Pass();
{warning restore C0371}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>