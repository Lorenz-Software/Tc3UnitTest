<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertValueTokenCntNotEqual_Byte" Id="{21d38e91-b2ab-4ab6-b621-9f84527d2102}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that the token count differs from Expected.</summary>
<description>

StartIndex is an absolute declared IN index, not an offset. Length selects 1..255
elements; the complete selected range must fit IN. Invalid references or ranges report
Error.

Keep supplied arrays stable for the call. Input data is read, not copied or retained as a
snapshot.

Comparison applies Mask to both values; bits outside it are ignored. The default mask
selects all bits.

Counts the currently selected region on evaluation, not occurrences across cycles.
TokenCount exposes the last computed count.

The value token matches under Mask; bits outside Mask are ignored.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertValueTokenCntNotEqual_Byte EXTENDS AssertionBase
VAR_INPUT
    StartIndex : DINT; //! First selected index in IN; uses the array's declared index range, not a zero-based offset.
    Length : USINT; //! Number of selected elements starting at StartIndex; must fit the array range; valid range 1..255.
    Expected : UINT; //! Reference count for the named relation; counts occurrences, not array indices.
    Token : BYTE; //! Value searched for in the selected range; Mask selects the compared bits.
    Mask : BYTE := BYTE#16#FF; //! Bits included in the comparison; bits outside the mask are ignored.
END_VAR
VAR_IN_OUT CONSTANT
    IN : ARRAY[*] OF BYTE; //! Keep the searched data stable during the call.
END_VAR
VAR
    FTokenCount : UINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{17f3eb70-aabf-4c78-874d-2cea67c738dc}" />
    <Method Name="Assert" Id="{9480e3d4-8d2a-420b-81ce-7bfbb61012e2}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validate configuration, count tokens and apply the count predicate.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    InLowerIndex : DINT;
    InUpperIndex : DINT;
    EndIndex : LINT;
    Message : STRING(GVL_Constants.MessageLength);
END_VAR
VAR CONSTANT
    HexDigitCount : USINT := 2;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

// C0371: FB input is checked before any reference access.
{warning disable C0371}
IF NOT __ISVALIDREF(IN) THEN
    FTokenCount := 0;
    Error(Message := 'Assertion error: IN reference is invalid.');
    RETURN;
END_IF;

InLowerIndex := LOWER_BOUND(IN, 1);
InUpperIndex := UPPER_BOUND(IN, 1);
EndIndex := DINT_TO_LINT(StartIndex) + USINT_TO_LINT(Length) - 1;
IF (Length = 0)
    OR (StartIndex < InLowerIndex) OR (StartIndex > InUpperIndex)
    OR (EndIndex > DINT_TO_LINT(InUpperIndex)) THEN
    FTokenCount := 0;
    Message := CONCAT('Assertion error: invalid search range. StartIndex = ',
        DINT_TO_STRING(StartIndex));
    Message := CONCAT(Message, ', Length = ');
    Message := CONCAT(Message, USINT_TO_STRING(Length));
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

FTokenCount := CountValueTokens_Byte(StartIndex := StartIndex,
    Length := Length,
    Token := Token,
    Mask := Mask,
    IN := IN);

IF FTokenCount = Expected THEN
    Message := CONCAT('Assertion failed: value token count violates NotEqual. Actual = ',
        UINT_TO_STRING(FTokenCount));
    Message := CONCAT(Message, ', Expected = ');
    Message := CONCAT(Message, UINT_TO_STRING(Expected));
    Message := CONCAT(Message, ', Token = ');
    Message := CONCAT(Message, CreateAssertionTextValue_Hex(Value := BYTE_TO_LWORD(Token),
        DigitCount := HexDigitCount));
    Message := CONCAT(Message, ', Mask = ');
    Message := CONCAT(Message, CreateAssertionTextValue_Hex(Value := BYTE_TO_LWORD(Mask),
        DigitCount := HexDigitCount));
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();
{warning restore C0371}]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetAssertion" Id="{5a49ede4-8aae-48b5-8964-2bb122663044}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clear the retained count on framework reset.</summary>
*)
{endregion}
METHOD PROTECTED ResetAssertion]]></Declaration>
      <Implementation>
        <ST><![CDATA[FTokenCount := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="TokenCount" Id="{0d1befad-f2f0-48eb-bc7a-70d38aef3a69}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Return the most recently evaluated token count.</summary>
<description>

Counts occurrences in one selected array region, not across PLC cycles. Retained while
disabled or after Failed; reset and detected configuration errors clear it. Reading this
property does not search the array.

</description>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC TokenCount : UINT //! Return the most recently evaluated token count.]]></Declaration>
      <Get Name="Get" Id="{98aab054-b972-4a09-b3e4-f3d4225b445d}">
        <Declaration><![CDATA[PUBLIC
VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[TokenCount := FTokenCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>