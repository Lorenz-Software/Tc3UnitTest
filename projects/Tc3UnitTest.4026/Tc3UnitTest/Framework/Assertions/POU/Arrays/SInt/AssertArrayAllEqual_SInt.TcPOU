<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertArrayAllEqual_SInt" Id="{105da7f7-ed00-4f02-a287-a373b88e335b}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks every selected IN element against Expected; reports the first
mismatch.</summary>
<description>

StartIndex is an absolute declared IN index, not an offset. Length selects 1..255
elements; the complete selected range must fit IN. Invalid references or ranges report
Error.

Keep supplied arrays stable for the call. Input data is read, not copied or retained as a
snapshot.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertArrayAllEqual_SInt EXTENDS AssertionBase
VAR_INPUT
    StartIndex : DINT; //! First selected index in IN; uses the array's declared index range, not a zero-based offset.
    Length : USINT; //! Number of compared elements, from 1 through 255.
    Expected : SINT; //! Reference value for comparison with IN.
END_VAR
VAR_IN_OUT CONSTANT
    IN : ARRAY[*] OF SINT; //! Read-only compared data; keep stable during the call.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{c3606ed0-ffa7-4700-ad23-47d38dfc7495}" />
    <Method Name="Assert" Id="{ac7d026f-1e97-4b49-8219-ddf94e5ddf8e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validate configuration before comparing the selected range.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    InLowerIndex : DINT;
    InUpperIndex : DINT;
    EndIndex : LINT;
    Offset : LINT;
    InIndex : DINT;
    ValuesEqual : BOOL;
    Message : STRING(GVL_Constants.MessageLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

// C0371: FB input is checked here before any reference access.
{warning disable C0371}
IF NOT __ISVALIDREF(IN) THEN
    Error(Message := 'Assertion error: IN reference is invalid.');
    RETURN;
END_IF;

InLowerIndex := LOWER_BOUND(IN, 1);
InUpperIndex := UPPER_BOUND(IN, 1);
EndIndex := DINT_TO_LINT(StartIndex) + USINT_TO_LINT(Length) - 1;

IF (Length = 0)
    OR (StartIndex < InLowerIndex) OR (StartIndex > InUpperIndex)
    OR (EndIndex > DINT_TO_LINT(InUpperIndex)) THEN
    Message := CONCAT('Assertion error: array range is invalid. StartIndex = ',
        DINT_TO_STRING(StartIndex));
    Message := CONCAT(Message, ', Length = ');
    Message := CONCAT(Message, USINT_TO_STRING(Length));
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

FOR Offset := 0 TO USINT_TO_LINT(Length) - 1 DO
    InIndex := LINT_TO_DINT(DINT_TO_LINT(StartIndex) + Offset);
    ValuesEqual := FALSE;
    ValuesEqual := IN[InIndex] = Expected;
    IF NOT ValuesEqual THEN
        EXIT;
    END_IF;
END_FOR;

IF NOT ValuesEqual THEN
    ExpectedText := SINT_TO_STRING(Expected);
    ActualText := SINT_TO_STRING(IN[InIndex]);
    Message := CONCAT('Assertion failed: array value is not equal. Expected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual[');
    Message := CONCAT(Message, DINT_TO_STRING(InIndex));
    Message := CONCAT(Message, '] = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, ', Range = [');
    Message := CONCAT(Message, DINT_TO_STRING(StartIndex));
    Message := CONCAT(Message, '..');
    Message := CONCAT(Message, LINT_TO_STRING(EndIndex));
    Message := CONCAT(Message, ']');
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();
{warning restore C0371}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>