<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertLessEqual_Int" Id="{f446f0f3-b011-4b77-8ab8-fa4364f33e09}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at most Maximum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertLessEqual_Int EXTENDS AssertionBase
VAR_INPUT
    IN : INT; //! Actual value checked or observed by this Assertion.
    Maximum : INT; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{6c858112-c689-4964-a700-45b5fbe67deb}" />
    <Method Name="Assert" Id="{579173e4-3e83-4c19-8fbc-099b2cd99a43}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at most Maximum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN > Maximum THEN
    MaximumText := INT_TO_STRING(Maximum);
    ActualText := INT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is above maximum. Maximum = ',
        MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>