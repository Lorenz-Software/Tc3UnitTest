<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertInRange_Int" Id="{19c16690-5a89-4a0c-80fa-a67b1b360ff8}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks whether the INT value is inside the inclusive range.</summary>
<description>

Minimum &gt; Maximum reports Error during active evaluation; equal bounds are
valid.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertInRange_Int EXTENDS AssertionBase
VAR_INPUT
    IN : INT; //! Actual value checked or observed by this Assertion.
    Minimum : INT; //! Inclusive lower bound of the comparison; for a range, must not exceed Maximum.
    Maximum : INT; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{a03802d7-c01f-4a8c-99b8-d01fecf880d3}" />
    <Method Name="Assert" Id="{240d9207-eb64-44cd-8d39-ba5aa568bc24}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check whether the INT value is inside the inclusive range.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Minimum > Maximum THEN
    MinimumText := INT_TO_STRING(Minimum);
    MaximumText := INT_TO_STRING(Maximum);
    Message := CONCAT('Assertion error: minimum exceeds maximum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN < Minimum) OR (IN > Maximum) THEN
    MinimumText := INT_TO_STRING(Minimum);
    MaximumText := INT_TO_STRING(Maximum);
    ActualText := INT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is outside allowed range. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>