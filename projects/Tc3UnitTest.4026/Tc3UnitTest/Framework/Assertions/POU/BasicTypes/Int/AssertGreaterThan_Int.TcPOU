<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertGreaterThan_Int" Id="{3e0985e9-fbc6-454b-be6d-37a3ccb6c77b}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is greater than Minimum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertGreaterThan_Int EXTENDS AssertionBase
VAR_INPUT
    IN : INT; //! Actual value checked or observed by this Assertion.
    Minimum : INT; //! Exclusive lower bound; the actual value or count must be greater.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{32de19f6-7e30-48b1-932d-778ba0579839}" />
    <Method Name="Assert" Id="{c327c4f9-86c9-403e-972d-e375e866c826}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is greater than Minimum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <= Minimum THEN
    MinimumText := INT_TO_STRING(Minimum);
    ActualText := INT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not greater than minimum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>