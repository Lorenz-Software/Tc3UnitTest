<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNoValueChange_LTOD" Id="{4269a0f0-6561-437d-9a34-0a77ffe04d0f}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check equality between consecutive active observations.</summary>
<description>

The first active observation establishes a baseline without deciding a result. Disabling
observation invalidates that baseline, not the held Result. Re-enabling first establishes a new
baseline; Reset clears history.

ObserveFirstCycle FALSE delays the first observation by one enabled call.

An observed value at or beyond 24 hours reports Error, including baseline capture.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertNoValueChange_LTOD EXTENDS AssertionBase
VAR_INPUT
    IN : LTOD; //! Actual value to observe.
END_VAR
VAR
    FINPrevious : LTOD;
    FObservationPrevious : BOOL;
    FEvaluationActive : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{0ddaa541-6021-4e22-9d52-ab65b48497fb}" />
    <Method Name="Assert" Id="{948446e1-2647-4dd4-a83c-65f83798c255}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Observe the current value before evaluating a change against the previous observation.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    PreviousValue : LTOD;
    Message : STRING(GVL_Constants.MessageLength);
    PreviousText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEvaluationActive := ObservationActive AND FObservationPrevious;
FObservationPrevious := ObservationActive;

IF NOT ObservationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF NOT IsTimeOfDayValid_LTOD(Value := IN) THEN
    Error(Message := 'Assertion error: IN is outside the valid LTOD range (less than 24 hours).');
    RETURN;
END_IF;

PreviousValue := FINPrevious;
FINPrevious := IN;

IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <> PreviousValue THEN
    PreviousText := LTOD_TO_STRING(PreviousValue);
    ActualText := LTOD_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value changed unexpectedly. Previous = ',
        PreviousText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
    <Property Name="EvaluationActive" Id="{98f6b64d-b520-42c6-975d-fd505b40a33a}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Current/last call has an active observation and a preceding observation
baseline.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC EvaluationActive : BOOL //! Current/last call has an active observation and a preceding observation baseline.]]></Declaration>
      <Get Name="Get" Id="{e72e729a-f004-47f1-a703-6c3ae9a35986}">
        <Declaration><![CDATA[PUBLIC]]></Declaration>
        <Implementation>
          <ST><![CDATA[EvaluationActive := FEvaluationActive;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ResetAssertion" Id="{1415c2aa-987e-4787-9d73-4ba90c530ffd}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clear observation history and the current evaluation gate.</summary>
*)
{endregion}
METHOD PROTECTED ResetAssertion]]></Declaration>
      <Implementation>
        <ST><![CDATA[FINPrevious := LTOD#00:00:00;
FObservationPrevious := FALSE;
FEvaluationActive := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>