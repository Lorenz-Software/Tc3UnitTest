<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertLaterThan_LTOD" Id="{278b21ee-f1b6-4df6-8d52-2c51538a8611}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is strictly later than Minimum.</summary>
<description>

A value at or beyond 24 hours reports Error before comparison or baseline capture.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertLaterThan_LTOD EXTENDS AssertionBase
VAR_INPUT
    IN : LTOD; //! Actual value checked or observed by this Assertion.
    Minimum : LTOD; //! Exclusive lower bound; the actual value or count must be greater.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{59450544-7a4e-491a-bea4-302127669e9c}" />
    <Method Name="Assert" Id="{72702d97-d1f1-4db1-a075-27f79ef517fb}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Evaluate the typed temporal relation and report higher-priority errors first.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF NOT IsTimeOfDayValid_LTOD(Value := IN) THEN
    Error(Message := 'Assertion error: IN is outside the valid LTOD range (less than 24 hours).');
    RETURN;
END_IF;

IF NOT IsTimeOfDayValid_LTOD(Value := Minimum) THEN
    Error(Message := 'Assertion error: Minimum is outside the valid LTOD range (less than 24 hours).');
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <= Minimum THEN
    MinimumText := LTOD_TO_STRING(Minimum);
    ActualText := LTOD_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not later than limit. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>