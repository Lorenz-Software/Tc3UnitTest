<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertInRange_UInt" Id="{6b4c395f-dea1-4401-92a9-26d67ee9eabc}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks whether the UINT value is inside the inclusive range.</summary>
<description>

Minimum &gt; Maximum reports Error during active evaluation; equal bounds are
valid.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertInRange_UInt EXTENDS AssertionBase
VAR_INPUT
    IN : UINT; //! Actual value checked or observed by this Assertion.
    Minimum : UINT; //! Inclusive lower bound of the comparison; for a range, must not exceed Maximum.
    Maximum : UINT; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{d05e81fa-3d73-4bd5-9697-72f203260820}" />
    <Method Name="Assert" Id="{dd0a2924-8027-415d-b275-34769469f763}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check whether the UINT value is inside the inclusive range.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Minimum > Maximum THEN
    MinimumText := UINT_TO_STRING(Minimum);
    MaximumText := UINT_TO_STRING(Maximum);
    Message := CONCAT('Assertion error: minimum exceeds maximum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN < Minimum) OR (IN > Maximum) THEN
    MinimumText := UINT_TO_STRING(Minimum);
    MaximumText := UINT_TO_STRING(Maximum);
    ActualText := UINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is outside allowed range. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>