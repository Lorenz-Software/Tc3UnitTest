<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertFalseBit_Byte" Id="{6be42615-8098-4e77-9bd7-8d19cb2c8763}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that the selected BYTE bit is FALSE.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertFalseBit_Byte EXTENDS AssertionBase
VAR_INPUT
    IN : BYTE; //! Actual bitfield.
    BitIndex : USINT; //! Zero-based bit index (0..7); an invalid index produces Error during evaluation.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{ea58740a-2e1c-4987-a384-a442f912905a}" />
    <Method Name="Assert" Id="{59ff5ed8-4fdd-4d92-893c-16d400338f37}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validates the index before evaluating the selected bit.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Mask : BYTE;
    ActualBit : BOOL;
    Message : STRING(GVL_Constants.MessageLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    MaxBitIndex : USINT := 7;
    SingleBitMask : BYTE := 16#01;
    NoBitMask : BYTE := 16#00;
    HexDigitCount : USINT := 2;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF BitIndex > MaxBitIndex THEN
    Message := CONCAT('Assertion error: bit index is outside valid range. BitIndex = ',
        USINT_TO_STRING(BitIndex));
    Message := CONCAT(Message, ', MaxBitIndex = ');
    Message := CONCAT(Message, USINT_TO_STRING(MaxBitIndex));
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

Mask := SHL(SingleBitMask, BitIndex);
ActualBit := (IN AND Mask) <> NoBitMask;

IF ActualBit THEN
    ActualText := CreateAssertionTextValue_Hex(Value := BYTE_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: bit is TRUE but must be FALSE. BitIndex = ',
        USINT_TO_STRING(BitIndex));
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>