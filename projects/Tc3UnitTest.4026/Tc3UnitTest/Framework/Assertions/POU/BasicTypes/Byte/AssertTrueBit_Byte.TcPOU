<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertTrueBit_Byte" Id="{ae19da72-7fd9-4359-882e-124aac5597a5}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that the selected BYTE bit is TRUE.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertTrueBit_Byte EXTENDS AssertionBase
VAR_INPUT
    IN : BYTE; //! Actual bitfield.
    BitIndex : USINT; //! Zero-based bit index (0..7); an invalid index produces Error during evaluation.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{7c07f6b8-8d2b-4c1e-8ff8-cefec54d9ee9}" />
    <Method Name="Assert" Id="{9540b67a-b677-4e4c-a45e-6ae8e9528baf}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validates the index before evaluating the selected bit.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Mask : BYTE;
    ActualBit : BOOL;
    Message : STRING(GVL_Constants.MessageLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    MaxBitIndex : USINT := 7;
    SingleBitMask : BYTE := 16#01;
    NoBitMask : BYTE := 16#00;
    HexDigitCount : USINT := 2;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF BitIndex > MaxBitIndex THEN
    Message := CONCAT('Assertion error: bit index is outside valid range. BitIndex = ',
        USINT_TO_STRING(BitIndex));
    Message := CONCAT(Message, ', MaxBitIndex = ');
    Message := CONCAT(Message, USINT_TO_STRING(MaxBitIndex));
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

Mask := SHL(SingleBitMask, BitIndex);
ActualBit := (IN AND Mask) <> NoBitMask;

IF NOT ActualBit THEN
    ActualText := CreateAssertionTextValue_Hex(Value := BYTE_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: bit is FALSE but must be TRUE. BitIndex = ',
        USINT_TO_STRING(BitIndex));
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>