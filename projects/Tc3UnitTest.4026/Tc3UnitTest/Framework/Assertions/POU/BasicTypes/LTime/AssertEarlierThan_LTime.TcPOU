<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertEarlierThan_LTime" Id="{99010c29-694f-48b6-a39c-effdffa136ca}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is strictly earlier than Maximum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertEarlierThan_LTime EXTENDS AssertionBase
VAR_INPUT
    IN : LTIME; //! Actual value checked or observed by this Assertion.
    Maximum : LTIME; //! Exclusive upper bound; the actual value or count must be smaller.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{bb0c9a0f-f5f1-4680-a29e-a4c2d4346729}" />
    <Method Name="Assert" Id="{b811dad8-fce4-410a-9cad-0f45efb0539e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Evaluate the typed duration relation and report higher-priority errors first.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN >= Maximum THEN
    MaximumText := LTIME_TO_STRING(Maximum);
    ActualText := LTIME_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not earlier than limit. Maximum = ',
        MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>