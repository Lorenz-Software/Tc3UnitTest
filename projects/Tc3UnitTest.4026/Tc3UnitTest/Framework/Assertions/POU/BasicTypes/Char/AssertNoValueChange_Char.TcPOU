<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNoValueChange_Char" Id="{046a1d76-18ac-47be-8b12-a3208d714947}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check equality between consecutive active observations.</summary>
<description>

The first active observation establishes a baseline without deciding a result. Disabling
observation invalidates that baseline, not the held Result. Re-enabling first establishes a new
baseline; Reset clears history.

ObserveFirstCycle FALSE delays the first observation by one enabled call.

Compares the numeric character code without case folding or encoding validation.
Printable ASCII diagnostics include the character and hexadecimal code; other codes use a
hexadecimal representation.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertNoValueChange_Char EXTENDS AssertionBase
VAR_INPUT
    IN : BYTE; //! Actual character code.
END_VAR
VAR
    FINPrevious : BYTE;
    FObservationPrevious : BOOL;
    FEvaluationActive : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{bc363bc7-455b-4635-866a-c7f098f27520}" />
    <Method Name="Assert" Id="{5801b977-590d-458a-bf26-43598e856adc}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Captures the current character and compares consecutive observations.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    PreviousValue : BYTE;
    Message : STRING(GVL_Constants.MessageLength);
    PreviousText : STRING;
    ActualText : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEvaluationActive := ObservationActive AND FObservationPrevious;
FObservationPrevious := ObservationActive;

IF NOT ObservationActive THEN
    RETURN;
END_IF;

PreviousValue := FINPrevious;
FINPrevious := IN;

IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <> PreviousValue THEN
    PreviousText := CreateAssertionTextValue_Char(Value := PreviousValue);
    ActualText := CreateAssertionTextValue_Char(Value := IN);
    Message := CONCAT('Assertion failed: value changed unexpectedly. Previous = ',
        PreviousText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
    <Property Name="EvaluationActive" Id="{1fbae862-48df-4ac5-852b-8da70400a8bc}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Current/last call has an active observation and a preceding observation
baseline.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC EvaluationActive : BOOL //! Current/last call has an active observation and a preceding observation baseline.]]></Declaration>
      <Get Name="Get" Id="{18a65135-7986-4e60-a67e-68bf2c4412b4}">
        <Declaration><![CDATA[PUBLIC]]></Declaration>
        <Implementation>
          <ST><![CDATA[EvaluationActive := FEvaluationActive;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ResetAssertion" Id="{d9247da6-019b-4e7d-a7ee-f6ab65bd0b80}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clears observation history and the comparison gate.</summary>
*)
{endregion}
METHOD PROTECTED ResetAssertion]]></Declaration>
      <Implementation>
        <ST><![CDATA[FINPrevious := 0;
FObservationPrevious := FALSE;
FEvaluationActive := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>