<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotEqual_Char" Id="{1b9b8ed0-87bc-4f93-8122-a7a2cbf3d00f}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks exact inequality of character codes.</summary>
<description>

Character codes use BYTE; diagnostics show printable ASCII and hexadecimal codes.

Compares the numeric character code without case folding or encoding validation.
Printable ASCII diagnostics include the character and hexadecimal code; other codes use a
hexadecimal representation.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertNotEqual_Char EXTENDS AssertionBase
VAR_INPUT
    IN : BYTE; //! Actual character code.
    Expected : BYTE; //! Forbidden character code.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{e152cd8d-0653-4177-bf5e-12b0bd54a1e4}" />
    <Method Name="Assert" Id="{8bfeefb4-b965-4388-8d08-c08eb8056619}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Compares character codes and reports character-formatted diagnostics.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING;
    ActualText : STRING;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN = Expected THEN
    ExpectedText := CreateAssertionTextValue_Char(Value := Expected);
    ActualText := CreateAssertionTextValue_Char(Value := IN);
    Message := CONCAT('Assertion failed: values are equal. NotExpected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>