<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotInRange_USInt" Id="{3aa4b8bb-831e-4ce1-923b-a36ba7a3ea9f}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks whether the USINT value is outside the inclusive range.</summary>
<description>

Minimum &gt; Maximum reports Error during active evaluation; equal bounds are
valid.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertNotInRange_USInt EXTENDS AssertionBase
VAR_INPUT
    IN : USINT; //! Actual value checked or observed by this Assertion.
    Minimum : USINT; //! Inclusive lower bound of the comparison; for a range, must not exceed Maximum.
    Maximum : USINT; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{e09b3592-35a5-4a2b-beeb-61e13782bfc6}" />
    <Method Name="Assert" Id="{fc2ff21c-5379-4d94-8a86-0680b88c9552}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check whether the USINT value is outside the inclusive range.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Minimum > Maximum THEN
    MinimumText := USINT_TO_STRING(Minimum);
    MaximumText := USINT_TO_STRING(Maximum);
    Message := CONCAT('Assertion error: minimum exceeds maximum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN >= Minimum) AND (IN <= Maximum) THEN
    MinimumText := USINT_TO_STRING(Minimum);
    MaximumText := USINT_TO_STRING(Maximum);
    ActualText := USINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is inside forbidden range. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>