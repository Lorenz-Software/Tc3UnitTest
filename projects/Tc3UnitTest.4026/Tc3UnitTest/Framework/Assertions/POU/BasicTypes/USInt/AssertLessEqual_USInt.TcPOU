<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertLessEqual_USInt" Id="{36d0e67b-d14f-4559-859b-e4e555281e48}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at most Maximum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertLessEqual_USInt EXTENDS AssertionBase
VAR_INPUT
    IN : USINT; //! Actual value checked or observed by this Assertion.
    Maximum : USINT; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{c2226ad8-3888-4803-95b9-d94e8988f974}" />
    <Method Name="Assert" Id="{c5cf1b08-5857-4d40-b904-f2af33a19db2}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at most Maximum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN > Maximum THEN
    MaximumText := USINT_TO_STRING(Maximum);
    ActualText := USINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is above maximum. Maximum = ',
        MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>