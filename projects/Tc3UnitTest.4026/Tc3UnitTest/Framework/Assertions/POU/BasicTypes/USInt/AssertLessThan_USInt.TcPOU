<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertLessThan_USInt" Id="{bd2c8889-7666-4b8e-80af-9a80c903729e}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is less than Maximum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertLessThan_USInt EXTENDS AssertionBase
VAR_INPUT
    IN : USINT; //! Actual value checked or observed by this Assertion.
    Maximum : USINT; //! Exclusive upper bound; the actual value or count must be smaller.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{bf608af7-94ee-4274-aa19-ae8176bf5817}" />
    <Method Name="Assert" Id="{b7c3154f-6610-41d0-8871-ac5827b23739}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is less than Maximum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN >= Maximum THEN
    MaximumText := USINT_TO_STRING(Maximum);
    ActualText := USINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not less than maximum. Maximum = ',
        MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>