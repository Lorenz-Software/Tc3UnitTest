<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotInTimespan_TOD" Id="{a98b4fe1-6c77-4a49-b8a1-9833135a18df}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is outside the inclusive StartTime..EndTime interval.</summary>
<description>

StartTime &gt; EndTime reports Error during active evaluation; equal bounds are
valid.

A value at or beyond 24 hours reports Error before comparison or baseline capture.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertNotInTimespan_TOD EXTENDS AssertionBase
VAR_INPUT
    IN : TOD; //! Actual value checked or observed by this Assertion.
    StartTime : TOD; //! Inclusive start of the time span; must not exceed EndTime.
    EndTime : TOD; //! Inclusive end of the time span; must not precede StartTime.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{ae8b3301-0cb6-478f-8eb7-6d1ec6d8d6ed}" />
    <Method Name="Assert" Id="{3c01e1f1-8883-42e2-b2d9-bc38e79bff7e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Evaluate the typed temporal relation and report higher-priority errors first.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    StartTimeText : STRING(GVL_Constants.AssertionValueLength);
    EndTimeText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF NOT IsTimeOfDayValid_TOD(Value := IN) THEN
    Error(Message := 'Assertion error: IN is outside the valid TOD range (less than 24 hours).');
    RETURN;
END_IF;

IF NOT IsTimeOfDayValid_TOD(Value := StartTime) THEN
    Error(Message := 'Assertion error: StartTime is outside the valid TOD range (less than 24 hours).');
    RETURN;
END_IF;

IF NOT IsTimeOfDayValid_TOD(Value := EndTime) THEN
    Error(Message := 'Assertion error: EndTime is outside the valid TOD range (less than 24 hours).');
    RETURN;
END_IF;

IF StartTime > EndTime THEN
    StartTimeText := TOD_TO_STRING(StartTime);
    EndTimeText := TOD_TO_STRING(EndTime);
    Message := CONCAT('Assertion error: start time exceeds end time. StartTime = ',
        StartTimeText);
    Message := CONCAT(Message, ', EndTime = ');
    Message := CONCAT(Message, EndTimeText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN >= StartTime) AND (IN <= EndTime) THEN
    StartTimeText := TOD_TO_STRING(StartTime);
    EndTimeText := TOD_TO_STRING(EndTime);
    ActualText := TOD_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is inside forbidden timespan. StartTime = ',
        StartTimeText);
    Message := CONCAT(Message, ', EndTime = ');
    Message := CONCAT(Message, EndTimeText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>