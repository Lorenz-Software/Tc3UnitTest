<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertEqualTolerance_LReal" Id="{fb6e29f3-cdb2-4486-84f5-8143824813f4}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks equality within absolute tolerance, including its boundary in
equality.</summary>
<description>

All checked operands and bounds must be finite; NaN or either infinity reports Error
during active evaluation.

Tolerance is absolute, in the same units as the values, finite and non-negative. Its
default zero requests exact comparison. The equality boundary is inclusive; larger differences
are unequal. Difference checking avoids overflow for large finite operands.

Numeric diagnostics use the formatter's default six significant digits; rounding affects
the message only, not the comparison.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertEqualTolerance_LReal EXTENDS AssertionBase
VAR_INPUT
    IN : LREAL; //! Actual value checked or observed by this Assertion.
    Expected : LREAL; //! Reference value for comparison with IN.
    Tolerance : LREAL := 0.0; //! Maximum absolute difference accepted as equal; must be finite and non-negative.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{e1f9e96c-1768-472a-907a-579264f2b581}" />
    <Method Name="Assert" Id="{18b0acf1-c4ce-4809-966e-35ac4a1c4c80}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check equality within absolute tolerance, including its boundary in equality.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
    ToleranceText : STRING(GVL_Constants.AssertionValueLength);
    IsWithinTolerance : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF NOT Tc2_Utilities.LrealIsFinite(x := IN) THEN
    Error(Message := 'Assertion error: IN must be finite.');
    RETURN;
END_IF;

IF NOT Tc2_Utilities.LrealIsFinite(x := Expected) THEN
    Error(Message := 'Assertion error: Expected must be finite.');
    RETURN;
END_IF;

IF NOT Tc2_Utilities.LrealIsFinite(x := Tolerance) THEN
    Error(Message := 'Assertion error: Tolerance must be finite.');
    RETURN;
END_IF;

IF Tolerance < 0.0 THEN
    ToleranceText := CreateAssertionTextValue_LReal(Value := Tolerance);
    Message := CONCAT('Assertion error: tolerance must not be negative. Tolerance = ',
        ToleranceText);
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IsWithinTolerance := IsWithinTolerance_LReal(IN := IN,
    Expected := Expected,
    Tolerance := Tolerance);
IF NOT IsWithinTolerance THEN
    ExpectedText := CreateAssertionTextValue_LReal(Value := Expected);
    ActualText := CreateAssertionTextValue_LReal(Value := IN);
    ToleranceText := CreateAssertionTextValue_LReal(Value := Tolerance);
    Message := CONCAT('Assertion failed: values differ more than tolerance. Expected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, ', Tolerance = ');
    Message := CONCAT(Message, ToleranceText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>