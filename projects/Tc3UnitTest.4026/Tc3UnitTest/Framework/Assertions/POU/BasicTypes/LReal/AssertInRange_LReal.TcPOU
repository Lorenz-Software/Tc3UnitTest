<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertInRange_LReal" Id="{077c3d17-3ac8-4951-98f6-28e53e027d43}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks whether the LREAL value is inside the inclusive range.</summary>
<description>

Minimum &gt; Maximum reports Error during active evaluation; equal bounds are
valid.

All checked operands and bounds must be finite; NaN or either infinity reports Error
during active evaluation.

Numeric diagnostics use the formatter's default six significant digits; rounding affects
the message only, not the comparison.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertInRange_LReal EXTENDS AssertionBase
VAR_INPUT
    IN : LREAL; //! Actual value checked or observed by this Assertion.
    Minimum : LREAL; //! Inclusive lower bound of the comparison; for a range, must not exceed Maximum.
    Maximum : LREAL; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{b31d0fa5-6e42-4616-80b2-58ba9ad6ffcf}" />
    <Method Name="Assert" Id="{6da9f854-6163-44c8-b66c-03d5d8b896f4}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check whether the LREAL value is inside the inclusive range.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF NOT Tc2_Utilities.LrealIsFinite(x := IN) THEN
    Error(Message := 'Assertion error: IN must be finite.');
    RETURN;
END_IF;

IF NOT Tc2_Utilities.LrealIsFinite(x := Minimum) THEN
    Error(Message := 'Assertion error: Minimum must be finite.');
    RETURN;
END_IF;

IF NOT Tc2_Utilities.LrealIsFinite(x := Maximum) THEN
    Error(Message := 'Assertion error: Maximum must be finite.');
    RETURN;
END_IF;

IF Minimum > Maximum THEN
    MinimumText := CreateAssertionTextValue_LReal(Value := Minimum);
    MaximumText := CreateAssertionTextValue_LReal(Value := Maximum);
    Message := CONCAT('Assertion error: minimum exceeds maximum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN < Minimum) OR (IN > Maximum) THEN
    MinimumText := CreateAssertionTextValue_LReal(Value := Minimum);
    MaximumText := CreateAssertionTextValue_LReal(Value := Maximum);
    ActualText := CreateAssertionTextValue_LReal(Value := IN);
    Message := CONCAT('Assertion failed: value is outside allowed range. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>