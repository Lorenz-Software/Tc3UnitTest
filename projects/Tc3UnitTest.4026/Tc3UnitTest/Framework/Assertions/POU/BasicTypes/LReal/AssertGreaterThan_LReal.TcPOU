<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertGreaterThan_LReal" Id="{64df970f-50d5-4ffb-864f-706ee5bd0c7e}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is greater than Minimum.</summary>
<description>

All checked operands and bounds must be finite; NaN or either infinity reports Error
during active evaluation.

Numeric diagnostics use the formatter's default six significant digits; rounding affects
the message only, not the comparison.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertGreaterThan_LReal EXTENDS AssertionBase
VAR_INPUT
    IN : LREAL; //! Actual value checked or observed by this Assertion.
    Minimum : LREAL; //! Exclusive lower bound; the actual value or count must be greater.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{f593e1b7-5e8b-4708-a8c2-3f573c206cb9}" />
    <Method Name="Assert" Id="{463d74b6-d145-4e38-b5ac-b4eacfbfb792}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is greater than Minimum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF NOT Tc2_Utilities.LrealIsFinite(x := IN) THEN
    Error(Message := 'Assertion error: IN must be finite.');
    RETURN;
END_IF;

IF NOT Tc2_Utilities.LrealIsFinite(x := Minimum) THEN
    Error(Message := 'Assertion error: Minimum must be finite.');
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <= Minimum THEN
    MinimumText := CreateAssertionTextValue_LReal(Value := Minimum);
    ActualText := CreateAssertionTextValue_LReal(Value := IN);
    Message := CONCAT('Assertion failed: value is not greater than minimum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>