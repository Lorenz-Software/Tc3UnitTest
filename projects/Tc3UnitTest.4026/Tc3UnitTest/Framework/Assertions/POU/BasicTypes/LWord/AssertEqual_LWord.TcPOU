<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertEqual_LWord" Id="{74d49e50-0fe0-418e-a1c9-9ab67596c01e}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks equality with the expected LWORD value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertEqual_LWord EXTENDS AssertionBase
VAR_INPUT
    IN : LWORD; //! Actual value checked or observed by this Assertion.
    Expected : LWORD; //! Reference value for comparison with IN.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{392a25b6-b432-4a50-baa7-e4215be13efd}" />
    <Method Name="Assert" Id="{03cb75ab-abdd-4cbc-9d6a-d972c75e1e8b}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check equality with the expected LWORD value.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    HexDigitCount : USINT := 16;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <> Expected THEN
    ExpectedText := CreateAssertionTextValue_Hex(Value := Expected,
        DigitCount := HexDigitCount);
    ActualText := CreateAssertionTextValue_Hex(Value := IN,
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: values are not equal. Expected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>