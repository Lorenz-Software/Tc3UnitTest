<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotEqualBit_LWord" Id="{28f0675f-19a6-4eb9-b063-f85dd3cdf848}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that the selected LWORD bit differs from the expected Boolean value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertNotEqualBit_LWord EXTENDS AssertionBase
VAR_INPUT
    IN : LWORD; //! Actual bitfield.
    BitIndex : USINT; //! Zero-based bit index (0..63); an invalid index produces Error during evaluation.
    Expected : BOOL; //! Forbidden selected bit value.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{20d98494-ad5d-4fc3-9e62-ad971cdc034d}" />
    <Method Name="Assert" Id="{aef7b773-99f9-4190-8b69-acea4a424ef3}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validates the index before evaluating the selected bit.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Mask : LWORD;
    ActualBit : BOOL;
    Message : STRING(GVL_Constants.MessageLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    MaxBitIndex : USINT := 63;
    SingleBitMask : LWORD := 16#01;
    NoBitMask : LWORD := 16#00;
    HexDigitCount : USINT := 16;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF BitIndex > MaxBitIndex THEN
    Message := CONCAT('Assertion error: bit index is outside valid range. BitIndex = ',
        USINT_TO_STRING(BitIndex));
    Message := CONCAT(Message, ', MaxBitIndex = ');
    Message := CONCAT(Message, USINT_TO_STRING(MaxBitIndex));
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

Mask := SHL(SingleBitMask, BitIndex);
ActualBit := (IN AND Mask) <> NoBitMask;

IF ActualBit = Expected THEN
    ActualText := CreateAssertionTextValue_Hex(Value := IN,
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: bit value matches forbidden value. BitIndex = ',
        USINT_TO_STRING(BitIndex));
    Message := CONCAT(Message, ', NotExpected = ');
    Message := CONCAT(Message, BOOL_TO_STRING(Expected));
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, BOOL_TO_STRING(ActualBit));
    Message := CONCAT(Message, ', Value = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>