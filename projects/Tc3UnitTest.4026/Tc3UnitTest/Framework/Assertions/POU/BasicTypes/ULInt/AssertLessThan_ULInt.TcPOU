<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertLessThan_ULInt" Id="{7b2a0775-5143-4f53-82f4-3bcaef419fe7}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is less than Maximum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertLessThan_ULInt EXTENDS AssertionBase
VAR_INPUT
    IN : ULINT; //! Actual value checked or observed by this Assertion.
    Maximum : ULINT; //! Exclusive upper bound; the actual value or count must be smaller.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{90ee311b-1cca-42eb-9e8c-350f3113fe75}" />
    <Method Name="Assert" Id="{08c3e0dc-f0f4-4af1-9534-7328d6eb81e1}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is less than Maximum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN >= Maximum THEN
    MaximumText := ULINT_TO_STRING(Maximum);
    ActualText := ULINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not less than maximum. Maximum = ',
        MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>