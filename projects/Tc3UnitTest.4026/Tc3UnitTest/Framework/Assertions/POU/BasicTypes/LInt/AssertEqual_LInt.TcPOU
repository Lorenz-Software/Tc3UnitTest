<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertEqual_LInt" Id="{536695f3-d9c5-493f-8204-6216b09660e7}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks equality with the expected LINT value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertEqual_LInt EXTENDS AssertionBase
VAR_INPUT
    IN : LINT; //! Actual value checked or observed by this Assertion.
    Expected : LINT; //! Reference value for comparison with IN.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{2368bc47-9e49-414a-9552-ea4b58cc1bb6}" />
    <Method Name="Assert" Id="{af410f30-47c9-469c-a44f-d85532bec387}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check equality with the expected LINT value.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <> Expected THEN
    ExpectedText := LINT_TO_STRING(Expected);
    ActualText := LINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: values are not equal. Expected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>