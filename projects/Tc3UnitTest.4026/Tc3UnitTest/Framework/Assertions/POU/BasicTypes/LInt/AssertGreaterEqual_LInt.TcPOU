<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertGreaterEqual_LInt" Id="{90241dd3-97f7-4413-b6a0-034f275d7a01}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at least Minimum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertGreaterEqual_LInt EXTENDS AssertionBase
VAR_INPUT
    IN : LINT; //! Actual value checked or observed by this Assertion.
    Minimum : LINT; //! Inclusive lower bound of the comparison; for a range, must not exceed Maximum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{08bfdc87-1c44-484f-9ad4-b40f35123ae5}" />
    <Method Name="Assert" Id="{8221e944-8066-4a45-95a6-64959d776f62}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at least Minimum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN < Minimum THEN
    MinimumText := LINT_TO_STRING(Minimum);
    ActualText := LINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is below minimum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>