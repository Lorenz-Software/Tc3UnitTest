<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotInRange_DInt" Id="{0c97fabd-8d41-4329-8bf6-7c9d561e3bfb}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks whether the DINT value is outside the inclusive range.</summary>
<description>

Minimum &gt; Maximum reports Error during active evaluation; equal bounds are
valid.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertNotInRange_DInt EXTENDS AssertionBase
VAR_INPUT
    IN : DINT; //! Actual value checked or observed by this Assertion.
    Minimum : DINT; //! Inclusive lower bound of the comparison; for a range, must not exceed Maximum.
    Maximum : DINT; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{48159d22-b019-4e38-bc00-905ad751c749}" />
    <Method Name="Assert" Id="{2c8e2e5e-ca38-4f79-a721-41a29266379d}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check whether the DINT value is outside the inclusive range.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Minimum > Maximum THEN
    MinimumText := DINT_TO_STRING(Minimum);
    MaximumText := DINT_TO_STRING(Maximum);
    Message := CONCAT('Assertion error: minimum exceeds maximum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN >= Minimum) AND (IN <= Maximum) THEN
    MinimumText := DINT_TO_STRING(Minimum);
    MaximumText := DINT_TO_STRING(Maximum);
    ActualText := DINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is inside forbidden range. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>