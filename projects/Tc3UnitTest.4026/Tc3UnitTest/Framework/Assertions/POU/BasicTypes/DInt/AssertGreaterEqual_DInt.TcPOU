<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertGreaterEqual_DInt" Id="{769c3bd8-362f-48ae-b2e4-d1dcc0bfacf6}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at least Minimum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertGreaterEqual_DInt EXTENDS AssertionBase
VAR_INPUT
    IN : DINT; //! Actual value checked or observed by this Assertion.
    Minimum : DINT; //! Inclusive lower bound of the comparison; for a range, must not exceed Maximum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{7aede90b-c56f-4cee-8af4-62d31820f902}" />
    <Method Name="Assert" Id="{e320ab70-a869-4490-9f32-18e028880528}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at least Minimum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN < Minimum THEN
    MinimumText := DINT_TO_STRING(Minimum);
    ActualText := DINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is below minimum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>