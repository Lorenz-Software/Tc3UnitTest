<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertGreaterThan_DInt" Id="{6f3a62af-c4f1-4aec-9495-843071fa0545}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is greater than Minimum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertGreaterThan_DInt EXTENDS AssertionBase
VAR_INPUT
    IN : DINT; //! Actual value checked or observed by this Assertion.
    Minimum : DINT; //! Exclusive lower bound; the actual value or count must be greater.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{6d1e65a9-cf4f-4858-a498-12f5c1005963}" />
    <Method Name="Assert" Id="{b2ce76e9-f4e3-4d5c-97a5-9d8473710bed}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is greater than Minimum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <= Minimum THEN
    MinimumText := DINT_TO_STRING(Minimum);
    ActualText := DINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not greater than minimum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>