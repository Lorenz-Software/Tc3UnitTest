<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotInTimespan_DT" Id="{7704cbcd-e483-4b0b-ae01-d729e7f2d4d4}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is outside the inclusive StartTime..EndTime interval.</summary>
<description>

StartTime &gt; EndTime reports Error during active evaluation; equal bounds are
valid.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertNotInTimespan_DT EXTENDS AssertionBase
VAR_INPUT
    IN : DT; //! Actual value checked or observed by this Assertion.
    StartTime : DT; //! Inclusive start of the time span; must not exceed EndTime.
    EndTime : DT; //! Inclusive end of the time span; must not precede StartTime.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{7a544b22-c1ee-45c2-b3b9-aba86234d439}" />
    <Method Name="Assert" Id="{2fc65d60-9994-4864-8e31-b7c62e43e1da}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Evaluate the typed temporal relation and report higher-priority errors first.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    StartTimeText : STRING(GVL_Constants.AssertionValueLength);
    EndTimeText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF StartTime > EndTime THEN
    StartTimeText := DT_TO_STRING(StartTime);
    EndTimeText := DT_TO_STRING(EndTime);
    Message := CONCAT('Assertion error: start time exceeds end time. StartTime = ',
        StartTimeText);
    Message := CONCAT(Message, ', EndTime = ');
    Message := CONCAT(Message, EndTimeText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN >= StartTime) AND (IN <= EndTime) THEN
    StartTimeText := DT_TO_STRING(StartTime);
    EndTimeText := DT_TO_STRING(EndTime);
    ActualText := DT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is inside forbidden timespan. StartTime = ',
        StartTimeText);
    Message := CONCAT(Message, ', EndTime = ');
    Message := CONCAT(Message, EndTimeText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>