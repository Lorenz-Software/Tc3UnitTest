<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertEarlierThan_Date" Id="{1c71e9d0-9e91-40ad-a5d2-5ad8f0cd0fce}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is strictly earlier than Maximum.</summary>
<description>

Compares calendar days only; hidden time-of-day components are ignored.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertEarlierThan_Date EXTENDS AssertionBase
VAR_INPUT
    IN : DATE; //! Actual value checked or observed by this Assertion.
    Maximum : DATE; //! Exclusive upper bound; the actual value or count must be smaller.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{7d868b40-a1d8-4c48-b2a1-823ba9cd0bff}" />
    <Method Name="Assert" Id="{e5eb74be-f248-4df2-992d-5e881cbf7b25}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Evaluate the typed temporal relation and report higher-priority errors first.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF DateToDayNumber(Value := IN) >= DateToDayNumber(Value := Maximum) THEN
    MaximumText := DATE_TO_STRING(Maximum);
    ActualText := DATE_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not earlier than limit. Maximum = ',
        MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>