<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertRisingEdgeCntInRange" Id="{56117f06-5a31-4a34-a980-8541a8a12a9a}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that the rising-edge count is inside the inclusive range.</summary>
<description>

Reversed bounds report Error during evaluation; equal bounds are valid.

Observation and accumulated-count handling come from AssertionEdgeCountBase. Evaluate
checks the held count independently of Enable; reset clears the count and baseline.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertRisingEdgeCntInRange EXTENDS AssertionEdgeCountBase
VAR_INPUT
    Minimum : UINT; //! Inclusive lower bound of the comparison; for a range, must not exceed Maximum.
    Maximum : UINT; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{bd34012a-9f69-4927-88c5-bda7906e4ea6}" />
    <Method Name="Assert" Id="{e3ffb0d7-2264-4182-824e-4d3a6f6fbb2a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Observe through the base, then evaluate the count with Error priority.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.Assert();

IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Minimum > Maximum THEN
    MinimumText := UINT_TO_STRING(Minimum);
    MaximumText := UINT_TO_STRING(Maximum);
    Message := CONCAT('Assertion error: minimum exceeds maximum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (EdgeCount < Minimum) OR (EdgeCount > Maximum) THEN
    MinimumText := UINT_TO_STRING(Minimum);
    MaximumText := UINT_TO_STRING(Maximum);
    ActualText := UINT_TO_STRING(EdgeCount);
    Message := CONCAT('Assertion failed: rising edge count is outside allowed range. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Maximum = ');
    Message := CONCAT(Message, MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsMatchingEdge" Id="{52281c30-a7ff-4ebf-9f0d-e1cc7086f857}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Recognize a rising edge without changing observation state.</summary>
*)
{endregion}
METHOD PROTECTED IsMatchingEdge : BOOL //! TRUE when PreviousValue and CurrentValue form the edge selected by this Assertion.
VAR_INPUT
    PreviousValue : BOOL; //! Signal value from the preceding active observation.
    CurrentValue : BOOL; //! Signal value from the current active observation.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsMatchingEdge := NOT PreviousValue AND CurrentValue;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>