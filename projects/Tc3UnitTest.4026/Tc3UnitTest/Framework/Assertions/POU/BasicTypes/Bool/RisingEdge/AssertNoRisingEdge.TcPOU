<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNoRisingEdge" Id="{e47645f6-c908-45a4-b4e8-e203d2d340e7}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Reject a rising edge between consecutive active observations.</summary>
<description>

The first active observation establishes a baseline without deciding a result. Disabling
observation invalidates that baseline, not the held Result. Re-enabling first establishes a new
baseline; Reset clears history.

ObserveFirstCycle FALSE delays the first observation by one enabled call.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertNoRisingEdge EXTENDS AssertionBase
VAR_INPUT
    IN : BOOL; //! Actual value checked or observed by this Assertion.
END_VAR
VAR
    FINPrevious : BOOL;
    FObservationPrevious : BOOL;
    FEvaluationActive : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{5a67a1da-8834-4e58-ab52-944d8a45cf93}" />
    <Method Name="Assert" Id="{44f0ae48-3d7c-4f85-a7ab-640428ebe520}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Maintain observation history before evaluating the selected edge.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    PreviousValue : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEvaluationActive := ObservationActive AND FObservationPrevious;
FObservationPrevious := ObservationActive;

IF NOT ObservationActive THEN
    RETURN;
END_IF;

PreviousValue := FINPrevious;
FINPrevious := IN;

IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN AND NOT PreviousValue THEN
    Fail(Message := 'Assertion failed: unexpected rising edge detected.');
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
    <Property Name="EvaluationActive" Id="{0774935d-6684-495d-8393-6352c4a8d767}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Current/last call can compare two consecutive active observations.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC EvaluationActive : BOOL //! Current/last call can compare two consecutive active observations.]]></Declaration>
      <Get Name="Get" Id="{c4b4ad29-b572-4c4b-8b12-1806d1781511}">
        <Declaration><![CDATA[PUBLIC]]></Declaration>
        <Implementation>
          <ST><![CDATA[EvaluationActive := FEvaluationActive;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ResetAssertion" Id="{2eed1763-7a3a-430c-ba68-fb878ddf9b40}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clear observation history and the current evaluation gate.</summary>
*)
{endregion}
METHOD PROTECTED ResetAssertion]]></Declaration>
      <Implementation>
        <ST><![CDATA[FINPrevious := FALSE;
FObservationPrevious := FALSE;
FEvaluationActive := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>