<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotEqual_Bool" Id="{d635e509-47e5-4447-9b4a-7ea0dcbd244d}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks inequality with the forbidden BOOL value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertNotEqual_Bool EXTENDS AssertionBase
VAR_INPUT
    IN : BOOL; //! Actual value checked or observed by this Assertion.
    Expected : BOOL; //! Value that must differ from IN under this Assertion's comparison rules.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{7dca2356-604a-41e3-877d-2c265b1280f1}" />
    <Method Name="Assert" Id="{7b76a22f-b265-422c-8ceb-390e878d21f8}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check inequality with the forbidden BOOL value.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN = Expected THEN
    ExpectedText := BOOL_TO_STRING(Expected);
    ActualText := BOOL_TO_STRING(IN);
    Message := CONCAT('Assertion failed: values are equal but should differ. NotExpected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>