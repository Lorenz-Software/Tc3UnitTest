<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertFallingEdgeCntNotEqual" Id="{7a5f0969-137f-4ceb-abc9-6973ef4926aa}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that the falling-edge count does not match the forbidden count.</summary>
<description>

Observation and accumulated-count handling come from AssertionEdgeCountBase. Evaluate
checks the held count independently of Enable; reset clears the count and baseline.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertFallingEdgeCntNotEqual EXTENDS AssertionEdgeCountBase
VAR_INPUT
    Expected : UINT; //! Reference count for the named relation; counts occurrences, not array indices.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{dad0920e-c1b0-47cb-b54b-6f32367de8db}" />
    <Method Name="Assert" Id="{6a84a89d-a34b-42a5-8ae1-693995e4e878}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Observe through the base, then evaluate the count with Error priority.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SUPER^.Assert();

IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF EdgeCount = Expected THEN
    ExpectedText := UINT_TO_STRING(Expected);
    ActualText := UINT_TO_STRING(EdgeCount);
    Message := CONCAT('Assertion failed: falling edge count matches forbidden value. NotExpected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsMatchingEdge" Id="{9f66f5c0-e398-4d16-98e8-49675d7f3a8f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Recognize a falling edge without changing observation state.</summary>
*)
{endregion}
METHOD PROTECTED IsMatchingEdge : BOOL //! TRUE when PreviousValue and CurrentValue form the edge selected by this Assertion.
VAR_INPUT
    PreviousValue : BOOL; //! Signal value from the preceding active observation.
    CurrentValue : BOOL; //! Signal value from the current active observation.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsMatchingEdge := PreviousValue AND NOT CurrentValue;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>