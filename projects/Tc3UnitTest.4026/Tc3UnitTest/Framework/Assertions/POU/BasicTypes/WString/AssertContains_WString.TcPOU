<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertContains_WString" Id="{e2b8b78d-4eb0-4528-96b5-6e2839289b70}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks whether text contains the expected fragment, case-sensitively.</summary>
<description>

Read-only text must remain stable during the call and fit the configured Param_Assertions
text capacity. Invalid references or a missing terminator within that capacity report
Error.

The searched fragment, prefix or suffix must be nonempty; empty search text reports
Error. Matching is case-sensitive, without trimming or wildcard rules.

Comparison uses WSTRING code units. Diagnostic previews are shortened and converted for
the STRING event message; they need not preserve every displayed character.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertContains_WString EXTENDS AssertionBase
VAR_IN_OUT CONSTANT
    IN : WSTRING(Param_Assertions.AssertionWStringLength); //! Actual text; must remain stable during the call.
    Fragment : WSTRING(Param_Assertions.AssertionWStringLength); //! Nonempty expected fragment; must remain stable during the call.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{90ea0df2-81e6-43c3-adb9-8d4616397224}" />
    <Method Name="Assert" Id="{5fbaa5c1-88af-40fa-b0c6-580ba2b1a6fe}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validates inputs before comparing and escalating the result.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    FragmentText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

// C0371: FB inputs are checked here before any reference access.
{warning disable C0371}
IF NOT __ISVALIDREF(IN) THEN
    Error(Message := 'Assertion error: IN reference is invalid.');
    RETURN;
END_IF;

IF NOT __ISVALIDREF(Fragment) THEN
    Error(Message := 'Assertion error: Fragment reference is invalid.');
    RETURN;
END_IF;

IF NOT IsAssertionWStringLengthValid(Value := IN) THEN
    Error(Message := 'Assertion error: IN exceeds configured WSTRING length.');
    RETURN;
END_IF;

IF NOT IsAssertionWStringLengthValid(Value := Fragment) THEN
    Error(Message := 'Assertion error: Fragment exceeds configured WSTRING length.');
    RETURN;
END_IF;

IF Fragment = "" THEN
    Error(Message := 'Assertion error: Fragment must not be empty.');
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF NOT TextContains_WString(Value := IN,
    Fragment := Fragment) THEN
    FragmentText := CreateAssertionTextValue_WString(Value := Fragment);
    ActualText := CreateAssertionTextValue_WString(Value := IN);
    Message := CONCAT('Assertion failed: text does not contain expected fragment. Fragment = ',
        FragmentText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();
{warning restore C0371}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>