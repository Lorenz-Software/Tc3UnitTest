<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertContainsBit_DWord" Id="{c8b513a2-e5c3-4d6d-a0d4-ed415a89dd9e}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that at least one selected bit equals the expected Boolean value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertContainsBit_DWord EXTENDS AssertionBase
VAR_INPUT
    IN : DWORD; //! Actual bitfield.
    Mask : DWORD := 16#FFFFFFFF; //! Selects evaluated bits; defaults to all bits. An empty mask produces Error during evaluation.
    Expected : BOOL; //! Expected value of at least one selected bit.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{2dde100d-f16e-4555-b283-21dcef4a8ad7}" />
    <Method Name="Assert" Id="{88dd3474-1e0f-4a1c-ba2c-5b67f2d540dd}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Rejects an empty mask before checking for a matching selected bit.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    ContainsBit : BOOL;
    Message : STRING(GVL_Constants.MessageLength);
    MaskText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    NoMask : DWORD := 16#00;
    HexDigitCount : USINT := 8;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Mask = NoMask THEN
    MaskText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(Mask),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion error: mask must not be empty. Mask = ',
        MaskText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF Expected THEN
    ContainsBit := (IN AND Mask) <> NoMask;
ELSE
    ContainsBit := (IN AND Mask) <> Mask;
END_IF;

IF NOT ContainsBit THEN
    MaskText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(Mask),
        DigitCount := HexDigitCount);
    ActualText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: selected bits do not contain expected bit value. Expected = ',
        BOOL_TO_STRING(Expected));
    Message := CONCAT(Message, ', Mask = ');
    Message := CONCAT(Message, MaskText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>