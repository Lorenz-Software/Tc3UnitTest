<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotEqual_DWord" Id="{12e7cd14-c42f-4c4a-ae03-2d140d5b3590}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks inequality with the forbidden DWORD value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertNotEqual_DWord EXTENDS AssertionBase
VAR_INPUT
    IN : DWORD; //! Actual value checked or observed by this Assertion.
    Expected : DWORD; //! Value that must differ from IN under this Assertion's comparison rules.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{b5bb7600-faf2-432b-a381-187c4939bda6}" />
    <Method Name="Assert" Id="{7365c78d-5415-4e00-9ce5-4de4076ca429}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check inequality with the forbidden DWORD value.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    HexDigitCount : USINT := 8;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN = Expected THEN
    ExpectedText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(Expected),
        DigitCount := HexDigitCount);
    ActualText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: values are equal but should differ. NotExpected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>