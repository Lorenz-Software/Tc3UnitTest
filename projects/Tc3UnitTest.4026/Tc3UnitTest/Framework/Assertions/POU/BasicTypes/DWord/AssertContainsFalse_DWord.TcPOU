<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertContainsFalse_DWord" Id="{fe983ec6-45c2-49d5-b95a-abc0c55c665d}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that at least one selected bit is FALSE.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertContainsFalse_DWord EXTENDS AssertionBase
VAR_INPUT
    IN : DWORD; //! Actual bitfield.
    Mask : DWORD := 16#FFFFFFFF; //! Selects evaluated bits; defaults to all bits. An empty mask produces Error during evaluation.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{69763e63-c005-44c3-a4e3-99b612e8070b}" />
    <Method Name="Assert" Id="{a936fbd3-a85c-4aa4-a526-08fa9dd2181d}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Rejects an empty mask before checking for a matching selected bit.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaskText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    NoMask : DWORD := 16#00;
    HexDigitCount : USINT := 8;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Mask = NoMask THEN
    MaskText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(Mask),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion error: mask must not be empty. Mask = ',
        MaskText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN AND Mask) = Mask THEN
    MaskText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(Mask),
        DigitCount := HexDigitCount);
    ActualText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: no selected bit is FALSE. Mask = ',
        MaskText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>