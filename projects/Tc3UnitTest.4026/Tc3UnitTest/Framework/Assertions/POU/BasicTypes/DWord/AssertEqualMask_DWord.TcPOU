<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertEqualMask_DWord" Id="{1b6b702b-74e8-4464-bcfa-54b5a3cbe84b}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that selected bits match the expected masked value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertEqualMask_DWord EXTENDS AssertionBase
VAR_INPUT
    IN : DWORD; //! Actual bitfield.
    Mask : DWORD := 16#FFFFFFFF; //! Selects evaluated bits; defaults to all bits. An empty mask produces Error during evaluation.
    Expected : DWORD; //! Expected value; bits outside Mask are ignored.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{8939bd81-85f8-4b12-940b-bc8373c76e36}" />
    <Method Name="Assert" Id="{ac21f1d7-7f67-43ad-8bfc-c6518bac150a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Rejects an empty mask before comparing selected bits.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaskText : STRING(GVL_Constants.AssertionValueLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    NoMask : DWORD := 16#00;
    HexDigitCount : USINT := 8;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Mask = NoMask THEN
    MaskText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(Mask),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion error: mask must not be empty. Mask = ',
        MaskText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN AND Mask) <> (Expected AND Mask) THEN
    MaskText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(Mask),
        DigitCount := HexDigitCount);
    ExpectedText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(Expected),
        DigitCount := HexDigitCount);
    ActualText := CreateAssertionTextValue_Hex(Value := DWORD_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: selected bits do not match. Expected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Mask = ');
    Message := CONCAT(Message, MaskText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>