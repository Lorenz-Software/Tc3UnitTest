<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertLessThan_UDInt" Id="{2905adb6-a1ae-4ee1-bf13-36255f3afac4}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is less than Maximum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertLessThan_UDInt EXTENDS AssertionBase
VAR_INPUT
    IN : UDINT; //! Actual value checked or observed by this Assertion.
    Maximum : UDINT; //! Exclusive upper bound; the actual value or count must be smaller.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{d06a0bfc-4a0f-4c71-97c4-2cec60d1e92f}" />
    <Method Name="Assert" Id="{b3912564-c948-41f4-970a-c552fa8f98ab}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is less than Maximum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN >= Maximum THEN
    MaximumText := UDINT_TO_STRING(Maximum);
    ActualText := UDINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not less than maximum. Maximum = ',
        MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>