<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertLessEqual_UDInt" Id="{d98327fc-b4b4-4b2c-8562-fda7ca348a15}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at most Maximum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertLessEqual_UDInt EXTENDS AssertionBase
VAR_INPUT
    IN : UDINT; //! Actual value checked or observed by this Assertion.
    Maximum : UDINT; //! Inclusive upper bound of the comparison; for a range, must not be below Minimum.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{075cb94c-3d1f-47f2-81f8-ae9567c873a7}" />
    <Method Name="Assert" Id="{2e7623d6-8893-4c50-a7dc-f2170ffb5a6b}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is at most Maximum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaximumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN > Maximum THEN
    MaximumText := UDINT_TO_STRING(Maximum);
    ActualText := UDINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is above maximum. Maximum = ',
        MaximumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>