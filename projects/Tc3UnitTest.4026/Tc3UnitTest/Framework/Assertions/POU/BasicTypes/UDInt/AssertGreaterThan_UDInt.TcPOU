<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertGreaterThan_UDInt" Id="{bed07177-e8cf-43fd-8d34-b0da6fd31c78}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is greater than Minimum.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertGreaterThan_UDInt EXTENDS AssertionBase
VAR_INPUT
    IN : UDINT; //! Actual value checked or observed by this Assertion.
    Minimum : UDINT; //! Exclusive lower bound; the actual value or count must be greater.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{2e88c5e9-edb9-4228-a326-517f7b73b55c}" />
    <Method Name="Assert" Id="{b5f0573d-254b-4eb9-9021-604445ff5e1f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check that IN is greater than Minimum.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MinimumText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN <= Minimum THEN
    MinimumText := UDINT_TO_STRING(Minimum);
    ActualText := UDINT_TO_STRING(IN);
    Message := CONCAT('Assertion failed: value is not greater than minimum. Minimum = ',
        MinimumText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>