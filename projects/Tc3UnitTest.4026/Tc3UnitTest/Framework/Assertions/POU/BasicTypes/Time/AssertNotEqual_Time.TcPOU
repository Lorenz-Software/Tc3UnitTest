<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotEqual_Time" Id="{f068f1f8-405d-4dbc-af5a-79dbba0ddd54}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks inequality with the forbidden TIME value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertNotEqual_Time EXTENDS AssertionBase
VAR_INPUT
    IN : TIME; //! Actual value checked or observed by this Assertion.
    Expected : TIME; //! Value that must differ from IN under this Assertion's comparison rules.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{24c1cd70-cb3f-4f27-8efb-58e330f08efb}" />
    <Method Name="Assert" Id="{7f8465ea-f72f-4398-a361-41aaa911b3a7}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Evaluate the typed duration relation and report higher-priority errors first.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN = Expected THEN
    ExpectedText := TIME_TO_STRING(Expected);
    ActualText := TIME_TO_STRING(IN);
    Message := CONCAT('Assertion failed: values are equal but should differ. NotExpected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>