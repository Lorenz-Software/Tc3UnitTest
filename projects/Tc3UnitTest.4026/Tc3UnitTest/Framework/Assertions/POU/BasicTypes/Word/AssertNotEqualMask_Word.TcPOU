<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotEqualMask_Word" Id="{3fbd2391-fdae-447c-a88f-0156dd3e9507}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that selected bits differ from the forbidden masked value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertNotEqualMask_Word EXTENDS AssertionBase
VAR_INPUT
    IN : WORD; //! Actual bitfield.
    Mask : WORD := 16#FFFF; //! Selects evaluated bits; defaults to all bits. An empty mask produces Error during evaluation.
    Expected : WORD; //! Forbidden value; bits outside Mask are ignored.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{50dca208-7998-421a-bff7-97648ce1ef6f}" />
    <Method Name="Assert" Id="{b2766461-b963-4bc6-beb7-fe898440bfe8}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Rejects an empty mask before comparing selected bits.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    MaskText : STRING(GVL_Constants.AssertionValueLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    NoMask : WORD := 16#00;
    HexDigitCount : USINT := 4;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Mask = NoMask THEN
    MaskText := CreateAssertionTextValue_Hex(Value := WORD_TO_LWORD(Mask),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion error: mask must not be empty. Mask = ',
        MaskText);
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF (IN AND Mask) = (Expected AND Mask) THEN
    MaskText := CreateAssertionTextValue_Hex(Value := WORD_TO_LWORD(Mask),
        DigitCount := HexDigitCount);
    ExpectedText := CreateAssertionTextValue_Hex(Value := WORD_TO_LWORD(Expected),
        DigitCount := HexDigitCount);
    ActualText := CreateAssertionTextValue_Hex(Value := WORD_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: selected bits match forbidden value. NotExpected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Mask = ');
    Message := CONCAT(Message, MaskText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>