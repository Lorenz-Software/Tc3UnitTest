<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertFalseBit_Word" Id="{b6bb8c48-4eb4-424f-af24-8280dd27849f}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that the selected WORD bit is FALSE.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertFalseBit_Word EXTENDS AssertionBase
VAR_INPUT
    IN : WORD; //! Actual bitfield.
    BitIndex : USINT; //! Zero-based bit index (0..15); an invalid index produces Error during evaluation.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{5de94c32-9f09-44b8-9d99-72fc574a74a3}" />
    <Method Name="Assert" Id="{98078087-b151-4b14-9fe5-910b0884890f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Validates the index before evaluating the selected bit.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Mask : WORD;
    ActualBit : BOOL;
    Message : STRING(GVL_Constants.MessageLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    MaxBitIndex : USINT := 15;
    SingleBitMask : WORD := 16#01;
    NoBitMask : WORD := 16#00;
    HexDigitCount : USINT := 4;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF BitIndex > MaxBitIndex THEN
    Message := CONCAT('Assertion error: bit index is outside valid range. BitIndex = ',
        USINT_TO_STRING(BitIndex));
    Message := CONCAT(Message, ', MaxBitIndex = ');
    Message := CONCAT(Message, USINT_TO_STRING(MaxBitIndex));
    Message := CONCAT(Message, '.');
    Error(Message := Message);
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

Mask := SHL(SingleBitMask, BitIndex);
ActualBit := (IN AND Mask) <> NoBitMask;

IF ActualBit THEN
    ActualText := CreateAssertionTextValue_Hex(Value := WORD_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: bit is TRUE but must be FALSE. BitIndex = ',
        USINT_TO_STRING(BitIndex));
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>