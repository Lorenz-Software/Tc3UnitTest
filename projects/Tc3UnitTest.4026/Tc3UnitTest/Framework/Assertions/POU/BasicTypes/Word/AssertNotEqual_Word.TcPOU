<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertNotEqual_Word" Id="{5b167113-3275-4111-95f7-566b3095044c}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks inequality with the forbidden WORD value.</summary>
*)
{endregion}
FUNCTION_BLOCK AssertNotEqual_Word EXTENDS AssertionBase
VAR_INPUT
    IN : WORD; //! Actual value checked or observed by this Assertion.
    Expected : WORD; //! Value that must differ from IN under this Assertion's comparison rules.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{f1a3235e-fd40-4b06-9700-7ac684f246de}" />
    <Method Name="Assert" Id="{ea1c872c-3e72-4772-90bf-9e090c60d744}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Check inequality with the forbidden WORD value.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Message : STRING(GVL_Constants.MessageLength);
    ExpectedText : STRING(GVL_Constants.AssertionValueLength);
    ActualText : STRING(GVL_Constants.AssertionValueLength);
END_VAR
VAR CONSTANT
    HexDigitCount : USINT := 4;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

IF IN = Expected THEN
    ExpectedText := CreateAssertionTextValue_Hex(Value := WORD_TO_LWORD(Expected),
        DigitCount := HexDigitCount);
    ActualText := CreateAssertionTextValue_Hex(Value := WORD_TO_LWORD(IN),
        DigitCount := HexDigitCount);
    Message := CONCAT('Assertion failed: values are equal but should differ. NotExpected = ',
        ExpectedText);
    Message := CONCAT(Message, ', Actual = ');
    Message := CONCAT(Message, ActualText);
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>