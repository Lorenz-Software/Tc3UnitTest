<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertIsInfinite_Real" Id="{04af7acc-32a2-4903-8712-0e41724f855d}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that IN is positive or negative infinity.</summary>
<description>

NaN and either infinity are legitimate checked data, not configuration errors.
Classification mismatch reports Failed. Bit-based classification does not perform an ordered
floating-point comparison.

Numeric diagnostics use the formatter's default six significant digits; rounding affects
the message only, not the comparison.

</description>
*)
{endregion}
FUNCTION_BLOCK AssertIsInfinite_Real EXTENDS AssertionBase
VAR_INPUT
    IN : REAL; //! Value to classify; NaN and both infinities are valid inputs.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{97173ca6-7736-4b00-b228-2b1ee578ad67}" />
    <Method Name="Assert" Id="{a6310000-0000-4000-8000-000000000002}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Classifies the bit representation without floating-point arithmetic.</summary>
*)
{endregion}
METHOD PROTECTED Assert
VAR
    Representation : AssertionRealRepresentation;
    Message : STRING(GVL_Constants.MessageLength);
END_VAR
VAR CONSTANT
    ExponentMask : DWORD := DWORD#16#7F800000;
    FractionMask : DWORD := DWORD#16#007FFFFF;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT EvaluationActive THEN
    RETURN;
END_IF;

IF Result = E_Result.Error THEN
    RETURN;
END_IF;

IF Result = E_Result.Failed THEN
    RETURN;
END_IF;

Representation.Value := IN;
IF ((Representation.Bits AND ExponentMask) <> ExponentMask)
    OR ((Representation.Bits AND FractionMask) <> 0) THEN
    Message := CONCAT('Assertion failed: expected positive or negative infinity. Actual = ',
        CreateAssertionTextValue_Real(Value := IN));
    Message := CONCAT(Message, '.');
    Fail(Message := Message);
    RETURN;
END_IF;

Pass();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>