<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="I_Orchestrator" Id="{a6e27120-26b8-44b3-8958-cd3cdd31a05f}">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Owner-facing initialization, cyclic execution and observations of the selected scheduler.</summary>
<description>
Initialize with an owner-validated, nonempty, stable collection before Execute. The owner calls Execute once before all concrete child FBs in the same task; the helper dispatches requests, while the owner retains concrete calls, aggregation and timeout supervision. Do not execute the same helper both through Execute and its concrete FB body in one cycle.

The default Orchestrator admits at most one new Start or Reset per call; shared slots allow overlapping execution, not simultaneous admission. Repeating a task preserves progress, and completion never chooses the next task. Technical Error is held until Initialize or entry into a new Reset task; Idle does not clear it. Reset/Abort completion is separate from a successful outcome, so inspect Result as well as the corresponding completion flag.
</description>
*)
{endregion}
INTERFACE I_Orchestrator]]></Declaration>
    <Property Name="CurrentTask" Id="{1ea1147f-54b5-472d-ba51-6d8d042562c6}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Last task supplied to the scheduler.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY CurrentTask : E_OrchestratorTask //! Last task supplied to the scheduler.]]></Declaration>
      <Get Name="Get" Id="{40c4e389-1cc5-48e7-b8a7-0ccbdefacfb6}">
        <Declaration><![CDATA[PUBLIC
VAR
END_VAR]]></Declaration>
      </Get>
    </Property>
    <Method Name="Execute" Id="{528c9862-5a74-4fe5-a77c-04a866205b0b}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Executes the selected task once, before the owner&#x27;s child FB calls.</summary>
*)
{endregion}
METHOD Execute
VAR_INPUT
    Task : E_OrchestratorTask; //! Owner-selected work for this call; a task change initializes its scheduling once.
END_VAR]]></Declaration>
    </Method>
    <Method Name="Initialize" Id="{4417e804-8d64-4539-83bf-287e9734a63d}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Binds the validated collection and initializes scheduling before the first Execute call.</summary>
<description>
Capacity, occupied entries, naming and slots are owner/builder responsibilities. The owner must also accept child initialization before enabling regular execution. The default helper caches lower bound and count, not the capacity upper bound, and retains the collection interface for later indexed reads. A failed default initialization drops the old binding rather than preserving it as a fallback.
</description>
*)
{endregion}
METHOD Initialize : BOOL //! TRUE when the child collection is accepted and scheduling is initialized.
VAR_INPUT
    Collection : I_OrchestratableCollection; //! Initialized, stable child collection retained by the scheduler; its owner and children must outlive use.
    Name : STRING(GVL_Constants.NameLength); //! Hierarchical owner name used to identify events; must satisfy the naming contract.
    ResourceName : STRING(GVL_Constants.ResourceNameLength) := ''; //! Optional resource context for diagnostics; empty by default.
END_VAR]]></Declaration>
    </Method>
    <Property Name="IsAbortFinished" Id="{5f618d9c-868d-4248-a16f-26e68aa1c96d}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Current Abort task is finished, with reservations reconciled.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY IsAbortFinished : BOOL //! Current Abort task is finished, with reservations reconciled.]]></Declaration>
      <Get Name="Get" Id="{52e8fed7-fccd-4162-8d60-5ee6596f7363}">
