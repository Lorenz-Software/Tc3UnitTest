    <Method Name="FreeReservedEvents" Id="{f56d5c21-36cf-4fd1-ae07-59eef3037496}" FolderPath="MetaData\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Releases the complete registered subtree synchronously without changing lifecycle states. Attempts all contributions; FALSE permits partial success. Repeated release is idempotent.</summary>
*)
{endregion}
