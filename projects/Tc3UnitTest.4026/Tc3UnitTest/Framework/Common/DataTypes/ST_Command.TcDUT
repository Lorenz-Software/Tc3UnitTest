<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_Command" Id="{7aa25462-7b2b-4682-b8ce-7052128d81be}">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Lifecycle request flags; external qualification and clearing belong to the command adapter.</summary>
*)
{endregion}
TYPE ST_Command :
STRUCT
    {attribute 'OPC.UA.DA.Access' := '3'}
    Start : BOOL := FALSE; //! External one-shot Start request, qualified and cleared by the command adapter.
    {attribute 'OPC.UA.DA.Access' := '3'}
    Abort : BOOL := FALSE; //! External one-shot Abort request for active execution, qualified and cleared by the command adapter.
    {attribute 'OPC.UA.DA.Access' := '3'}
    Reset : BOOL := FALSE; //! External one-shot lifecycle Reset request, qualified and cleared by the command adapter.
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>