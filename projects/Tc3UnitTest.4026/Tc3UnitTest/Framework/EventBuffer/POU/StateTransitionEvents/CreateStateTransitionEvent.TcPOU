<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CreateStateTransitionEvent" Id="{2654feca-3b6c-492f-a759-22b82277bf05}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Constructs an owner state-transition event without publishing it.</summary>
<description>
The caller supplies valid ASCII owner context; the structured state is StateNew.
</description>
*)
{endregion}
FUNCTION CreateStateTransitionEvent : ST_Event //! Constructed event value; not published. The publisher assigns SequenceId and Timestamp.
VAR_INPUT
    OwnerScope : E_OwnerScope; //! Semantic owner category recorded in the event.
    Name : STRING(GVL_Constants.NameLength); //! Hierarchical owner name used to identify events; must satisfy the naming contract.
    ResourceName : STRING(GVL_Constants.ResourceNameLength) := ''; //! Optional resource context for diagnostics; empty by default.
    StateOld : E_State; //! Owner state before the reported or rejected transition.
    StateNew : E_State; //! Requested destination state recorded in the event; this function does not perform the transition.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CreateStateTransitionEvent.SequenceId := 0;
CreateStateTransitionEvent.Timestamp := 0;
CreateStateTransitionEvent.OwnerScope := OwnerScope;
CreateStateTransitionEvent.EventType := E_EventType.StateTransition;
CreateStateTransitionEvent.Severity := E_EventSeverity.Info;
CreateStateTransitionEvent.Name := Name;
CreateStateTransitionEvent.ResourceName := ResourceName;
CreateStateTransitionEvent.State := StateNew;
CreateStateTransitionEvent.Result := E_Result.NotEvaluated;
CreateStateTransitionEvent.Message := CONCAT(STR1 := 'State transition ',
    STR2 := INT_TO_STRING(TO_INT(StateOld)));
CreateStateTransitionEvent.Message := CONCAT(STR1 := CreateStateTransitionEvent.Message,
    STR2 := ' -> ');
CreateStateTransitionEvent.Message := CONCAT(STR1 := CreateStateTransitionEvent.Message,
    STR2 := INT_TO_STRING(TO_INT(StateNew)));]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>