<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CreateTestSuiteOrchestratorStateTransitionEvent" Id="{681ae42b-60ef-4d48-8c14-73df005aa027}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Constructs a Test Suite Orchestrator transition event without publishing it.</summary>
<description>
Name is the parent name; the appended .Orchestrator name uses the fixed event capacity.


This retained technical constructor is not called by the current owner-driven Orchestrator, which emits Framework error diagnostics rather than normal task/slot transitions. Its technical scope/name never supplies Full Owner completion evidence.
</description>
*)
{endregion}
FUNCTION CreateTestSuiteOrchestratorStateTransitionEvent : ST_Event //! Constructed event value; not published. The publisher assigns SequenceId and Timestamp.
VAR_INPUT
    Name : STRING(GVL_Constants.NameLength); //! Parent's hierarchical name; the event name appends '.Orchestrator'.
    StateOld : E_State; //! Owner state before the reported or rejected transition.
    StateNew : E_State; //! Requested destination state recorded in the event; this function does not perform the transition.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CreateTestSuiteOrchestratorStateTransitionEvent.SequenceId := 0;
CreateTestSuiteOrchestratorStateTransitionEvent.Timestamp := 0;
CreateTestSuiteOrchestratorStateTransitionEvent.OwnerScope := E_OwnerScope.TestSuiteOrchestrator;
CreateTestSuiteOrchestratorStateTransitionEvent.EventType := E_EventType.StateTransition;
CreateTestSuiteOrchestratorStateTransitionEvent.Severity := E_EventSeverity.Info;
CreateTestSuiteOrchestratorStateTransitionEvent.Name := CONCAT(STR1 := Name,
    STR2 := '.Orchestrator');
CreateTestSuiteOrchestratorStateTransitionEvent.ResourceName := '';
CreateTestSuiteOrchestratorStateTransitionEvent.State := StateNew;
CreateTestSuiteOrchestratorStateTransitionEvent.Result := E_Result.NotEvaluated;
CreateTestSuiteOrchestratorStateTransitionEvent.Message := CONCAT(STR1 := 'State transition ',
    STR2 := INT_TO_STRING(TO_INT(StateOld)));
CreateTestSuiteOrchestratorStateTransitionEvent.Message := CONCAT(STR1 := CreateTestSuiteOrchestratorStateTransitionEvent.Message,
    STR2 := ' -> ');
CreateTestSuiteOrchestratorStateTransitionEvent.Message := CONCAT(STR1 := CreateTestSuiteOrchestratorStateTransitionEvent.Message,
    STR2 := INT_TO_STRING(TO_INT(StateNew)));]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>