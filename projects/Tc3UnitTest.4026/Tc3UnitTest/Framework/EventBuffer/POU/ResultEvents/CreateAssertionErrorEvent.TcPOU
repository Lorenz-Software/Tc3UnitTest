<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="CreateAssertionErrorEvent" Id="{6a44f208-4223-4fec-bc0d-ef289c742eaf}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Constructs an assertion-error event without evaluating or publishing it.</summary>
<description>
The caller supplies the complete ASCII name, resource context and finding message.
</description>
*)
{endregion}
FUNCTION CreateAssertionErrorEvent : ST_Event //! Constructed event value; not published. The publisher assigns SequenceId and Timestamp.
VAR_INPUT
    Name : STRING(GVL_Constants.NameLength); //! Hierarchical owner name used to identify events; must satisfy the naming contract.
    ResourceName : STRING(GVL_Constants.ResourceNameLength) := ''; //! Optional resource context for diagnostics; empty by default.
    State : E_State; //! Owner lifecycle state recorded in the event.
    Message : STRING(GVL_Constants.MessageLength); //! Diagnostic text copied into the event within MessageLength.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CreateAssertionErrorEvent.SequenceId := 0;
CreateAssertionErrorEvent.Timestamp := 0;
CreateAssertionErrorEvent.OwnerScope := E_OwnerScope.Assertion;
CreateAssertionErrorEvent.EventType := E_EventType.Result;
CreateAssertionErrorEvent.Severity := SelectResultSeverity(Result := E_Result.Error);
CreateAssertionErrorEvent.Name := Name;
CreateAssertionErrorEvent.ResourceName := ResourceName;
CreateAssertionErrorEvent.State := State;
CreateAssertionErrorEvent.Result := E_Result.Error;
CreateAssertionErrorEvent.Message := Message;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>