<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_TestCaseCollectionConfig" Id="{dbf1b9c0-8a85-4498-a99b-0052ceb3b62e}">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Finalized collection bounds, population and orchestration configuration.</summary>
<description>
This is metadata, not child storage. The occupied prefix starts at FirstIndex and has Count entries; LastIndex includes unused capacity. Require IsValid before use and retain the actual array, child instances and slot assignments unchanged for execution. Full hierarchical initialization rebuilds the composition.
</description>
*)
{endregion}
TYPE ST_TestCaseCollectionConfig :
STRUCT
    FirstIndex : DINT; //! Lower bound of the caller-owned child array; occupied entries start here.
    LastIndex : DINT; //! Upper bound of the complete child array, including unused capacity.
    Count : UINT; //! Number of registered children; occupied range is FirstIndex through FirstIndex + Count - 1.
    IsValid : BOOL; //! TRUE after successful finalization; FALSE configurations must not be used.
    Mode : E_OrchestrationMode; //! Scheduling strategy selected for this initialized collection.
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>