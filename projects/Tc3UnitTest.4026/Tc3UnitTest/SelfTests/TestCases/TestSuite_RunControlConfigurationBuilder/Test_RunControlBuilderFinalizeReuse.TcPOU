<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_RunControlBuilderFinalizeReuse" Id="{652b7cac-00c0-4d95-9b4b-aec8048bd384}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks empty and repeated finalization, sealed registration and a clean new build.</summary>
<description>Child mocks are inert interface identities and slot storage only; no child initialization or FB call is performed.</description>
*)
{endregion}
FUNCTION_BLOCK Test_RunControlBuilderFinalizeReuse EXTENDS TestCaseBase
VAR
    FBuilder : RunControlConfigurationBuilder;
    FSuites : ARRAY[1..2] OF I_TestSuite;
    FChildA : TestSuiteMock;
    FChildB : TestSuiteMock;
    FScenarioExecuted : BOOL;
    FChecksEvaluated : BOOL;
    FEmptyRejected : AssertTrue;
    FEmptyRejectedMatches : BOOL;
    FRepeatedFinalization : AssertTrue;
    FRepeatedFinalizationMatches : BOOL;
    FSealedRegistration : AssertTrue;
    FSealedRegistrationMatches : BOOL;
    FErrorRecorded : AssertTrue;
    FErrorRecordedMatches : BOOL;
    FFreshInitialize : AssertTrue;
    FFreshInitializeMatches : BOOL;
    FReuse : AssertTrue;
    FReuseMatches : BOOL;
END_VAR
VAR CONSTANT
    CandidateSlotBeforeRejection : UINT := 9;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{00570001-0057-4057-8057-000000000042}" />
    <Method Name="AggregateResults" Id="{00570001-0057-4057-8057-000000000040}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Contributes each owned Assertion once without executing it.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FEmptyRejected);
Aggregator.AddProvider(Provider := FRepeatedFinalization);
Aggregator.AddProvider(Provider := FSealedRegistration);
Aggregator.AddProvider(Provider := FErrorRecorded);
Aggregator.AddProvider(Provider := FFreshInitialize);
Aggregator.AddProvider(Provider := FReuse);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{00570001-0057-4057-8057-000000000039}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Requires successful base and owned Assertion initialization.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := FALSE;
IF NOT SUPER^.CheckInitialization() THEN
    RETURN;
END_IF;

CheckInitialization := FEmptyRejected.IsInitialized
    AND FRepeatedFinalization.IsInitialized
    AND FSealedRegistration.IsInitialized
    AND FErrorRecorded.IsInitialized
    AND FFreshInitialize.IsInitialized
    AND FReuse.IsInitialized;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{00570001-0057-4057-8057-000000000038}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Configures one direct builder scenario and its named Assertions.</summary>
*)
{endregion}
METHOD PROTECTED Configure]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FScenarioExecuted := FALSE;
FChecksEvaluated := FALSE;

FEmptyRejectedMatches := FALSE;
FEmptyRejected.Initialize(Parent := THIS^,
    AssertionName := 'EmptyRejected');
FRepeatedFinalizationMatches := FALSE;
FRepeatedFinalization.Initialize(Parent := THIS^,
    AssertionName := 'RepeatedFinalization');
FSealedRegistrationMatches := FALSE;
FSealedRegistration.Initialize(Parent := THIS^,
    AssertionName := 'SealedRegistration');
FErrorRecordedMatches := FALSE;
FErrorRecorded.Initialize(Parent := THIS^,
    AssertionName := 'ErrorRecorded');
FFreshInitializeMatches := FALSE;
FFreshInitialize.Initialize(Parent := THIS^,
    AssertionName := 'FreshInitialize');
FReuseMatches := FALSE;
FReuse.Initialize(Parent := THIS^,
    AssertionName := 'Reuse');]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{00570001-0057-4057-8057-00000000003b}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes Abort immediately; no asynchronous resource operation is started.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{00570001-0057-4057-8057-00000000003f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Evaluates recorded observations and consumes pending resets on disabled calls.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEmptyRejected(Enable := Enable,
    State := State,
    IN := FEmptyRejectedMatches);

FRepeatedFinalization(Enable := Enable,
    State := State,
    IN := FRepeatedFinalizationMatches);

FSealedRegistration(Enable := Enable,
    State := State,
    IN := FSealedRegistrationMatches);

FErrorRecorded(Enable := Enable,
    State := State,
    IN := FErrorRecordedMatches);

FFreshInitialize(Enable := Enable,
    State := State,
    IN := FFreshInitializeMatches);

FReuse(Enable := Enable,
    State := State,
    IN := FReuseMatches);

IF Enable AND FEmptyRejected.EvaluationActive
    AND FRepeatedFinalization.EvaluationActive
    AND FSealedRegistration.EvaluationActive
    AND FErrorRecorded.EvaluationActive
    AND FFreshInitialize.EvaluationActive
    AND FReuse.EvaluationActive THEN
    FChecksEvaluated := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{00570001-0057-4057-8057-00000000003a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation phase is needed for synchronous builder calls.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required override signature; this scenario has no Preparation work.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{00570001-0057-4057-8057-00000000003c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clears recorded checks and Assertion results; each scenario initializes its own builder.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FScenarioExecuted := FALSE;
FChecksEvaluated := FALSE;
FEmptyRejectedMatches := FALSE;
FEmptyRejected.Reset();
FRepeatedFinalizationMatches := FALSE;
FRepeatedFinalization.Reset();
FSealedRegistrationMatches := FALSE;
FSealedRegistration.Reset();
FErrorRecordedMatches := FALSE;
FErrorRecorded.Reset();
FFreshInitializeMatches := FALSE;
FFreshInitialize.Reset();
FReuseMatches := FALSE;
FReuse.Reset();
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{00570001-0057-4057-8057-00000000003d}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Runs setup operations once, then completes after their observations have been evaluated.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FChecksEvaluated THEN
    CompleteTests();
ELSIF NOT FScenarioExecuted THEN
    RunScenario();
    FScenarioExecuted := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunScenario" Id="{00570001-0057-4057-8057-00000000003e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks empty and repeated finalization, sealed registration and a clean new build.</summary>
*)
{endregion}
METHOD PRIVATE RunScenario
VAR
    ChildA : I_TestSuite;
    ChildB : I_TestSuite;
    AcceptedA : BOOL;
    AcceptedB : BOOL;
    Config : ST_TestSuiteCollectionConfig;
    RepeatedConfig : ST_TestSuiteCollectionConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ChildA := FChildA;
ChildB := FChildB;
FBuilder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestSuites := FSuites);
Config := FBuilder.Finalize();
RepeatedConfig := FBuilder.Finalize();
FEmptyRejectedMatches := NOT Config.IsValid AND NOT RepeatedConfig.IsValid
    AND FBuilder.IsFinalized AND NOT FBuilder.IsValid AND (RepeatedConfig.Count = 0);

FBuilder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestSuites := FSuites);
AcceptedA := FBuilder.Register(TestSuite := ChildA);
Config := FBuilder.Finalize();
RepeatedConfig := FBuilder.Finalize();
FRepeatedFinalizationMatches := AcceptedA AND Config.IsValid AND RepeatedConfig.IsValid
    AND (RepeatedConfig.FirstIndex = Config.FirstIndex)
    AND (RepeatedConfig.LastIndex = Config.LastIndex)
    AND (RepeatedConfig.Count = Config.Count) AND (RepeatedConfig.Mode = Config.Mode);

FChildB.ExecutionSlot := CandidateSlotBeforeRejection;
AcceptedB := FBuilder.Register(TestSuite := ChildB);
RepeatedConfig := FBuilder.Finalize();
FSealedRegistrationMatches := NOT AcceptedB AND RepeatedConfig.IsValid AND FBuilder.IsValid
    AND FBuilder.IsFinalized AND (FBuilder.Count = 1)
    AND (FSuites[1] = ChildA) AND (FSuites[2] = 0)
    AND (FChildB.ExecutionSlot = CandidateSlotBeforeRejection);

FBuilder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestSuites := FSuites);
AcceptedA := FBuilder.Register(TestSuite := ChildA);
AcceptedB := FBuilder.Register(TestSuite := ChildA);
Config := FBuilder.Finalize();
FErrorRecordedMatches := AcceptedA AND NOT AcceptedB AND NOT Config.IsValid;

FBuilder.Initialize(Mode := E_OrchestrationMode.Parallel,
    TestSuites := FSuites);
FFreshInitializeMatches := NOT FBuilder.IsFinalized AND NOT FBuilder.IsValid
    AND (FBuilder.Count = 0) AND (FBuilder.Mode = E_OrchestrationMode.Parallel)
    AND (FSuites[1] = 0) AND (FSuites[2] = 0);
AcceptedB := FBuilder.Register(TestSuite := ChildB);
Config := FBuilder.Finalize();
FReuseMatches := AcceptedB AND Config.IsValid AND FBuilder.IsValid AND FBuilder.IsFinalized
    AND (Config.Count = 1) AND (Config.Mode = E_OrchestrationMode.Parallel)
    AND (FSuites[1] = ChildB) AND (FSuites[2] = 0) AND (FChildB.ExecutionSlot = 1);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>