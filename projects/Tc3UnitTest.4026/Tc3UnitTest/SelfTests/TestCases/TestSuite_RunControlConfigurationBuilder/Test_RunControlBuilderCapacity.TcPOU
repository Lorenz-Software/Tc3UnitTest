<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_RunControlBuilderCapacity" Id="{6f05ca8e-3ff1-4dad-9cd1-8ae6085cb151}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks exact capacity and rejection before array or candidate-slot mutation.</summary>
<description>Child mocks are inert interface identities and slot storage only; no child initialization or FB call is performed.</description>
*)
{endregion}
FUNCTION_BLOCK Test_RunControlBuilderCapacity EXTENDS TestCaseBase
VAR
    FBuilder : RunControlConfigurationBuilder;
    FSuites : ARRAY[1..2] OF I_TestSuite;
    FChildA : TestSuiteMock;
    FChildB : TestSuiteMock;
    FChildC : TestSuiteMock;
    FScenarioExecuted : BOOL;
    FChecksEvaluated : BOOL;
    FExactCapacity : AssertTrue;
    FExactCapacityMatches : BOOL;
    FOverflowRejected : AssertTrue;
    FOverflowRejectedMatches : BOOL;
    FCompositionPreserved : AssertTrue;
    FCompositionPreservedMatches : BOOL;
    FErrorLatched : AssertTrue;
    FErrorLatchedMatches : BOOL;
END_VAR
VAR CONSTANT
    CandidateSlotBeforeRejection : UINT := 9;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{00570001-0057-4057-8057-00000000002c}" />
    <Method Name="AggregateResults" Id="{00570001-0057-4057-8057-00000000002a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Contributes each owned Assertion once without executing it.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FExactCapacity);
Aggregator.AddProvider(Provider := FOverflowRejected);
Aggregator.AddProvider(Provider := FCompositionPreserved);
Aggregator.AddProvider(Provider := FErrorLatched);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{00570001-0057-4057-8057-000000000023}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Requires successful base and owned Assertion initialization.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := FALSE;
IF NOT SUPER^.CheckInitialization() THEN
    RETURN;
END_IF;

CheckInitialization := FExactCapacity.IsInitialized
    AND FOverflowRejected.IsInitialized
    AND FCompositionPreserved.IsInitialized
    AND FErrorLatched.IsInitialized;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{00570001-0057-4057-8057-000000000022}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Configures one direct builder scenario and its named Assertions.</summary>
*)
{endregion}
METHOD PROTECTED Configure]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FScenarioExecuted := FALSE;
FChecksEvaluated := FALSE;

FExactCapacityMatches := FALSE;
FExactCapacity.Initialize(Parent := THIS^,
    AssertionName := 'ExactCapacity');
FOverflowRejectedMatches := FALSE;
FOverflowRejected.Initialize(Parent := THIS^,
    AssertionName := 'OverflowRejected');
FCompositionPreservedMatches := FALSE;
FCompositionPreserved.Initialize(Parent := THIS^,
    AssertionName := 'CompositionPreserved');
FErrorLatchedMatches := FALSE;
FErrorLatched.Initialize(Parent := THIS^,
    AssertionName := 'ErrorLatched');]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{00570001-0057-4057-8057-000000000025}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes Abort immediately; no asynchronous resource operation is started.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{00570001-0057-4057-8057-000000000029}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Evaluates recorded observations and consumes pending resets on disabled calls.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FExactCapacity(Enable := Enable,
    State := State,
    IN := FExactCapacityMatches);

FOverflowRejected(Enable := Enable,
    State := State,
    IN := FOverflowRejectedMatches);

FCompositionPreserved(Enable := Enable,
    State := State,
    IN := FCompositionPreservedMatches);

FErrorLatched(Enable := Enable,
    State := State,
    IN := FErrorLatchedMatches);

IF Enable AND FExactCapacity.EvaluationActive
    AND FOverflowRejected.EvaluationActive
    AND FCompositionPreserved.EvaluationActive
    AND FErrorLatched.EvaluationActive THEN
    FChecksEvaluated := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{00570001-0057-4057-8057-000000000024}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation phase is needed for synchronous builder calls.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required override signature; this scenario has no Preparation work.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{00570001-0057-4057-8057-000000000026}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clears recorded checks and Assertion results; each scenario initializes its own builder.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FScenarioExecuted := FALSE;
FChecksEvaluated := FALSE;
FExactCapacityMatches := FALSE;
FExactCapacity.Reset();
FOverflowRejectedMatches := FALSE;
FOverflowRejected.Reset();
FCompositionPreservedMatches := FALSE;
FCompositionPreserved.Reset();
FErrorLatchedMatches := FALSE;
FErrorLatched.Reset();
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{00570001-0057-4057-8057-000000000027}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Runs setup operations once, then completes after their observations have been evaluated.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FChecksEvaluated THEN
    CompleteTests();
ELSIF NOT FScenarioExecuted THEN
    RunScenario();
    FScenarioExecuted := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RunScenario" Id="{00570001-0057-4057-8057-000000000028}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks exact capacity and rejection before array or candidate-slot mutation.</summary>
*)
{endregion}
METHOD PRIVATE RunScenario
VAR
    ChildA : I_TestSuite;
    ChildB : I_TestSuite;
    ChildC : I_TestSuite;
    AcceptedA : BOOL;
    AcceptedB : BOOL;
    AcceptedC : BOOL;
    Config : ST_TestSuiteCollectionConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[ChildA := FChildA;
ChildB := FChildB;
ChildC := FChildC;
FBuilder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestSuites := FSuites);
AcceptedA := FBuilder.Register(TestSuite := ChildA);
AcceptedB := FBuilder.Register(TestSuite := ChildB);
Config := FBuilder.Finalize();
FExactCapacityMatches := AcceptedA AND AcceptedB AND Config.IsValid
    AND (Config.Count = 2) AND (FSuites[1] = ChildA) AND (FSuites[2] = ChildB);

FBuilder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestSuites := FSuites);
AcceptedA := FBuilder.Register(TestSuite := ChildA);
AcceptedB := FBuilder.Register(TestSuite := ChildB);
FChildC.ExecutionSlot := CandidateSlotBeforeRejection;
AcceptedC := FBuilder.Register(TestSuite := ChildC);
FOverflowRejectedMatches := AcceptedA AND AcceptedB AND NOT AcceptedC;
FCompositionPreservedMatches := (FBuilder.Count = 2)
    AND (FSuites[1] = ChildA) AND (FSuites[2] = ChildB)
    AND (FChildA.ExecutionSlot = 1) AND (FChildB.ExecutionSlot = 2)
    AND (FChildC.ExecutionSlot = CandidateSlotBeforeRejection);

Config := FBuilder.Finalize();
FErrorLatchedMatches := NOT Config.IsValid AND NOT FBuilder.IsValid
    AND FBuilder.IsFinalized AND (Config.Count = 2);]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>