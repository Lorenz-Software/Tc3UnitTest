<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_AssertionCharacterEquality" Id="{28c6ab4e-07c3-4fb8-b2c9-7d316de1f523}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks exact BYTE/WORD character-code comparisons for printable, NUL and wide codes.</summary>
<description>
Each named row has explicit expected results, not a second comparison algorithm.
One disabled subject call consumes Reset before one enabled comparison call.
Outer checking Assertions latch every row before inputs advance; intentional
subject failures remain in a Test-Case-owned Event Buffer, cleared between rows.
Only the checking Assertions contribute to the outer result.
</description>
*)
{endregion}
FUNCTION_BLOCK Test_AssertionCharacterEquality EXTENDS TestCaseBase
VAR
    FEqualCharSubject : AssertEqual_Char;
    FNotEqualCharSubject : AssertNotEqual_Char;
    FEqualWCharSubject : AssertEqual_WChar;
    FNotEqualWCharSubject : AssertNotEqual_WChar;
    FActualChar : BYTE;
    FExpectedChar : BYTE;
    FActualWChar : WORD;
    FExpectedWChar : WORD;
    FExpectedEqualCharResult : E_Result;
    FExpectedNotEqualCharResult : E_Result;
    FExpectedEqualWCharResult : E_Result;
    FExpectedNotEqualWCharResult : E_Result;
    FCapture : EventBuffer;
    FEvents : ARRAY[1..CaptureLength] OF ST_Event;
    FCaptureFifo : ST_FifoStatus;
    FCaptureStatus : ST_EventBufferStatus;
    FRow : UINT;
    FRowPrepared : BOOL;
    FObservationReady : BOOL;
    FChecked : BOOL;
    FSetupValid : BOOL;
END_VAR
VAR
    FEqualCharResult : AssertTrue;
    FEqualCharResultMatches : BOOL;
    FNotEqualCharResult : AssertTrue;
    FNotEqualCharResultMatches : BOOL;
    FEqualWCharResult : AssertTrue;
    FEqualWCharResultMatches : BOOL;
    FNotEqualWCharResult : AssertTrue;
    FNotEqualWCharResultMatches : BOOL;
    FCaptureIntegrity : AssertTrue;
    FCaptureIntegrityMatches : BOOL;
END_VAR
VAR CONSTANT
    CaptureLength : UINT := 8;
    ExpectedFindingCount : UDINT := 2;
    PrintableEqual : UINT := 1;
    PrintableDifferent : UINT := 2;
    NullDifferent : UINT := 3;
    NonAsciiDifferent : UINT := 4;
    NullEqual : UINT := 5;
    MaximumEqual : UINT := 6;
    LastRow : UINT := MaximumEqual;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{d1cada2b-1e0b-48b5-983c-4e00f769b7c3}" />
    <Method Name="AggregateResults" Id="{351b305b-0aae-47a7-9611-47dc836b4c4e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Collects only outer checking Assertions, never intentional subject findings.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FEqualCharResult);
Aggregator.AddProvider(Provider := FNotEqualCharResult);
Aggregator.AddProvider(Provider := FEqualWCharResult);
Aggregator.AddProvider(Provider := FNotEqualWCharResult);
Aggregator.AddProvider(Provider := FCaptureIntegrity);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallSubjects" Id="{f945eb77-7726-4aa5-92fd-eee53306ff7f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls each real comparison once with the selected typed row inputs.</summary>
*)
{endregion}
METHOD PRIVATE CallSubjects
VAR_INPUT
    Enable : BOOL; //! Observation-enable input forwarded to the controlled Assertion subjects for this call.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualCharSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualChar,
    Expected := FExpectedChar);
FNotEqualCharSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualChar,
    Expected := FExpectedChar);
FEqualWCharSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualWChar,
    Expected := FExpectedWChar);
FNotEqualWCharSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualWChar,
    Expected := FExpectedWChar);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{3ee30d47-e8a3-4f63-b21d-f72e0b0176d5}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Preserves base validation and rejects incomplete subject or checking-Assertion setup.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := SUPER^.CheckInitialization();
IF NOT CheckInitialization THEN
    RETURN;
END_IF;

CheckInitialization := FSetupValid
    AND FEqualCharResult.IsInitialized
    AND FNotEqualCharResult.IsInitialized
    AND FEqualWCharResult.IsInitialized
    AND FNotEqualWCharResult.IsInitialized
    AND FCaptureIntegrity.IsInitialized;
IF NOT CheckInitialization THEN
    EventPublisher.PublishEvent(Event := CreateFrameworkEvent(Name := Name,
        ResourceName := '',
        State := State,
        Severity := E_EventSeverity.Error,
        Message := 'Comparison selftest setup failed.'));
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckResults" Id="{282dce99-3d9a-4e27-88a1-6508c4ef6fa8}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Compares observed results with the literal row expectations and checks local event loss/count.</summary>
*)
{endregion}
METHOD PRIVATE CheckResults]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualCharResultMatches := FEqualCharSubject.Result = FExpectedEqualCharResult;
FNotEqualCharResultMatches := FNotEqualCharSubject.Result = FExpectedNotEqualCharResult;
FEqualWCharResultMatches := FEqualWCharSubject.Result = FExpectedEqualWCharResult;
FNotEqualWCharResultMatches := FNotEqualWCharSubject.Result = FExpectedNotEqualWCharResult;
FCaptureIntegrityMatches := (FCaptureStatus.SequenceId = ExpectedFindingCount)
    AND (FCaptureStatus.LostEventCount = 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{8c2815fe-05ca-4463-89c0-bc2351f86807}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes the local capture, checking Assertions and publisher-bound real comparisons.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR
    Initialized : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FEqualCharResult.Initialize(Parent := THIS^,
    AssertionName := 'EqualCharResult');
FNotEqualCharResult.Initialize(Parent := THIS^,
    AssertionName := 'NotEqualCharResult');
FEqualWCharResult.Initialize(Parent := THIS^,
    AssertionName := 'EqualWCharResult');
FNotEqualWCharResult.Initialize(Parent := THIS^,
    AssertionName := 'NotEqualWCharResult');
FCaptureIntegrity.Initialize(Parent := THIS^,
    AssertionName := 'CaptureIntegrity');
FSetupValid := FCapture.Initialize(Buffer := FEvents,
    FifoControl := FCaptureFifo,
    Status := FCaptureStatus);
FEqualCharSubject.BindPublisher(Publisher := FCapture);
Initialized := FEqualCharSubject.Initialize(Parent := THIS^,
    AssertionName := 'EqualCharSubject');
FSetupValid := FSetupValid AND Initialized;
FNotEqualCharSubject.BindPublisher(Publisher := FCapture);
Initialized := FNotEqualCharSubject.Initialize(Parent := THIS^,
    AssertionName := 'NotEqualCharSubject');
FSetupValid := FSetupValid AND Initialized;
FEqualWCharSubject.BindPublisher(Publisher := FCapture);
Initialized := FEqualWCharSubject.Initialize(Parent := THIS^,
    AssertionName := 'EqualWCharSubject');
FSetupValid := FSetupValid AND Initialized;
FNotEqualWCharSubject.BindPublisher(Publisher := FCapture);
Initialized := FNotEqualWCharSubject.Initialize(Parent := THIS^,
    AssertionName := 'NotEqualWCharSubject');
FSetupValid := FSetupValid AND Initialized;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{a597469b-3862-478f-9041-0bd019c03ddb}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes abort without asynchronous resources.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{21d91b7f-7ed3-4d1e-82a1-1bd4033356d0}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Latches checked observations before the next script step may proceed.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR
VAR
    Evaluate : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Evaluate := Enable AND FObservationReady;
FEqualCharResult(Enable := Evaluate,
    State := State,
    IN := FEqualCharResultMatches);
FNotEqualCharResult(Enable := Evaluate,
    State := State,
    IN := FNotEqualCharResultMatches);
FEqualWCharResult(Enable := Evaluate,
    State := State,
    IN := FEqualWCharResultMatches);
FNotEqualWCharResult(Enable := Evaluate,
    State := State,
    IN := FNotEqualWCharResultMatches);
FCaptureIntegrity(Enable := Evaluate,
    State := State,
    IN := FCaptureIntegrityMatches);
IF Evaluate THEN
    FChecked := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{160f9be1-b340-4ee8-b96a-774483bdca30}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation phase is required.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required hook; this test has no Preparation phase.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{d94afdf6-58d5-4fc2-a7b1-20d059df7655}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Restarts the script and resets the checking Assertions.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FRow := PrintableEqual;
FRowPrepared := FALSE;
FChecked := FALSE;
FObservationReady := FALSE;
FEqualCharResult.Reset();
FEqualCharResultMatches := TRUE;
FNotEqualCharResult.Reset();
FNotEqualCharResultMatches := TRUE;
FEqualWCharResult.Reset();
FEqualWCharResultMatches := TRUE;
FNotEqualWCharResult.Reset();
FNotEqualWCharResultMatches := TRUE;
FCaptureIntegrity.Reset();
FCaptureIntegrityMatches := TRUE;
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{5a2ee376-9deb-4982-a629-5730230082f5}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Advances one bounded script step per active PLC cycle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FChecked THEN
    FChecked := FALSE;
    FObservationReady := FALSE;
    IF FRow = LastRow THEN
        CompleteTests();
        RETURN;
    END_IF;
    FRow := FRow + 1;
    FRowPrepared := FALSE;
END_IF;

IF NOT FRowPrepared THEN
    SelectRow();
    FCapture.Reset();
    ResetSubjects();
    CallSubjects(Enable := FALSE);
    FRowPrepared := TRUE;
ELSE
    CallSubjects(Enable := TRUE);
    CheckResults();
    FObservationReady := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetSubjects" Id="{e7d6e546-ad2d-48cf-bab4-c0019a064b0a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Requests a fresh result epoch for every comparison; CallSubjects consumes it.</summary>
*)
{endregion}
METHOD PRIVATE ResetSubjects]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualCharSubject.Reset();
FNotEqualCharSubject.Reset();
FEqualWCharSubject.Reset();
FNotEqualWCharSubject.Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectRow" Id="{4d844801-098e-4333-bb0e-c0a0d422905f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Selects literal typed inputs and independent expected results for one comparison row.</summary>
*)
{endregion}
METHOD PRIVATE SelectRow]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE FRow OF
    PrintableEqual:
        FActualChar := BYTE#16#41;
        FExpectedChar := BYTE#16#41;
        FActualWChar := WORD#16#0041;
        FExpectedWChar := WORD#16#0041;
        FExpectedEqualCharResult := E_Result.Passed;
        FExpectedNotEqualCharResult := E_Result.Failed;
        FExpectedEqualWCharResult := E_Result.Passed;
        FExpectedNotEqualWCharResult := E_Result.Failed;
    PrintableDifferent:
        FActualChar := BYTE#16#41;
        FExpectedChar := BYTE#16#42;
        FActualWChar := WORD#16#0041;
        FExpectedWChar := WORD#16#0042;
        FExpectedEqualCharResult := E_Result.Failed;
        FExpectedNotEqualCharResult := E_Result.Passed;
        FExpectedEqualWCharResult := E_Result.Failed;
        FExpectedNotEqualWCharResult := E_Result.Passed;
    NullDifferent:
        FActualChar := BYTE#16#00;
        FExpectedChar := BYTE#16#41;
        FActualWChar := WORD#16#0000;
        FExpectedWChar := WORD#16#0041;
        FExpectedEqualCharResult := E_Result.Failed;
        FExpectedNotEqualCharResult := E_Result.Passed;
        FExpectedEqualWCharResult := E_Result.Failed;
        FExpectedNotEqualWCharResult := E_Result.Passed;
    NonAsciiDifferent:
        FActualChar := BYTE#16#FF;
        FExpectedChar := BYTE#16#41;
        FActualWChar := WORD#16#0100;
        FExpectedWChar := WORD#16#0000;
        FExpectedEqualCharResult := E_Result.Failed;
        FExpectedNotEqualCharResult := E_Result.Passed;
        FExpectedEqualWCharResult := E_Result.Failed;
        FExpectedNotEqualWCharResult := E_Result.Passed;
    NullEqual:
        FActualChar := BYTE#16#00;
        FExpectedChar := BYTE#16#00;
        FActualWChar := WORD#16#0000;
        FExpectedWChar := WORD#16#0000;
        FExpectedEqualCharResult := E_Result.Passed;
        FExpectedNotEqualCharResult := E_Result.Failed;
        FExpectedEqualWCharResult := E_Result.Passed;
        FExpectedNotEqualWCharResult := E_Result.Failed;
    MaximumEqual:
        FActualChar := BYTE#16#FF;
        FExpectedChar := BYTE#16#FF;
        FActualWChar := WORD#16#FFFF;
        FExpectedWChar := WORD#16#FFFF;
        FExpectedEqualCharResult := E_Result.Passed;
        FExpectedNotEqualCharResult := E_Result.Failed;
        FExpectedEqualWCharResult := E_Result.Passed;
        FExpectedNotEqualWCharResult := E_Result.Failed;
ELSE
    Error(Message := 'Unknown comparison test row.');
END_CASE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>