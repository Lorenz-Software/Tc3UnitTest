<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_AssertionUnsignedRelations" Id="{0c13f245-75b5-4fe7-bf1f-0b050506ed4e}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks six native ULINT comparison relations and full-width boundaries.</summary>
<description>
Each named row has explicit expected results, not a second comparison algorithm.
One disabled subject call consumes Reset before one enabled comparison call.
Outer checking Assertions latch every row before inputs advance; intentional
subject failures remain in a Test-Case-owned Event Buffer, cleared between rows.
Only the checking Assertions contribute to the outer result.
</description>
*)
{endregion}
FUNCTION_BLOCK Test_AssertionUnsignedRelations EXTENDS TestCaseBase
VAR
    FEqualSubject : AssertEqual_ULInt;
    FNotEqualSubject : AssertNotEqual_ULInt;
    FLessThanSubject : AssertLessThan_ULInt;
    FLessEqualSubject : AssertLessEqual_ULInt;
    FGreaterThanSubject : AssertGreaterThan_ULInt;
    FGreaterEqualSubject : AssertGreaterEqual_ULInt;
    FActual : ULINT;
    FReference : ULINT;
    FExpectedEqualResult : E_Result;
    FExpectedNotEqualResult : E_Result;
    FExpectedLessThanResult : E_Result;
    FExpectedLessEqualResult : E_Result;
    FExpectedGreaterThanResult : E_Result;
    FExpectedGreaterEqualResult : E_Result;
    FCapture : EventBuffer;
    FEvents : ARRAY[1..CaptureLength] OF ST_Event;
    FCaptureFifo : ST_FifoStatus;
    FCaptureStatus : ST_EventBufferStatus;
    FRow : UINT;
    FRowPrepared : BOOL;
    FObservationReady : BOOL;
    FChecked : BOOL;
    FSetupValid : BOOL;
END_VAR
VAR
    FEqualResult : AssertTrue;
    FEqualResultMatches : BOOL;
    FNotEqualResult : AssertTrue;
    FNotEqualResultMatches : BOOL;
    FLessThanResult : AssertTrue;
    FLessThanResultMatches : BOOL;
    FLessEqualResult : AssertTrue;
    FLessEqualResultMatches : BOOL;
    FGreaterThanResult : AssertTrue;
    FGreaterThanResultMatches : BOOL;
    FGreaterEqualResult : AssertTrue;
    FGreaterEqualResultMatches : BOOL;
    FCaptureIntegrity : AssertTrue;
    FCaptureIntegrityMatches : BOOL;
END_VAR
VAR CONSTANT
    CaptureLength : UINT := 8;
    ExpectedFindingCount : UDINT := 3;
    BelowSignedBoundary : UINT := 1;
    EqualSignedBoundary : UINT := 2;
    AboveSignedBoundary : UINT := 3;
    ZeroBelowMaximum : UINT := 4;
    MaximumAboveZero : UINT := 5;
    ZeroEqual : UINT := 6;
    MaximumEqual : UINT := 7;
    LastRow : UINT := MaximumEqual;
    SignedBoundary : ULINT := ULINT#9223372036854775808;
    HighestValue : ULINT := ULINT#18446744073709551615;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{5e3d49b9-2aad-4f67-a99c-ad5fc5ddf7a2}" />
    <Method Name="AggregateResults" Id="{2d75eeb2-4228-4dc5-8ac9-5df07e5537cc}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Collects only outer checking Assertions, never intentional subject findings.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FEqualResult);
Aggregator.AddProvider(Provider := FNotEqualResult);
Aggregator.AddProvider(Provider := FLessThanResult);
Aggregator.AddProvider(Provider := FLessEqualResult);
Aggregator.AddProvider(Provider := FGreaterThanResult);
Aggregator.AddProvider(Provider := FGreaterEqualResult);
Aggregator.AddProvider(Provider := FCaptureIntegrity);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallSubjects" Id="{70179636-69b9-4388-9947-ea256bf875d5}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls each real comparison once with the selected typed row inputs.</summary>
*)
{endregion}
METHOD PRIVATE CallSubjects
VAR_INPUT
    Enable : BOOL; //! Observation-enable input forwarded to the controlled Assertion subjects for this call.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual,
    Expected := FReference);
FNotEqualSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual,
    Expected := FReference);
FLessThanSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual,
    Maximum := FReference);
FLessEqualSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual,
    Maximum := FReference);
FGreaterThanSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual,
    Minimum := FReference);
FGreaterEqualSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual,
    Minimum := FReference);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{ae10b2b2-affe-4dee-958c-e1046ba4383f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Preserves base validation and rejects incomplete subject or checking-Assertion setup.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := SUPER^.CheckInitialization();
IF NOT CheckInitialization THEN
    RETURN;
END_IF;

CheckInitialization := FSetupValid
    AND FEqualResult.IsInitialized
    AND FNotEqualResult.IsInitialized
    AND FLessThanResult.IsInitialized
    AND FLessEqualResult.IsInitialized
    AND FGreaterThanResult.IsInitialized
    AND FGreaterEqualResult.IsInitialized
    AND FCaptureIntegrity.IsInitialized;
IF NOT CheckInitialization THEN
    EventPublisher.PublishEvent(Event := CreateFrameworkEvent(Name := Name,
        ResourceName := '',
        State := State,
        Severity := E_EventSeverity.Error,
        Message := 'Comparison selftest setup failed.'));
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckResults" Id="{ca60ebf1-2905-4d50-afb1-02764444d309}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Compares observed results with the literal row expectations and checks local event loss/count.</summary>
*)
{endregion}
METHOD PRIVATE CheckResults]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualResultMatches := FEqualSubject.Result = FExpectedEqualResult;
FNotEqualResultMatches := FNotEqualSubject.Result = FExpectedNotEqualResult;
FLessThanResultMatches := FLessThanSubject.Result = FExpectedLessThanResult;
FLessEqualResultMatches := FLessEqualSubject.Result = FExpectedLessEqualResult;
FGreaterThanResultMatches := FGreaterThanSubject.Result = FExpectedGreaterThanResult;
FGreaterEqualResultMatches := FGreaterEqualSubject.Result = FExpectedGreaterEqualResult;
FCaptureIntegrityMatches := (FCaptureStatus.SequenceId = ExpectedFindingCount)
    AND (FCaptureStatus.LostEventCount = 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{7a43e900-5d7d-4c35-84ac-2171ddf41731}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes the local capture, checking Assertions and publisher-bound real comparisons.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR
    Initialized : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FEqualResult.Initialize(Parent := THIS^,
    AssertionName := 'EqualResult');
FNotEqualResult.Initialize(Parent := THIS^,
    AssertionName := 'NotEqualResult');
FLessThanResult.Initialize(Parent := THIS^,
    AssertionName := 'LessThanResult');
FLessEqualResult.Initialize(Parent := THIS^,
    AssertionName := 'LessEqualResult');
FGreaterThanResult.Initialize(Parent := THIS^,
    AssertionName := 'GreaterThanResult');
FGreaterEqualResult.Initialize(Parent := THIS^,
    AssertionName := 'GreaterEqualResult');
FCaptureIntegrity.Initialize(Parent := THIS^,
    AssertionName := 'CaptureIntegrity');
FSetupValid := FCapture.Initialize(Buffer := FEvents,
    FifoControl := FCaptureFifo,
    Status := FCaptureStatus);
FEqualSubject.BindPublisher(Publisher := FCapture);
Initialized := FEqualSubject.Initialize(Parent := THIS^,
    AssertionName := 'EqualSubject');
FSetupValid := FSetupValid AND Initialized;
FNotEqualSubject.BindPublisher(Publisher := FCapture);
Initialized := FNotEqualSubject.Initialize(Parent := THIS^,
    AssertionName := 'NotEqualSubject');
FSetupValid := FSetupValid AND Initialized;
FLessThanSubject.BindPublisher(Publisher := FCapture);
Initialized := FLessThanSubject.Initialize(Parent := THIS^,
    AssertionName := 'LessThanSubject');
FSetupValid := FSetupValid AND Initialized;
FLessEqualSubject.BindPublisher(Publisher := FCapture);
Initialized := FLessEqualSubject.Initialize(Parent := THIS^,
    AssertionName := 'LessEqualSubject');
FSetupValid := FSetupValid AND Initialized;
FGreaterThanSubject.BindPublisher(Publisher := FCapture);
Initialized := FGreaterThanSubject.Initialize(Parent := THIS^,
    AssertionName := 'GreaterThanSubject');
FSetupValid := FSetupValid AND Initialized;
FGreaterEqualSubject.BindPublisher(Publisher := FCapture);
Initialized := FGreaterEqualSubject.Initialize(Parent := THIS^,
    AssertionName := 'GreaterEqualSubject');
FSetupValid := FSetupValid AND Initialized;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{233c9375-b5e8-429b-a83c-a060c3509f76}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes abort without asynchronous resources.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{c1673ab1-3df5-448b-aaf3-299c7ab1be43}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Latches checked observations before the next script step may proceed.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR
VAR
    Evaluate : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Evaluate := Enable AND FObservationReady;
FEqualResult(Enable := Evaluate,
    State := State,
    IN := FEqualResultMatches);
FNotEqualResult(Enable := Evaluate,
    State := State,
    IN := FNotEqualResultMatches);
FLessThanResult(Enable := Evaluate,
    State := State,
    IN := FLessThanResultMatches);
FLessEqualResult(Enable := Evaluate,
    State := State,
    IN := FLessEqualResultMatches);
FGreaterThanResult(Enable := Evaluate,
    State := State,
    IN := FGreaterThanResultMatches);
FGreaterEqualResult(Enable := Evaluate,
    State := State,
    IN := FGreaterEqualResultMatches);
FCaptureIntegrity(Enable := Evaluate,
    State := State,
    IN := FCaptureIntegrityMatches);
IF Evaluate THEN
    FChecked := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{00065b66-5e42-4d6e-9750-633cb4507a8d}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation phase is required.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required hook; this test has no Preparation phase.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{053997d7-c72e-45ac-a01a-587deae7522c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Restarts the script and resets the checking Assertions.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FRow := BelowSignedBoundary;
FRowPrepared := FALSE;
FChecked := FALSE;
FObservationReady := FALSE;
FEqualResult.Reset();
FEqualResultMatches := TRUE;
FNotEqualResult.Reset();
FNotEqualResultMatches := TRUE;
FLessThanResult.Reset();
FLessThanResultMatches := TRUE;
FLessEqualResult.Reset();
FLessEqualResultMatches := TRUE;
FGreaterThanResult.Reset();
FGreaterThanResultMatches := TRUE;
FGreaterEqualResult.Reset();
FGreaterEqualResultMatches := TRUE;
FCaptureIntegrity.Reset();
FCaptureIntegrityMatches := TRUE;
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{5e059b91-55cb-46c6-9cda-cfc6b7dcba54}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Advances one bounded script step per active PLC cycle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FChecked THEN
    FChecked := FALSE;
    FObservationReady := FALSE;
    IF FRow = LastRow THEN
        CompleteTests();
        RETURN;
    END_IF;
    FRow := FRow + 1;
    FRowPrepared := FALSE;
END_IF;

IF NOT FRowPrepared THEN
    SelectRow();
    FCapture.Reset();
    ResetSubjects();
    CallSubjects(Enable := FALSE);
    FRowPrepared := TRUE;
ELSE
    CallSubjects(Enable := TRUE);
    CheckResults();
    FObservationReady := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetSubjects" Id="{6f0c0861-d221-47eb-8491-33e3342fd6d9}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Requests a fresh result epoch for every comparison; CallSubjects consumes it.</summary>
*)
{endregion}
METHOD PRIVATE ResetSubjects]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualSubject.Reset();
FNotEqualSubject.Reset();
FLessThanSubject.Reset();
FLessEqualSubject.Reset();
FGreaterThanSubject.Reset();
FGreaterEqualSubject.Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectRow" Id="{026a36ba-f63c-4cea-a118-7215f1be9091}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Selects literal typed inputs and independent expected results for one comparison row.</summary>
*)
{endregion}
METHOD PRIVATE SelectRow]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE FRow OF
    BelowSignedBoundary:
        FActual := ULINT#9223372036854775807;
        FReference := SignedBoundary;
        FExpectedEqualResult := E_Result.Failed;
        FExpectedNotEqualResult := E_Result.Passed;
        FExpectedLessThanResult := E_Result.Passed;
        FExpectedLessEqualResult := E_Result.Passed;
        FExpectedGreaterThanResult := E_Result.Failed;
        FExpectedGreaterEqualResult := E_Result.Failed;
    EqualSignedBoundary:
        FActual := SignedBoundary;
        FReference := SignedBoundary;
        FExpectedEqualResult := E_Result.Passed;
        FExpectedNotEqualResult := E_Result.Failed;
        FExpectedLessThanResult := E_Result.Failed;
        FExpectedLessEqualResult := E_Result.Passed;
        FExpectedGreaterThanResult := E_Result.Failed;
        FExpectedGreaterEqualResult := E_Result.Passed;
    AboveSignedBoundary:
        FActual := ULINT#9223372036854775809;
        FReference := SignedBoundary;
        FExpectedEqualResult := E_Result.Failed;
        FExpectedNotEqualResult := E_Result.Passed;
        FExpectedLessThanResult := E_Result.Failed;
        FExpectedLessEqualResult := E_Result.Failed;
        FExpectedGreaterThanResult := E_Result.Passed;
        FExpectedGreaterEqualResult := E_Result.Passed;
    ZeroBelowMaximum:
        FActual := ULINT#0;
        FReference := HighestValue;
        FExpectedEqualResult := E_Result.Failed;
        FExpectedNotEqualResult := E_Result.Passed;
        FExpectedLessThanResult := E_Result.Passed;
        FExpectedLessEqualResult := E_Result.Passed;
        FExpectedGreaterThanResult := E_Result.Failed;
        FExpectedGreaterEqualResult := E_Result.Failed;
    MaximumAboveZero:
        FActual := HighestValue;
        FReference := ULINT#0;
        FExpectedEqualResult := E_Result.Failed;
        FExpectedNotEqualResult := E_Result.Passed;
        FExpectedLessThanResult := E_Result.Failed;
        FExpectedLessEqualResult := E_Result.Failed;
        FExpectedGreaterThanResult := E_Result.Passed;
        FExpectedGreaterEqualResult := E_Result.Passed;
    ZeroEqual:
        FActual := ULINT#0;
        FReference := ULINT#0;
        FExpectedEqualResult := E_Result.Passed;
        FExpectedNotEqualResult := E_Result.Failed;
        FExpectedLessThanResult := E_Result.Failed;
        FExpectedLessEqualResult := E_Result.Passed;
        FExpectedGreaterThanResult := E_Result.Failed;
        FExpectedGreaterEqualResult := E_Result.Passed;
    MaximumEqual:
        FActual := HighestValue;
        FReference := HighestValue;
        FExpectedEqualResult := E_Result.Passed;
        FExpectedNotEqualResult := E_Result.Failed;
        FExpectedLessThanResult := E_Result.Failed;
        FExpectedLessEqualResult := E_Result.Passed;
        FExpectedGreaterThanResult := E_Result.Failed;
        FExpectedGreaterEqualResult := E_Result.Passed;
ELSE
    Error(Message := 'Unknown comparison test row.');
END_CASE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>