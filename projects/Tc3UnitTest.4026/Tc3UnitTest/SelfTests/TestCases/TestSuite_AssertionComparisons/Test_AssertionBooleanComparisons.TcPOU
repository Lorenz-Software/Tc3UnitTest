<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_AssertionBooleanComparisons" Id="{5e6ff507-4c19-44ac-8039-efbf6552d0da}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks BOOL equality, inequality and direct truth predicates with all truth-table inputs.</summary>
<description>
Each named row has explicit expected results, not a second comparison algorithm.
One disabled subject call consumes Reset before one enabled comparison call.
Outer checking Assertions latch every row before inputs advance; intentional
subject failures remain in a Test-Case-owned Event Buffer, cleared between rows.
Only the checking Assertions contribute to the outer result.
</description>
*)
{endregion}
FUNCTION_BLOCK Test_AssertionBooleanComparisons EXTENDS TestCaseBase
VAR
    FEqualSubject : AssertEqual_Bool;
    FNotEqualSubject : AssertNotEqual_Bool;
    FTrueSubject : AssertTrue;
    FFalseSubject : AssertFalse;
    FActual : BOOL;
    FExpected : BOOL;
    FExpectedEqualResult : E_Result;
    FExpectedNotEqualResult : E_Result;
    FExpectedTrueResult : E_Result;
    FExpectedFalseResult : E_Result;
    FCapture : EventBuffer;
    FEvents : ARRAY[1..CaptureLength] OF ST_Event;
    FCaptureFifo : ST_FifoStatus;
    FCaptureStatus : ST_EventBufferStatus;
    FRow : UINT;
    FRowPrepared : BOOL;
    FObservationReady : BOOL;
    FChecked : BOOL;
    FSetupValid : BOOL;
END_VAR
VAR
    FEqualResult : AssertTrue;
    FEqualResultMatches : BOOL;
    FNotEqualResult : AssertTrue;
    FNotEqualResultMatches : BOOL;
    FTrueResult : AssertTrue;
    FTrueResultMatches : BOOL;
    FFalseResult : AssertTrue;
    FFalseResultMatches : BOOL;
    FCaptureIntegrity : AssertTrue;
    FCaptureIntegrityMatches : BOOL;
END_VAR
VAR CONSTANT
    CaptureLength : UINT := 8;
    ExpectedFindingCount : UDINT := 2;
    BothFalse : UINT := 1;
    FalseVersusTrue : UINT := 2;
    TrueVersusFalse : UINT := 3;
    BothTrue : UINT := 4;
    LastRow : UINT := BothTrue;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{0e8ffba6-a69f-4d71-89dd-6dc2741f7241}" />
    <Method Name="AggregateResults" Id="{58fb4fb9-73f8-4fb4-933c-c668b7d40d38}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Collects only outer checking Assertions, never intentional subject findings.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FEqualResult);
Aggregator.AddProvider(Provider := FNotEqualResult);
Aggregator.AddProvider(Provider := FTrueResult);
Aggregator.AddProvider(Provider := FFalseResult);
Aggregator.AddProvider(Provider := FCaptureIntegrity);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallSubjects" Id="{b831883c-79e8-4199-ac68-52e3f96094ff}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls each real comparison once with the selected typed row inputs.</summary>
*)
{endregion}
METHOD PRIVATE CallSubjects
VAR_INPUT
    Enable : BOOL; //! Observation-enable input forwarded to the controlled Assertion subjects for this call.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual,
    Expected := FExpected);
FNotEqualSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual,
    Expected := FExpected);
FTrueSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual);
FFalseSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActual);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{55f04805-08f4-4334-a7ba-850a01ef1b3b}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Preserves base validation and rejects incomplete subject or checking-Assertion setup.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := SUPER^.CheckInitialization();
IF NOT CheckInitialization THEN
    RETURN;
END_IF;

CheckInitialization := FSetupValid
    AND FEqualResult.IsInitialized
    AND FNotEqualResult.IsInitialized
    AND FTrueResult.IsInitialized
    AND FFalseResult.IsInitialized
    AND FCaptureIntegrity.IsInitialized;
IF NOT CheckInitialization THEN
    EventPublisher.PublishEvent(Event := CreateFrameworkEvent(Name := Name,
        ResourceName := '',
        State := State,
        Severity := E_EventSeverity.Error,
        Message := 'Comparison selftest setup failed.'));
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckResults" Id="{4b960f5d-061a-4c7d-b7eb-8906b2839a77}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Compares observed results with the literal row expectations and checks local event loss/count.</summary>
*)
{endregion}
METHOD PRIVATE CheckResults]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualResultMatches := FEqualSubject.Result = FExpectedEqualResult;
FNotEqualResultMatches := FNotEqualSubject.Result = FExpectedNotEqualResult;
FTrueResultMatches := FTrueSubject.Result = FExpectedTrueResult;
FFalseResultMatches := FFalseSubject.Result = FExpectedFalseResult;
FCaptureIntegrityMatches := (FCaptureStatus.SequenceId = ExpectedFindingCount)
    AND (FCaptureStatus.LostEventCount = 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{7b4ce8d3-e278-416f-9715-76f4c9c3f7f8}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes the local capture, checking Assertions and publisher-bound real comparisons.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR
    Initialized : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FEqualResult.Initialize(Parent := THIS^,
    AssertionName := 'EqualResult');
FNotEqualResult.Initialize(Parent := THIS^,
    AssertionName := 'NotEqualResult');
FTrueResult.Initialize(Parent := THIS^,
    AssertionName := 'TrueResult');
FFalseResult.Initialize(Parent := THIS^,
    AssertionName := 'FalseResult');
FCaptureIntegrity.Initialize(Parent := THIS^,
    AssertionName := 'CaptureIntegrity');
FSetupValid := FCapture.Initialize(Buffer := FEvents,
    FifoControl := FCaptureFifo,
    Status := FCaptureStatus);
FEqualSubject.BindPublisher(Publisher := FCapture);
Initialized := FEqualSubject.Initialize(Parent := THIS^,
    AssertionName := 'EqualSubject');
FSetupValid := FSetupValid AND Initialized;
FNotEqualSubject.BindPublisher(Publisher := FCapture);
Initialized := FNotEqualSubject.Initialize(Parent := THIS^,
    AssertionName := 'NotEqualSubject');
FSetupValid := FSetupValid AND Initialized;
FTrueSubject.BindPublisher(Publisher := FCapture);
Initialized := FTrueSubject.Initialize(Parent := THIS^,
    AssertionName := 'TrueSubject');
FSetupValid := FSetupValid AND Initialized;
FFalseSubject.BindPublisher(Publisher := FCapture);
Initialized := FFalseSubject.Initialize(Parent := THIS^,
    AssertionName := 'FalseSubject');
FSetupValid := FSetupValid AND Initialized;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{f3d484c2-9e62-439b-aca7-2783c6a188f4}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes abort without asynchronous resources.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{2a5981f0-546b-45c6-83ca-7c53a4fb3a93}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Latches checked observations before the next script step may proceed.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR
VAR
    Evaluate : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Evaluate := Enable AND FObservationReady;
FEqualResult(Enable := Evaluate,
    State := State,
    IN := FEqualResultMatches);
FNotEqualResult(Enable := Evaluate,
    State := State,
    IN := FNotEqualResultMatches);
FTrueResult(Enable := Evaluate,
    State := State,
    IN := FTrueResultMatches);
FFalseResult(Enable := Evaluate,
    State := State,
    IN := FFalseResultMatches);
FCaptureIntegrity(Enable := Evaluate,
    State := State,
    IN := FCaptureIntegrityMatches);
IF Evaluate THEN
    FChecked := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{ca6f6e4b-89b4-4b30-b1b2-88c26dbc3126}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation phase is required.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required hook; this test has no Preparation phase.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{5ba55ada-d84a-472a-86dc-814df0b6ebc5}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Restarts the script and resets the checking Assertions.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FRow := BothFalse;
FRowPrepared := FALSE;
FChecked := FALSE;
FObservationReady := FALSE;
FEqualResult.Reset();
FEqualResultMatches := TRUE;
FNotEqualResult.Reset();
FNotEqualResultMatches := TRUE;
FTrueResult.Reset();
FTrueResultMatches := TRUE;
FFalseResult.Reset();
FFalseResultMatches := TRUE;
FCaptureIntegrity.Reset();
FCaptureIntegrityMatches := TRUE;
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{56ed7e7a-8f19-420c-9ea5-6b7e76a88365}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Advances one bounded script step per active PLC cycle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FChecked THEN
    FChecked := FALSE;
    FObservationReady := FALSE;
    IF FRow = LastRow THEN
        CompleteTests();
        RETURN;
    END_IF;
    FRow := FRow + 1;
    FRowPrepared := FALSE;
END_IF;

IF NOT FRowPrepared THEN
    SelectRow();
    FCapture.Reset();
    ResetSubjects();
    CallSubjects(Enable := FALSE);
    FRowPrepared := TRUE;
ELSE
    CallSubjects(Enable := TRUE);
    CheckResults();
    FObservationReady := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetSubjects" Id="{f18c513a-fe1d-4e79-b854-d1b1bf2275ba}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Requests a fresh result epoch for every comparison; CallSubjects consumes it.</summary>
*)
{endregion}
METHOD PRIVATE ResetSubjects]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqualSubject.Reset();
FNotEqualSubject.Reset();
FTrueSubject.Reset();
FFalseSubject.Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectRow" Id="{9e9e2ba0-b480-4769-9c40-2a81f2bae2c0}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Selects literal typed inputs and independent expected results for one comparison row.</summary>
*)
{endregion}
METHOD PRIVATE SelectRow]]></Declaration>
      <Implementation>
        <ST><![CDATA[CASE FRow OF
    BothFalse:
        FActual := FALSE;
        FExpected := FALSE;
        FExpectedEqualResult := E_Result.Passed;
        FExpectedNotEqualResult := E_Result.Failed;
        FExpectedTrueResult := E_Result.Failed;
        FExpectedFalseResult := E_Result.Passed;
    FalseVersusTrue:
        FActual := FALSE;
        FExpected := TRUE;
        FExpectedEqualResult := E_Result.Failed;
        FExpectedNotEqualResult := E_Result.Passed;
        FExpectedTrueResult := E_Result.Failed;
        FExpectedFalseResult := E_Result.Passed;
    TrueVersusFalse:
        FActual := TRUE;
        FExpected := FALSE;
        FExpectedEqualResult := E_Result.Failed;
        FExpectedNotEqualResult := E_Result.Passed;
        FExpectedTrueResult := E_Result.Passed;
        FExpectedFalseResult := E_Result.Failed;
    BothTrue:
        FActual := TRUE;
        FExpected := TRUE;
        FExpectedEqualResult := E_Result.Passed;
        FExpectedNotEqualResult := E_Result.Failed;
        FExpectedTrueResult := E_Result.Passed;
        FExpectedFalseResult := E_Result.Failed;
ELSE
    Error(Message := 'Unknown comparison test row.');
END_CASE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>