<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_AssertionScalarDiagnostics" Id="{3a019f3a-bf0d-4dee-b2fb-ad60981ddb6f}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks literal expected/actual decimal, fixed-width hex and character rendering in captured findings.</summary>
<description>
Named rows separate independent comparisons by a disabled reset call.
Only explicitly marked escalation rows retain the preceding subject result.
Outer Assertions latch every observation before advancing to the next row.
Intentional findings remain in the local capture; no production algorithm is copied.
</description>
*)
{endregion}
FUNCTION_BLOCK Test_AssertionScalarDiagnostics EXTENDS TestCaseBase
VAR
    FSignedSubject : AssertEqual_LInt;
    FUnsignedSubject : AssertEqual_ULInt;
    FByteSubject : AssertEqual_Byte;
    FLWordSubject : AssertEqual_LWord;
    FCharSubject : AssertEqual_Char;
    FWCharSubject : AssertEqual_WChar;
    FActualSigned : LINT;
    FReferenceSigned : LINT;
    FExpectedSignedMessage : STRING(GVL_Constants.MessageLength);
    FActualUnsigned : ULINT;
    FReferenceUnsigned : ULINT;
    FExpectedUnsignedMessage : STRING(GVL_Constants.MessageLength);
    FActualByte : BYTE;
    FReferenceByte : BYTE;
    FExpectedByteMessage : STRING(GVL_Constants.MessageLength);
    FActualLWord : LWORD;
    FReferenceLWord : LWORD;
    FExpectedLWordMessage : STRING(GVL_Constants.MessageLength);
    FActualChar : BYTE;
    FReferenceChar : BYTE;
    FExpectedCharMessage : STRING(GVL_Constants.MessageLength);
    FActualWChar : WORD;
    FReferenceWChar : WORD;
    FExpectedWCharMessage : STRING(GVL_Constants.MessageLength);
    FExpectedSignedResult : E_Result;
    FExpectedUnsignedResult : E_Result;
    FExpectedByteResult : E_Result;
    FExpectedLWordResult : E_Result;
    FExpectedCharResult : E_Result;
    FExpectedWCharResult : E_Result;
    FExpectedFindings : UDINT;
    FCapture : EventBuffer;
    FEvents : ARRAY[1..CaptureLength] OF ST_Event;
    FCaptureFifo : ST_FifoStatus;
    FCaptureStatus : ST_EventBufferStatus;
    FRow : UINT;
    FRowPrepared : BOOL;
    FPreserveResults : BOOL;
    FObservationReady : BOOL;
    FChecked : BOOL;
    FSetupValid : BOOL;
END_VAR
VAR
    FSignedResult : AssertTrue;
    FSignedResultMatches : BOOL;
    FUnsignedResult : AssertTrue;
    FUnsignedResultMatches : BOOL;
    FByteResult : AssertTrue;
    FByteResultMatches : BOOL;
    FLWordResult : AssertTrue;
    FLWordResultMatches : BOOL;
    FCharResult : AssertTrue;
    FCharResultMatches : BOOL;
    FWCharResult : AssertTrue;
    FWCharResultMatches : BOOL;
    FCaptureIntegrity : AssertTrue;
    FCaptureIntegrityMatches : BOOL;
    FDiagnosticText : AssertTrue;
    FDiagnosticTextMatches : BOOL;
END_VAR
VAR CONSTANT
    CaptureLength : UINT := 16;
    Printable : UINT := 1;
    NullAndWide : UINT := 2;
    MaximumCodes : UINT := 3;
    LastRow : UINT := MaximumCodes;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{8262ba36-b60b-46e5-9c6d-cbd8d8db2edd}" />
    <Method Name="AggregateResults" Id="{f3af68d0-eba2-4008-acc2-c0267dd3a3f4}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Collects only outer checking Assertions, never intentional subject findings.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FSignedResult);
Aggregator.AddProvider(Provider := FUnsignedResult);
Aggregator.AddProvider(Provider := FByteResult);
Aggregator.AddProvider(Provider := FLWordResult);
Aggregator.AddProvider(Provider := FCharResult);
Aggregator.AddProvider(Provider := FWCharResult);
Aggregator.AddProvider(Provider := FCaptureIntegrity);
Aggregator.AddProvider(Provider := FDiagnosticText);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallSubjects" Id="{54e1e1be-e7d8-46d4-8638-3726ad7b1010}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls each inherited production Assertion once using the selected row.</summary>
*)
{endregion}
METHOD PRIVATE CallSubjects
VAR_INPUT
    Enable : BOOL; //! Observation-enable input forwarded to the controlled Assertion subjects for this call.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FSignedSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualSigned,
    Expected := FReferenceSigned);
FUnsignedSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualUnsigned,
    Expected := FReferenceUnsigned);
FByteSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualByte,
    Expected := FReferenceByte);
FLWordSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualLWord,
    Expected := FReferenceLWord);
FCharSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualChar,
    Expected := FReferenceChar);
FWCharSubject(Enable := Enable,
    State := E_State.Running,
    IN := FActualWChar,
    Expected := FReferenceWChar);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{47e4b512-389d-4ef4-837c-f6bf4f1a4a0a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Extends base validation with subject and checking-Assertion setup.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := SUPER^.CheckInitialization();
IF NOT CheckInitialization THEN
    RETURN;
END_IF;

CheckInitialization := FSetupValid
    AND FSignedResult.IsInitialized
    AND FUnsignedResult.IsInitialized
    AND FByteResult.IsInitialized
    AND FLWordResult.IsInitialized
    AND FCharResult.IsInitialized
    AND FWCharResult.IsInitialized
    AND FCaptureIntegrity.IsInitialized
    AND FDiagnosticText.IsInitialized;
IF NOT CheckInitialization THEN
    EventPublisher.PublishEvent(Event := CreateFrameworkEvent(Name := Name,
        ResourceName := '',
        State := State,
        Severity := E_EventSeverity.Error,
        Message := 'Comparison selftest setup failed.'));
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckResults" Id="{440083d0-c067-4f3a-9b10-55c0bcf2c86e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks results and isolated findings against explicit expectations.</summary>
*)
{endregion}
METHOD PRIVATE CheckResults]]></Declaration>
      <Implementation>
        <ST><![CDATA[FSignedResultMatches := FSignedSubject.Result = FExpectedSignedResult;
FUnsignedResultMatches := FUnsignedSubject.Result = FExpectedUnsignedResult;
FByteResultMatches := FByteSubject.Result = FExpectedByteResult;
FLWordResultMatches := FLWordSubject.Result = FExpectedLWordResult;
FCharResultMatches := FCharSubject.Result = FExpectedCharResult;
FWCharResultMatches := FWCharSubject.Result = FExpectedWCharResult;
FCaptureIntegrityMatches := (FCaptureStatus.SequenceId = FExpectedFindings)
    AND (FCaptureStatus.LostEventCount = 0);
FDiagnosticTextMatches := (FEvents[1].Message = FExpectedSignedMessage)
    AND (FEvents[1].Name = FSignedSubject.Name)
    AND (FEvents[1].Result = E_Result.Failed)
    AND (FEvents[2].Message = FExpectedUnsignedMessage)
    AND (FEvents[2].Name = FUnsignedSubject.Name)
    AND (FEvents[2].Result = E_Result.Failed)
    AND (FEvents[3].Message = FExpectedByteMessage)
    AND (FEvents[3].Name = FByteSubject.Name)
    AND (FEvents[3].Result = E_Result.Failed)
    AND (FEvents[4].Message = FExpectedLWordMessage)
    AND (FEvents[4].Name = FLWordSubject.Name)
    AND (FEvents[4].Result = E_Result.Failed)
    AND (FEvents[5].Message = FExpectedCharMessage)
    AND (FEvents[5].Name = FCharSubject.Name)
    AND (FEvents[5].Result = E_Result.Failed)
    AND (FEvents[6].Message = FExpectedWCharMessage)
    AND (FEvents[6].Name = FWCharSubject.Name)
    AND (FEvents[6].Result = E_Result.Failed);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{4cf98ba8-c5d3-4dd5-9a7f-ae6baf25712c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Configures checking Assertions; subject actions remain in the test script.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR
    Initialized : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FSignedResult.Initialize(Parent := THIS^,
    AssertionName := 'SignedResult');
FUnsignedResult.Initialize(Parent := THIS^,
    AssertionName := 'UnsignedResult');
FByteResult.Initialize(Parent := THIS^,
    AssertionName := 'ByteResult');
FLWordResult.Initialize(Parent := THIS^,
    AssertionName := 'LWordResult');
FCharResult.Initialize(Parent := THIS^,
    AssertionName := 'CharResult');
FWCharResult.Initialize(Parent := THIS^,
    AssertionName := 'WCharResult');
FCaptureIntegrity.Initialize(Parent := THIS^,
    AssertionName := 'CaptureIntegrity');
FDiagnosticText.Initialize(Parent := THIS^,
    AssertionName := 'DiagnosticText');
FSetupValid := FCapture.Initialize(Buffer := FEvents,
    FifoControl := FCaptureFifo,
    Status := FCaptureStatus);
FSignedSubject.BindPublisher(Publisher := FCapture);
Initialized := FSignedSubject.Initialize(Parent := THIS^,
    AssertionName := 'SignedSubject');
FSetupValid := FSetupValid AND Initialized;
FUnsignedSubject.BindPublisher(Publisher := FCapture);
Initialized := FUnsignedSubject.Initialize(Parent := THIS^,
    AssertionName := 'UnsignedSubject');
FSetupValid := FSetupValid AND Initialized;
FByteSubject.BindPublisher(Publisher := FCapture);
Initialized := FByteSubject.Initialize(Parent := THIS^,
    AssertionName := 'ByteSubject');
FSetupValid := FSetupValid AND Initialized;
FLWordSubject.BindPublisher(Publisher := FCapture);
Initialized := FLWordSubject.Initialize(Parent := THIS^,
    AssertionName := 'LWordSubject');
FSetupValid := FSetupValid AND Initialized;
FCharSubject.BindPublisher(Publisher := FCapture);
Initialized := FCharSubject.Initialize(Parent := THIS^,
    AssertionName := 'CharSubject');
FSetupValid := FSetupValid AND Initialized;
FWCharSubject.BindPublisher(Publisher := FCapture);
Initialized := FWCharSubject.Initialize(Parent := THIS^,
    AssertionName := 'WCharSubject');
FSetupValid := FSetupValid AND Initialized;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{fbe476b3-bfa3-4627-9446-7e1382312d0e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes abort without asynchronous resources.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{bb8c24b6-9332-411a-bd3a-cf1b3fbbac98}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Latches checked observations before the next script step may proceed.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR
VAR
    Evaluate : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Evaluate := Enable AND FObservationReady;
FSignedResult(Enable := Evaluate,
    State := State,
    IN := FSignedResultMatches);
FUnsignedResult(Enable := Evaluate,
    State := State,
    IN := FUnsignedResultMatches);
FByteResult(Enable := Evaluate,
    State := State,
    IN := FByteResultMatches);
FLWordResult(Enable := Evaluate,
    State := State,
    IN := FLWordResultMatches);
FCharResult(Enable := Evaluate,
    State := State,
    IN := FCharResultMatches);
FWCharResult(Enable := Evaluate,
    State := State,
    IN := FWCharResultMatches);
FCaptureIntegrity(Enable := Evaluate,
    State := State,
    IN := FCaptureIntegrityMatches);
FDiagnosticText(Enable := Evaluate,
    State := State,
    IN := FDiagnosticTextMatches);
IF Evaluate THEN
    FChecked := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{3a61939b-d430-4094-9a2f-6f49d7e8c365}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation phase is required.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required hook; this test has no Preparation phase.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{8fd00f23-6f7b-46f2-abb6-d66b647f3aad}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Restarts the script and resets the checking Assertions.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FRow := Printable;
FRowPrepared := FALSE;
FChecked := FALSE;
FObservationReady := FALSE;
FSignedResult.Reset();
FSignedResultMatches := TRUE;
FUnsignedResult.Reset();
FUnsignedResultMatches := TRUE;
FByteResult.Reset();
FByteResultMatches := TRUE;
FLWordResult.Reset();
FLWordResultMatches := TRUE;
FCharResult.Reset();
FCharResultMatches := TRUE;
FWCharResult.Reset();
FWCharResultMatches := TRUE;
FCaptureIntegrity.Reset();
FCaptureIntegrityMatches := TRUE;
FDiagnosticText.Reset();
FDiagnosticTextMatches := TRUE;
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{40ed75c9-d618-487e-9676-4b739eb54c26}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Advances one bounded script step per active PLC cycle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FChecked THEN
    FChecked := FALSE;
    FObservationReady := FALSE;
    IF FRow = LastRow THEN
        CompleteTests();
        RETURN;
    END_IF;
    FRow := FRow + 1;
    FRowPrepared := FALSE;
END_IF;

IF NOT FRowPrepared THEN
    SelectRow();
    FCapture.Reset();
    IF NOT FPreserveResults THEN
        ResetSubjects();
    END_IF;
    CallSubjects(Enable := FALSE);
    FRowPrepared := TRUE;
ELSE
    CallSubjects(Enable := TRUE);
    CheckResults();
    FObservationReady := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetSubjects" Id="{07421372-eccf-47d3-a21f-9012736f247c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Requests fresh subject results before the next disabled call.</summary>
*)
{endregion}
METHOD PRIVATE ResetSubjects]]></Declaration>
      <Implementation>
        <ST><![CDATA[FSignedSubject.Reset();
FUnsignedSubject.Reset();
FByteSubject.Reset();
FLWordSubject.Reset();
FCharSubject.Reset();
FWCharSubject.Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectRow" Id="{7410ddf2-01b2-45c9-8f15-0c76e3a682a6}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Selects literal expectations; only named escalation rows retain preceding subject results.</summary>
*)
{endregion}
METHOD PRIVATE SelectRow]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreserveResults := FALSE;
CASE FRow OF
    Printable:
        FActualSigned := LINT#-9223372036854775808;
        FReferenceSigned := LINT#9223372036854775807;
        FActualUnsigned := ULINT#18446744073709551615;
        FReferenceUnsigned := ULINT#0;
        FActualByte := BYTE#16#80;
        FReferenceByte := BYTE#16#01;
        FActualLWord := LWORD#16#8000000000000000;
        FReferenceLWord := LWORD#16#0000000000000001;
        FActualChar := BYTE#16#41;
        FReferenceChar := BYTE#16#42;
        FActualWChar := WORD#16#0041;
        FReferenceWChar := WORD#16#0042;
        FExpectedSignedMessage := 'Assertion failed: values are not equal. Expected = 9223372036854775807, Actual = -9223372036854775808.';
        FExpectedUnsignedMessage := 'Assertion failed: values are not equal. Expected = 0, Actual = 18446744073709551615.';
        FExpectedByteMessage := 'Assertion failed: values are not equal. Expected = 16#01, Actual = 16#80.';
        FExpectedLWordMessage := 'Assertion failed: values are not equal. Expected = 16#0000000000000001, Actual = 16#8000000000000000.';
        FExpectedCharMessage := 'Assertion failed: values are not equal. Expected = $'B$' (16#42), Actual = $'A$' (16#41).';
        FExpectedWCharMessage := 'Assertion failed: values are not equal. Expected = $'B$' (16#0042), Actual = $'A$' (16#0041).';
        FExpectedSignedResult := E_Result.Failed;
        FExpectedUnsignedResult := E_Result.Failed;
        FExpectedByteResult := E_Result.Failed;
        FExpectedLWordResult := E_Result.Failed;
        FExpectedCharResult := E_Result.Failed;
        FExpectedWCharResult := E_Result.Failed;
        FExpectedFindings := 6;
    NullAndWide:
        FActualSigned := LINT#-9223372036854775808;
        FReferenceSigned := LINT#9223372036854775807;
        FActualUnsigned := ULINT#18446744073709551615;
        FReferenceUnsigned := ULINT#0;
        FActualByte := BYTE#16#80;
        FReferenceByte := BYTE#16#01;
        FActualLWord := LWORD#16#8000000000000000;
        FReferenceLWord := LWORD#16#0000000000000001;
        FActualChar := BYTE#0;
        FReferenceChar := BYTE#16#41;
        FActualWChar := WORD#16#0100;
        FReferenceWChar := WORD#0;
        FExpectedSignedMessage := 'Assertion failed: values are not equal. Expected = 9223372036854775807, Actual = -9223372036854775808.';
        FExpectedUnsignedMessage := 'Assertion failed: values are not equal. Expected = 0, Actual = 18446744073709551615.';
        FExpectedByteMessage := 'Assertion failed: values are not equal. Expected = 16#01, Actual = 16#80.';
        FExpectedLWordMessage := 'Assertion failed: values are not equal. Expected = 16#0000000000000001, Actual = 16#8000000000000000.';
        FExpectedCharMessage := 'Assertion failed: values are not equal. Expected = $'A$' (16#41), Actual = 16#00.';
        FExpectedWCharMessage := 'Assertion failed: values are not equal. Expected = 16#0000, Actual = 16#0100.';
        FExpectedSignedResult := E_Result.Failed;
        FExpectedUnsignedResult := E_Result.Failed;
        FExpectedByteResult := E_Result.Failed;
        FExpectedLWordResult := E_Result.Failed;
        FExpectedCharResult := E_Result.Failed;
        FExpectedWCharResult := E_Result.Failed;
        FExpectedFindings := 6;
    MaximumCodes:
        FActualSigned := LINT#-9223372036854775808;
        FReferenceSigned := LINT#9223372036854775807;
        FActualUnsigned := ULINT#18446744073709551615;
        FReferenceUnsigned := ULINT#0;
        FActualByte := BYTE#16#80;
        FReferenceByte := BYTE#16#01;
        FActualLWord := LWORD#16#8000000000000000;
        FReferenceLWord := LWORD#16#0000000000000001;
        FActualChar := BYTE#16#FF;
        FReferenceChar := BYTE#0;
        FActualWChar := WORD#16#FFFF;
        FReferenceWChar := WORD#0;
        FExpectedSignedMessage := 'Assertion failed: values are not equal. Expected = 9223372036854775807, Actual = -9223372036854775808.';
        FExpectedUnsignedMessage := 'Assertion failed: values are not equal. Expected = 0, Actual = 18446744073709551615.';
        FExpectedByteMessage := 'Assertion failed: values are not equal. Expected = 16#01, Actual = 16#80.';
        FExpectedLWordMessage := 'Assertion failed: values are not equal. Expected = 16#0000000000000001, Actual = 16#8000000000000000.';
        FExpectedCharMessage := 'Assertion failed: values are not equal. Expected = 16#00, Actual = 16#FF.';
        FExpectedWCharMessage := 'Assertion failed: values are not equal. Expected = 16#0000, Actual = 16#FFFF.';
        FExpectedSignedResult := E_Result.Failed;
        FExpectedUnsignedResult := E_Result.Failed;
        FExpectedByteResult := E_Result.Failed;
        FExpectedLWordResult := E_Result.Failed;
        FExpectedCharResult := E_Result.Failed;
        FExpectedWCharResult := E_Result.Failed;
        FExpectedFindings := 6;
ELSE
    Error(Message := 'Unknown comparison test row.');
END_CASE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>