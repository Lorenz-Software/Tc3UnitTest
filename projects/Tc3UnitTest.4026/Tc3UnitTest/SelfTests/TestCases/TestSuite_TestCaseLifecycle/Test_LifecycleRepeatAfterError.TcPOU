  <POU Name="Test_LifecycleRepeatAfterError" Id="{bef157c9-3f38-46ac-9ba6-651d2f9043c5}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks stable Error completion, one-shot finalization and a fresh successful run after Reset.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_LifecycleRepeatAfterError EXTENDS TestCaseLifecycleTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{e0001921-0483-4920-b299-e4ceee436079}" />
    <Method Name="ConfigureScenario" Id="{1a9f6e3a-dba6-408a-aba6-96db29c21b14}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines two independent run outcomes and cumulative event expectations across Reset.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FSubjectPreparationCount := 0;
FSubjectTestCount := 1;
FStepCount := 16;

{region "01 - Reset establishes the initial Idle state"}
