<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_LifecycleMultipleStates" Id="{e3128315-8490-4a8b-9ec4-c2f239504d0f}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks two Preparation and two Test states, including immediate hook-to-hook transitions.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_LifecycleMultipleStates EXTENDS TestCaseLifecycleTestBase

VAR CONSTANT
    SecondPreparationState : E_State := E_State.Preparing + 1;
    SecondTestState : E_State := E_State.Running + 1;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{9e26c58a-ce9a-4eb3-a83a-f39cbff8192b}" />
    <Method Name="ConfigureScenario" Id="{d590e3f4-c95b-4dd9-a364-ad68fbad3e4a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines independent per-call stimuli and expected lifecycle/hook observations.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FSubjectPreparationCount := 2;
FSubjectTestCount := 2;
FStepCount := 9;

{region "01 - Reset to Idle"}
// Establish Idle through the parent Reset request; both child results must be cleared.
FSteps[1].RequestReset := TRUE;
FSteps[1].ExpectedState := E_State.Idle;
FSteps[1].ExpectedResult := E_Result.NotEvaluated;
FSteps[1].ExpectedReady := TRUE;
FSteps[1].ExpectedPassedCount := 0;
FSteps[1].ExpectedFailedCount := 0;
FSteps[1].ExpectedHookCount := 6;
FSteps[1].ExpectedHooks[1].Hook := E_LifecycleHook.Reset;
FSteps[1].ExpectedHooks[1].State := E_State.Reset;
FSteps[1].ExpectedHooks[1].Enabled := TRUE;
FSteps[1].ExpectedHooks[2].Hook := E_LifecycleHook.Abort;
FSteps[1].ExpectedHooks[2].State := E_State.Idle;
FSteps[1].ExpectedHooks[2].Enabled := FALSE;
FSteps[1].ExpectedHooks[3].Hook := E_LifecycleHook.Preparations;
FSteps[1].ExpectedHooks[3].State := E_State.Idle;
FSteps[1].ExpectedHooks[3].Enabled := FALSE;
FSteps[1].ExpectedHooks[4].Hook := E_LifecycleHook.Tests;
FSteps[1].ExpectedHooks[4].State := E_State.Idle;
FSteps[1].ExpectedHooks[4].Enabled := FALSE;
FSteps[1].ExpectedHooks[5].Hook := E_LifecycleHook.Assertions;
FSteps[1].ExpectedHooks[5].State := E_State.Idle;
FSteps[1].ExpectedHooks[5].Enabled := FALSE;
FSteps[1].ExpectedHooks[6].Hook := E_LifecycleHook.Aggregate;
FSteps[1].ExpectedHooks[6].State := E_State.Idle;
FSteps[1].ExpectedHooks[6].Enabled := TRUE;
{endregion}

{region "02 - Accept Start"}
// Accept Start into Starting; processing and Assertion evaluation are not active yet.
FSteps[2].RequestStart := TRUE;
FSteps[2].ExpectedState := E_State.Starting;
FSteps[2].ExpectedResult := E_Result.NotEvaluated;
FSteps[2].ExpectedReady := FALSE;
FSteps[2].ExpectedPassedCount := 0;
FSteps[2].ExpectedFailedCount := 0;
FSteps[2].ExpectedHookCount := 5;
FSteps[2].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[2].ExpectedHooks[1].State := E_State.Starting;
FSteps[2].ExpectedHooks[1].Enabled := FALSE;
FSteps[2].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[2].ExpectedHooks[2].State := E_State.Starting;
FSteps[2].ExpectedHooks[2].Enabled := FALSE;
FSteps[2].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[2].ExpectedHooks[3].State := E_State.Starting;
FSteps[2].ExpectedHooks[3].Enabled := FALSE;
FSteps[2].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[2].ExpectedHooks[4].State := E_State.Starting;
FSteps[2].ExpectedHooks[4].Enabled := FALSE;
FSteps[2].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[2].ExpectedHooks[5].State := E_State.Starting;
FSteps[2].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "03 - Enter first Preparation state"}
// Enter Preparing without evaluating Assertions; the target has not been reached.
FSteps[3].ExpectedState := E_State.Preparing;
FSteps[3].ExpectedResult := E_Result.NotEvaluated;
FSteps[3].ExpectedReady := FALSE;
FSteps[3].ExpectedPassedCount := 0;
FSteps[3].ExpectedFailedCount := 0;
FSteps[3].ExpectedHookCount := 5;
FSteps[3].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[3].ExpectedHooks[1].State := E_State.Preparing;
FSteps[3].ExpectedHooks[1].Enabled := FALSE;
FSteps[3].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[3].ExpectedHooks[2].State := E_State.Preparing;
FSteps[3].ExpectedHooks[2].Enabled := TRUE;
FSteps[3].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[3].ExpectedHooks[3].State := E_State.Preparing;
FSteps[3].ExpectedHooks[3].Enabled := FALSE;
FSteps[3].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[3].ExpectedHooks[4].State := E_State.Preparing;
FSteps[3].ExpectedHooks[4].Enabled := FALSE;
FSteps[3].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[3].ExpectedHooks[5].State := E_State.Preparing;
FSteps[3].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "04 - Advance Preparation state"}
// Advance within Preparation; the entry trace records the old state, later hooks see the second
// state.
FSteps[4].AdvancePreparation := TRUE;
FSteps[4].ExpectedState := SecondPreparationState;
FSteps[4].ExpectedResult := E_Result.NotEvaluated;
FSteps[4].ExpectedReady := FALSE;
FSteps[4].ExpectedPassedCount := 0;
FSteps[4].ExpectedFailedCount := 0;
FSteps[4].ExpectedHookCount := 5;
FSteps[4].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[4].ExpectedHooks[1].State := E_State.Preparing;
FSteps[4].ExpectedHooks[1].Enabled := FALSE;
FSteps[4].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[4].ExpectedHooks[2].State := E_State.Preparing;
FSteps[4].ExpectedHooks[2].Enabled := TRUE;
FSteps[4].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[4].ExpectedHooks[3].State := SecondPreparationState;
FSteps[4].ExpectedHooks[3].Enabled := FALSE;
FSteps[4].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[4].ExpectedHooks[4].State := SecondPreparationState;
FSteps[4].ExpectedHooks[4].Enabled := FALSE;
FSteps[4].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[4].ExpectedHooks[5].State := SecondPreparationState;
FSteps[4].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "05 - Complete Preparation within the call"}
// Complete the reached Preparation explicitly inside its hook.
// ProcessTests and Assertions must observe Running and be enabled in this same call.
FSteps[5].FinishPreparations := TRUE;
FSteps[5].PreparationTargetReached := TRUE;
FSteps[5].ExpectedState := E_State.Running;
FSteps[5].ExpectedResult := E_Result.NotEvaluated;
FSteps[5].ExpectedReady := FALSE;
FSteps[5].ExpectedPassedCount := 2;
FSteps[5].ExpectedFailedCount := 0;
FSteps[5].ExpectedHookCount := 5;
FSteps[5].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[5].ExpectedHooks[1].State := SecondPreparationState;
FSteps[5].ExpectedHooks[1].Enabled := FALSE;
FSteps[5].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[5].ExpectedHooks[2].State := SecondPreparationState;
FSteps[5].ExpectedHooks[2].Enabled := TRUE;
FSteps[5].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[5].ExpectedHooks[3].State := E_State.Running;
FSteps[5].ExpectedHooks[3].Enabled := TRUE;
FSteps[5].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[5].ExpectedHooks[4].State := E_State.Running;
FSteps[5].ExpectedHooks[4].Enabled := TRUE;
FSteps[5].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[5].ExpectedHooks[5].State := E_State.Running;
FSteps[5].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "06 - Advance Test state"}
// Advance inside ProcessTests; Assertions must already observe the second Test state.
FSteps[6].AdvanceTest := TRUE;
FSteps[6].ExpectedState := SecondTestState;
FSteps[6].ExpectedResult := E_Result.NotEvaluated;
FSteps[6].ExpectedReady := FALSE;
FSteps[6].ExpectedPassedCount := 2;
FSteps[6].ExpectedFailedCount := 0;
FSteps[6].ExpectedHookCount := 5;
FSteps[6].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[6].ExpectedHooks[1].State := E_State.Running;
FSteps[6].ExpectedHooks[1].Enabled := FALSE;
FSteps[6].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[6].ExpectedHooks[2].State := E_State.Running;
FSteps[6].ExpectedHooks[2].Enabled := FALSE;
FSteps[6].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[6].ExpectedHooks[3].State := E_State.Running;
FSteps[6].ExpectedHooks[3].Enabled := TRUE;
FSteps[6].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[6].ExpectedHooks[4].State := SecondTestState;
FSteps[6].ExpectedHooks[4].Enabled := TRUE;
FSteps[6].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[6].ExpectedHooks[5].State := SecondTestState;
FSteps[6].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "07 - Keep second Test state active"}
// Remain in the second Test state until the concrete implementation explicitly completes it.
FSteps[7].ExpectedState := SecondTestState;
FSteps[7].ExpectedResult := E_Result.NotEvaluated;
FSteps[7].ExpectedReady := FALSE;
FSteps[7].ExpectedPassedCount := 2;
FSteps[7].ExpectedFailedCount := 0;
FSteps[7].ExpectedHookCount := 5;
FSteps[7].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[7].ExpectedHooks[1].State := SecondTestState;
FSteps[7].ExpectedHooks[1].Enabled := FALSE;
FSteps[7].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[7].ExpectedHooks[2].State := SecondTestState;
FSteps[7].ExpectedHooks[2].Enabled := FALSE;
FSteps[7].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[7].ExpectedHooks[3].State := SecondTestState;
FSteps[7].ExpectedHooks[3].Enabled := TRUE;
FSteps[7].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[7].ExpectedHooks[4].State := SecondTestState;
FSteps[7].ExpectedHooks[4].Enabled := TRUE;
FSteps[7].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[7].ExpectedHooks[5].State := SecondTestState;
FSteps[7].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "08 - Complete inside test processing"}
// CompleteTests changes phase inside ProcessTests; subsequent Assertions must already be
// disabled.
FSteps[8].FinishTests := TRUE;
FSteps[8].ExpectedState := E_State.Completing;
FSteps[8].ExpectedResult := E_Result.Passed;
FSteps[8].ExpectedReady := FALSE;
FSteps[8].ExpectedPassedCount := 2;
FSteps[8].ExpectedFailedCount := 0;
FSteps[8].ExpectedHookCount := 5;
FSteps[8].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[8].ExpectedHooks[1].State := SecondTestState;
FSteps[8].ExpectedHooks[1].Enabled := FALSE;
FSteps[8].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[8].ExpectedHooks[2].State := SecondTestState;
FSteps[8].ExpectedHooks[2].Enabled := FALSE;
FSteps[8].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[8].ExpectedHooks[3].State := SecondTestState;
FSteps[8].ExpectedHooks[3].Enabled := TRUE;
FSteps[8].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[8].ExpectedHooks[4].State := E_State.Completing;
FSteps[8].ExpectedHooks[4].Enabled := FALSE;
FSteps[8].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[8].ExpectedHooks[5].State := E_State.Completing;
FSteps[8].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "09 - Observe terminal completion"}
// The following call reaches Completed; only aggregation remains in the recorded processing
// hooks.
FSteps[9].ExpectedState := E_State.Completed;
FSteps[9].ExpectedResult := E_Result.Passed;
FSteps[9].ExpectedReady := FALSE;
FSteps[9].ExpectedPassedCount := 2;
FSteps[9].ExpectedFailedCount := 0;
FSteps[9].ExpectedHookCount := 1;
FSteps[9].ExpectedHooks[1].Hook := E_LifecycleHook.Aggregate;
FSteps[9].ExpectedHooks[1].State := E_State.Completed;
FSteps[9].ExpectedHooks[1].Enabled := TRUE;
{endregion}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>