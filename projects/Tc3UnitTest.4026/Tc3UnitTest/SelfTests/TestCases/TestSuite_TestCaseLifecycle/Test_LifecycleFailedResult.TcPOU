<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_LifecycleFailedResult" Id="{f92a49bb-e1d7-495a-b0ee-ae813795c6e0}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>
Checks mixed Assertion aggregation, continued execution after Failed and explicit Failed finalization.
</summary>
*)
{endregion}
FUNCTION_BLOCK Test_LifecycleFailedResult EXTENDS TestCaseLifecycleTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{7088a95c-3693-4b5f-8f8f-6a579cadb932}" />
    <Method Name="ConfigureScenario" Id="{9dfa81e7-1c93-4d79-ac99-acec0aa6b6c9}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines an independent cycle trace including mixed Passed/Failed results.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FSubjectPreparationCount := 0;
FSubjectTestCount := 1;
FStepCount := 6;

{region "01 - Reset to Idle"}
// Establish Idle through the parent Reset request; both child results must be cleared.
FSteps[1].RequestReset := TRUE;
FSteps[1].ExpectedState := E_State.Idle;
FSteps[1].ExpectedResult := E_Result.NotEvaluated;
FSteps[1].ExpectedReady := TRUE;
FSteps[1].ExpectedPassedCount := 0;
FSteps[1].ExpectedFailedCount := 0;
FSteps[1].ExpectedHookCount := 6;
FSteps[1].ExpectedHooks[1].Hook := E_LifecycleHook.Reset;
FSteps[1].ExpectedHooks[1].State := E_State.Reset;
FSteps[1].ExpectedHooks[1].Enabled := TRUE;
FSteps[1].ExpectedHooks[2].Hook := E_LifecycleHook.Abort;
FSteps[1].ExpectedHooks[2].State := E_State.Idle;
FSteps[1].ExpectedHooks[2].Enabled := FALSE;
FSteps[1].ExpectedHooks[3].Hook := E_LifecycleHook.Preparations;
FSteps[1].ExpectedHooks[3].State := E_State.Idle;
FSteps[1].ExpectedHooks[3].Enabled := FALSE;
FSteps[1].ExpectedHooks[4].Hook := E_LifecycleHook.Tests;
FSteps[1].ExpectedHooks[4].State := E_State.Idle;
FSteps[1].ExpectedHooks[4].Enabled := FALSE;
FSteps[1].ExpectedHooks[5].Hook := E_LifecycleHook.Assertions;
FSteps[1].ExpectedHooks[5].State := E_State.Idle;
FSteps[1].ExpectedHooks[5].Enabled := FALSE;
FSteps[1].ExpectedHooks[6].Hook := E_LifecycleHook.Aggregate;
FSteps[1].ExpectedHooks[6].State := E_State.Idle;
FSteps[1].ExpectedHooks[6].Enabled := TRUE;
{endregion}

{region "02 - Accept Start"}
// Accept Start into Starting; processing and Assertion evaluation are not active yet.
FSteps[2].RequestStart := TRUE;
FSteps[2].ExpectedState := E_State.Starting;
FSteps[2].ExpectedResult := E_Result.NotEvaluated;
FSteps[2].ExpectedReady := FALSE;
FSteps[2].ExpectedPassedCount := 0;
FSteps[2].ExpectedFailedCount := 0;
FSteps[2].ExpectedHookCount := 5;
FSteps[2].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[2].ExpectedHooks[1].State := E_State.Starting;
FSteps[2].ExpectedHooks[1].Enabled := FALSE;
FSteps[2].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[2].ExpectedHooks[2].State := E_State.Starting;
FSteps[2].ExpectedHooks[2].Enabled := FALSE;
FSteps[2].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[2].ExpectedHooks[3].State := E_State.Starting;
FSteps[2].ExpectedHooks[3].Enabled := FALSE;
FSteps[2].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[2].ExpectedHooks[4].State := E_State.Starting;
FSteps[2].ExpectedHooks[4].Enabled := FALSE;
FSteps[2].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[2].ExpectedHooks[5].State := E_State.Starting;
FSteps[2].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "03 - Generate one child failure"}
// Make Condition fail while ReferenceCondition passes; counters expose both outcomes during
// Running.
FSteps[3].AssertionCondition := FALSE;
FSteps[3].ExpectedState := E_State.Running;
FSteps[3].ExpectedResult := E_Result.NotEvaluated;
FSteps[3].ExpectedReady := FALSE;
FSteps[3].ExpectedPassedCount := 1;
FSteps[3].ExpectedFailedCount := 1;
FSteps[3].ExpectedHookCount := 5;
FSteps[3].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[3].ExpectedHooks[1].State := E_State.Running;
FSteps[3].ExpectedHooks[1].Enabled := FALSE;
FSteps[3].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[3].ExpectedHooks[2].State := E_State.Running;
FSteps[3].ExpectedHooks[2].Enabled := FALSE;
FSteps[3].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[3].ExpectedHooks[3].State := E_State.Running;
FSteps[3].ExpectedHooks[3].Enabled := TRUE;
FSteps[3].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[3].ExpectedHooks[4].State := E_State.Running;
FSteps[3].ExpectedHooks[4].Enabled := TRUE;
FSteps[3].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[3].ExpectedHooks[5].State := E_State.Running;
FSteps[3].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "04 - Preserve latched failure"}
// Restore Condition input to TRUE; the already latched Failed result must not recover without
// Reset.
FSteps[4].ExpectedState := E_State.Running;
FSteps[4].ExpectedResult := E_Result.NotEvaluated;
FSteps[4].ExpectedReady := FALSE;
FSteps[4].ExpectedPassedCount := 1;
FSteps[4].ExpectedFailedCount := 1;
FSteps[4].ExpectedHookCount := 5;
FSteps[4].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[4].ExpectedHooks[1].State := E_State.Running;
FSteps[4].ExpectedHooks[1].Enabled := FALSE;
FSteps[4].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[4].ExpectedHooks[2].State := E_State.Running;
FSteps[4].ExpectedHooks[2].Enabled := FALSE;
FSteps[4].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[4].ExpectedHooks[3].State := E_State.Running;
FSteps[4].ExpectedHooks[3].Enabled := TRUE;
FSteps[4].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[4].ExpectedHooks[4].State := E_State.Running;
FSteps[4].ExpectedHooks[4].Enabled := TRUE;
FSteps[4].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[4].ExpectedHooks[5].State := E_State.Running;
FSteps[4].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "05 - Finalize with Failed"}
// Complete execution; the held child failure must now become the Test Case's Failed result.
FSteps[5].FinishTests := TRUE;
FSteps[5].ExpectedState := E_State.Completing;
FSteps[5].ExpectedResult := E_Result.Failed;
FSteps[5].ExpectedReady := FALSE;
FSteps[5].ExpectedPassedCount := 1;
FSteps[5].ExpectedFailedCount := 1;
FSteps[5].ExpectedHookCount := 5;
FSteps[5].ExpectedHooks[1].Hook := E_LifecycleHook.Abort;
FSteps[5].ExpectedHooks[1].State := E_State.Running;
FSteps[5].ExpectedHooks[1].Enabled := FALSE;
FSteps[5].ExpectedHooks[2].Hook := E_LifecycleHook.Preparations;
FSteps[5].ExpectedHooks[2].State := E_State.Running;
FSteps[5].ExpectedHooks[2].Enabled := FALSE;
FSteps[5].ExpectedHooks[3].Hook := E_LifecycleHook.Tests;
FSteps[5].ExpectedHooks[3].State := E_State.Running;
FSteps[5].ExpectedHooks[3].Enabled := TRUE;
FSteps[5].ExpectedHooks[4].Hook := E_LifecycleHook.Assertions;
FSteps[5].ExpectedHooks[4].State := E_State.Completing;
FSteps[5].ExpectedHooks[4].Enabled := FALSE;
FSteps[5].ExpectedHooks[5].Hook := E_LifecycleHook.Aggregate;
FSteps[5].ExpectedHooks[5].State := E_State.Completing;
FSteps[5].ExpectedHooks[5].Enabled := TRUE;
{endregion}

{region "06 - Observe terminal completion"}
// The following call reaches Completed; only aggregation remains in the recorded processing
// hooks.
FSteps[6].ExpectedState := E_State.Completed;
FSteps[6].ExpectedResult := E_Result.Failed;
FSteps[6].ExpectedReady := FALSE;
FSteps[6].ExpectedPassedCount := 1;
FSteps[6].ExpectedFailedCount := 1;
FSteps[6].ExpectedHookCount := 1;
FSteps[6].ExpectedHooks[1].Hook := E_LifecycleHook.Aggregate;
FSteps[6].ExpectedHooks[1].State := E_State.Completed;
FSteps[6].ExpectedHooks[1].Enabled := TRUE;
{endregion}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>