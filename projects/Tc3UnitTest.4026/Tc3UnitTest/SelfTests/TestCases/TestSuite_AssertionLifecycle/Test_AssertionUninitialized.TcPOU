<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_AssertionUninitialized" Id="{cbed452e-8753-4a6e-80ed-b31ce7832d0c}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks that both Assertion bases remain passive before Initialize.</summary>
<description>
Neither subject is initialized. Calls request observation and evaluation deliberately.
The same uninitialized instances are reused after outer Reset, without rewriting
production state. Instrumentation is cleared separately from the inherited state.
</description>
*)
{endregion}
FUNCTION_BLOCK Test_AssertionUninitialized EXTENDS TestCaseBase
VAR
    FDirect : AssertionLifecycleSubject;
    FExplicit : AssertionEvaluationSubject;
    FCapture : EventBuffer;
    FEvents : ARRAY[1..CaptureLength] OF ST_Event;
    FCaptureFifo : ST_FifoStatus;
    FCaptureStatus : ST_EventBufferStatus;
    FCallCount : UINT;
    FObservationReady : BOOL;
    FChecked : BOOL;
END_VAR
VAR
    FPassiveState : AssertTrue;
    FPassiveStateMatches : BOOL;
    FNoHooks : AssertTrue;
    FNoHooksMatches : BOOL;
    FNoFindings : AssertTrue;
    FNoFindingsMatches : BOOL;
END_VAR
VAR CONSTANT
    CaptureLength : UINT := 8;
    ObservationCalls : UINT := 2;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{2e2e9dd2-f5fa-41c9-86fd-c8656686492a}" />
    <Method Name="AggregateResults" Id="{4fc256a5-9844-4e8a-805d-a33baba0f00c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Collects only outer checking Assertions, never intentional subject findings.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FPassiveState);
Aggregator.AddProvider(Provider := FNoHooks);
Aggregator.AddProvider(Provider := FNoFindings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{4a4d9aa7-3726-4115-95a6-b1b0ca22be9e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Configures checking Assertions; subject actions remain in the test script.</summary>
*)
{endregion}
METHOD PROTECTED Configure]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FPassiveState.Initialize(Parent := THIS^,
    AssertionName := 'PassiveState');
FNoHooks.Initialize(Parent := THIS^,
    AssertionName := 'NoHooks');
FNoFindings.Initialize(Parent := THIS^,
    AssertionName := 'NoFindings');
FDirect.BindPublisher(Publisher := FCapture);
FExplicit.BindPublisher(Publisher := FCapture);]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{4c21d9c0-6502-49e7-8ad4-39258c26f842}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes abort without asynchronous resources.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{92668efb-25c6-48ac-93ce-6688e75963c3}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Latches checked observations before the next script step may proceed.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR
VAR
    Evaluate : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Evaluate := Enable AND FObservationReady;
FPassiveState(Enable := Evaluate,
    State := State,
    IN := FPassiveStateMatches);
FNoHooks(Enable := Evaluate,
    State := State,
    IN := FNoHooksMatches);
FNoFindings(Enable := Evaluate,
    State := State,
    IN := FNoFindingsMatches);
IF Evaluate THEN
    FChecked := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{5c56ff09-55b5-42b5-8c0a-bb5d0f0f4eaa}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation phase is required.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required hook; this test has no Preparation phase.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{0a3d3ebc-5ac8-4d4c-8aec-b797fee52b6c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Restarts the script and resets the checking Assertions.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FCallCount := 0;
FChecked := FALSE;
FObservationReady := FALSE;
FDirect.ClearTrace();
FExplicit.ClearTrace();
FPassiveState.Reset();
FPassiveStateMatches := TRUE;
FNoHooks.Reset();
FNoHooksMatches := TRUE;
FNoFindings.Reset();
FNoFindingsMatches := TRUE;
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{79f71520-03a9-41b6-b13f-32af7846a8aa}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Advances one bounded script step per active PLC cycle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;
IF FChecked THEN
    FChecked := FALSE;
    FObservationReady := FALSE;
    IF FCallCount = ObservationCalls THEN
        CompleteTests();
        RETURN;
    END_IF;
END_IF;
IF FCallCount = 0 THEN
    IF NOT FCapture.Initialize(Buffer := FEvents,
        FifoControl := FCaptureFifo,
        Status := FCaptureStatus) THEN
        Error(Message := 'Uninitialized Assertion capture setup failed.');
        RETURN;
    END_IF;
END_IF;
FDirect(Enable := TRUE,
    State := E_State.Running);
FExplicit(Enable := TRUE,
    Evaluate := TRUE,
    State := E_State.Running);
FCallCount := FCallCount + 1;
FPassiveStateMatches := NOT FDirect.IsInitialized AND NOT FExplicit.IsInitialized
    AND FDirect.Enabled AND FExplicit.Enabled
    AND NOT FDirect.ObservationActive AND NOT FExplicit.ObservationActive
    AND NOT FDirect.EvaluationActive AND NOT FExplicit.EvaluationActive
    AND (FDirect.Result = E_Result.NotEvaluated) AND (FExplicit.Result = E_Result.NotEvaluated);
FNoHooksMatches := (FDirect.AssertCallCount = 0) AND (FExplicit.AssertCallCount = 0)
    AND (FDirect.ResetCallCount = 0) AND (FExplicit.ResetCallCount = 0);
FNoFindingsMatches := (FCaptureStatus.SequenceId = 0) AND (FCaptureStatus.LostEventCount = 0);
FObservationReady := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>