<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="AssertionEvaluationSubject" Id="{f5c21723-db49-433e-b07f-6ff49235469c}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Exposes calls and activity gates of AssertionWithEvaluationBase without replacing its processing.</summary>
<description>
Bind the local publisher before Initialize. The inherited body owns initialization,
reset priority and activity history. Assert records both gates and a bounded sample;
active evaluation dispatches the selected inherited finding method without a result guard.
This deliberately exercises base-owned suppression. Counters are cumulative until ClearTrace.
ResetAssertion clears the sample and records the input available on the reset call.
The outer test owns expectations; this subject does not compute expected gates.
</description>
*)
{endregion}
FUNCTION_BLOCK AssertionEvaluationSubject EXTENDS AssertionWithEvaluationBase
VAR_INPUT
    Sample : UINT := 0; //! Controlled sample captured only while observation is active.
    Finding : E_Result := E_Result.Passed; //! Passed, Failed or Error finding dispatched only while evaluation is active.
    FindingMessage : STRING(GVL_Constants.MessageLength) := 'Controlled finding.'; //! Diagnostic text supplied to the selected Fail or Error operation.
END_VAR
VAR_OUTPUT
    AssertCallCount : UINT; //! Cumulative Assert-hook invocations since ClearTrace.
    ResetCallCount : UINT; //! Cumulative ResetAssertion-hook invocations since ClearTrace.
    ObservationCount : UINT; //! Cumulative Assert calls with the observation gate active since ClearTrace.
    EvaluationCount : UINT; //! Cumulative Assert calls with the evaluation gate active since ClearTrace.
    ObservedSample : UINT; //! Last Sample accepted while observation was active; ResetAssertion clears it.
    ResetSample : UINT; //! Sample present at the latest ResetAssertion call.
    ObservationDuringAssert : BOOL; //! Observation gate recorded on the latest Assert-hook entry.
    EvaluationDuringAssert : BOOL; //! Evaluation gate recorded on the latest Assert-hook entry.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{5c6ec34c-dcae-4631-a48f-daee49a0e593}" />
    <Method Name="Assert" Id="{a4d3fe46-f830-4547-a17b-b3d3a55fea9a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Records inherited gates and evaluates only when permitted.</summary>
*)
{endregion}
METHOD PROTECTED Assert]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssertCallCount := AssertCallCount + 1;
ObservationDuringAssert := ObservationActive;
EvaluationDuringAssert := EvaluationActive;
IF ObservationDuringAssert THEN
    ObservationCount := ObservationCount + 1;
    ObservedSample := Sample;
END_IF;
IF EvaluationDuringAssert THEN
    EvaluationCount := EvaluationCount + 1;
    CASE Finding OF
        E_Result.Passed:
            Pass();
        E_Result.Failed:
            Fail(Message := FindingMessage);
        E_Result.Error:
            Error(Message := FindingMessage);
    ELSE
        RETURN;
    END_CASE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ClearTrace" Id="{f5ebd546-a01d-40de-a738-f8ba7cd6b329}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clears only test instrumentation; never changes inherited Assertion state.</summary>
*)
{endregion}
METHOD PUBLIC ClearTrace]]></Declaration>
      <Implementation>
        <ST><![CDATA[AssertCallCount := 0;
ResetCallCount := 0;
ObservationCount := 0;
EvaluationCount := 0;
ObservedSample := 0;
ResetSample := 0;
ObservationDuringAssert := FALSE;
EvaluationDuringAssert := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetAssertion" Id="{c7429325-43cf-4537-b001-1af6348af9ab}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Records one reset with bound inputs and clears the observation sample.</summary>
*)
{endregion}
METHOD PROTECTED ResetAssertion]]></Declaration>
      <Implementation>
        <ST><![CDATA[ResetCallCount := ResetCallCount + 1;
ResetSample := Sample;
ObservedSample := 0;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>