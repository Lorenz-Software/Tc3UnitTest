<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SuiteOrchestratorDouble" Id="{55b7b544-5c0e-41b4-9a1c-3c3d7a542c1a}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Controlled I_Orchestrator boundary for Suite owner tests, without a scheduler.</summary>
<description>
Initialize records identity, collection bounds and child identities while the owner is still
initializing. Execute records task assignment and pre-child-call states. SetObservation supplies deliberate
responses between owner cycles; no child requests, reservations or state machine are copied.
The test supplies coherent child observations separately through the concrete Suite adapter.
</description>
*)
{endregion}
FUNCTION_BLOCK SuiteOrchestratorDouble IMPLEMENTS I_Orchestrator
VAR
    FAcceptInitialization : BOOL := TRUE;
    FInitialized : BOOL;
    FInitializeCount : UINT;
    FExecuteCount : UINT;
    FFirstChildStateAtExecute : E_State;
    FLastChildStateAtExecute : E_State;
    FCurrentTask : E_OrchestratorTask;
    FCollection : I_OrchestratableCollection;
    FName : STRING(GVL_Constants.NameLength);
    FResourceName : STRING(GVL_Constants.ResourceNameLength);
    FFirstIndex : DINT;
    FLastIndex : DINT;
    FChildCount : UINT;
    FFirstChild : I_Orchestratable;
    FLastChild : I_Orchestratable;
    FReady : BOOL;
    FResult : E_Result;
    FResetFinished : BOOL;
    FAbortFinished : BOOL;
    FExecutionFinished : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{4c1a09d9-e984-4d97-a5a1-3f6de02e8ccf}" />
    <Method Name="BeginScenario" Id="{aef1639a-7b7c-4fe7-81cb-1f222d311e18}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clears observations before owner initialization and selects only the initialization outcome.</summary>
*)
{endregion}
METHOD PUBLIC BeginScenario
VAR_INPUT
    AcceptInitialization : BOOL := TRUE; //! Scripted acceptance returned by subsequent Initialize calls.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FAcceptInitialization := AcceptInitialization;
FInitialized := FALSE;
FInitializeCount := 0;
FExecuteCount := 0;
FFirstChildStateAtExecute := E_State.Uninitialized;
FLastChildStateAtExecute := E_State.Uninitialized;
FCurrentTask := E_OrchestratorTask.Idle;
FCollection := 0;
FName := '';
FResourceName := '';
FFirstIndex := 0;
FLastIndex := 0;
FChildCount := 0;
FFirstChild := 0;
FLastChild := 0;
SetObservation(Ready := FALSE);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ChildCount" Id="{bae0f3d4-9656-453d-ae93-7c4b0f855be1}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Population observed synchronously inside Initialize.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC ChildCount : UINT //! Population observed synchronously inside Initialize.]]></Declaration>
      <Get Name="Get" Id="{3a0f0ff9-0622-4076-9895-54586d44fc0a}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ChildCount := FChildCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="Collection" Id="{5938fd68-0b28-41f2-96fe-cd3b1f3fcce7}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>The exact collection interface supplied by the owner.</summary>
*)
{endregion}
{attribute 'monitoring' := 'variable'}
PROPERTY PUBLIC Collection : I_OrchestratableCollection //! The exact collection interface supplied by the owner.]]></Declaration>
      <Get Name="Get" Id="{269283e5-a782-4a06-a420-2672cf24ec3d}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[Collection := FCollection;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="CurrentTask" Id="{bdaac40f-a4bc-4c17-a1f6-17bb128dcb7e}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Last task supplied by the owner.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC CurrentTask : E_OrchestratorTask //! Last task supplied by the owner.]]></Declaration>
      <Get Name="Get" Id="{5f5ab9b6-1685-4717-8710-700b2879cc0b}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[CurrentTask := FCurrentTask;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Execute" Id="{57263bee-e8bf-4efc-b2af-97e29b65daf1}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Records the owner task and current child states; no observations are changed or child commands sent.</summary>
*)
{endregion}
METHOD PUBLIC Execute
VAR_INPUT
    Task : E_OrchestratorTask; //! Owner-assigned task to record; this double does not execute or request children.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FCurrentTask := Task;
FExecuteCount := FExecuteCount + 1;
IF FFirstChild <> 0 THEN
    FFirstChildStateAtExecute := FFirstChild.State;
END_IF;
IF FLastChild <> 0 THEN
    FLastChildStateAtExecute := FLastChild.State;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Property Name="ExecuteCount" Id="{4a647fd0-3c53-4b05-acf2-fe263aabd681}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Number of cyclic helper calls.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC ExecuteCount : UINT //! Number of cyclic helper calls.]]></Declaration>
      <Get Name="Get" Id="{65e0475d-70ad-471b-bf36-f46ab855ffde}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[ExecuteCount := FExecuteCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FirstChild" Id="{10eed8a1-b409-4362-8a15-8deb57cf5c41}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>First occupied interface observed inside Initialize.</summary>
*)
{endregion}
{attribute 'monitoring' := 'variable'}
PROPERTY PUBLIC FirstChild : I_Orchestratable //! First occupied interface observed inside Initialize.]]></Declaration>
      <Get Name="Get" Id="{97030e9e-872c-4b94-be8c-b2474f7f4e73}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FirstChild := FFirstChild;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FirstChildStateAtExecute" Id="{053a285a-f919-468d-8fbe-5b8dbbeba05e}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>First child state observed by the helper before concrete child calls.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC FirstChildStateAtExecute : E_State //! First child state observed by the helper before concrete child calls.]]></Declaration>
      <Get Name="Get" Id="{eeb2ba4e-cf95-44bc-ab58-813f3ec6e8ca}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FirstChildStateAtExecute := FFirstChildStateAtExecute;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FirstIndex" Id="{c1e2a98e-eabe-4f9a-b5b4-69b12cf27f83}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Lower bound observed synchronously inside Initialize.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC FirstIndex : DINT //! Lower bound observed synchronously inside Initialize.]]></Declaration>
      <Get Name="Get" Id="{f923fced-27d9-407a-88d9-d3169ae2cbf0}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[FirstIndex := FFirstIndex;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Initialize" Id="{ae1adbac-4d4b-4a86-b04b-5528b94496f3}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Records and immediately queries the collection handed over by the owner; never executes children.</summary>
*)
{endregion}
METHOD PUBLIC Initialize : BOOL //! Scripted initialization acceptance; the supplied collection is queried regardless of that response.
VAR_INPUT
    Collection : I_OrchestratableCollection; //! Nonzero borrowed collection queried immediately and retained; keep the collection and children alive.
    Name : STRING(GVL_Constants.NameLength); //! Owner diagnostic name retained by the double.
    ResourceName : STRING(GVL_Constants.ResourceNameLength) := ''; //! Owner diagnostic resource retained by the double.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FInitializeCount := FInitializeCount + 1;
FCollection := Collection;
FName := Name;
FResourceName := ResourceName;
FFirstIndex := Collection.ChildArrayLowerBound;
FLastIndex := Collection.ChildArrayUpperBound;
FChildCount := Collection.ChildCount;
IF FChildCount > 0 THEN
    FFirstChild := Collection.GetChild(Index := FFirstIndex);
    FLastChild := Collection.GetChild(Index := FFirstIndex + UINT_TO_DINT(FChildCount) - 1);
END_IF;
FInitialized := FAcceptInitialization;
Initialize := FInitialized;]]></ST>
      </Implementation>
    </Method>
    <Property Name="InitializeCount" Id="{ef016cc3-4acb-48ae-bffa-bb8adef5af2e}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Number of owner initialization calls.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC InitializeCount : UINT //! Number of owner initialization calls.]]></Declaration>
      <Get Name="Get" Id="{a3539587-b914-47ce-8ee2-7952f2e54c7e}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[InitializeCount := FInitializeCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsAbortFinished" Id="{ee43daa6-a119-4efd-b566-37639efa8cb1}">
