    <Method Name="SetObservation" Id="{63041564-ffdf-4eb0-ae93-a472c89d4a4a}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Supplies the interface response for the next owner call; defaults describe unfinished neutral work.</summary>
*)
{endregion}
METHOD PUBLIC SetObservation
VAR_INPUT
    Ready : BOOL; //! Scripted readiness returned to the owner.
    Result : E_Result := E_Result.NotEvaluated; //! Scripted helper technical result returned to the owner.
    ResetFinished : BOOL := FALSE; //! Scripted Reset-completion signal returned to the owner.
    AbortFinished : BOOL := FALSE; //! Scripted Abort-completion signal returned to the owner.
    ExecutionFinished : BOOL := FALSE; //! Scripted execution-completion signal returned to the owner.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FReady := Ready;
FResult := Result;
FResetFinished := ResetFinished;
FAbortFinished := AbortFinished;
FExecutionFinished := ExecutionFinished;]]></ST>
      </Implementation>
    </Method>
  </POU>
