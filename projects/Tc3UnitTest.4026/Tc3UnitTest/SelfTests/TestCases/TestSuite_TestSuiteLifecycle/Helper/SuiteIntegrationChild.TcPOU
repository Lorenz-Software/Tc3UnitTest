<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="SuiteIntegrationChild" Id="{78430555-dbd3-4dac-abab-caef5c1c7fe6}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Exercises the successful framework lifecycle with one Boolean Assertion.</summary>
*)
{endregion}
FUNCTION_BLOCK SuiteIntegrationChild EXTENDS TestCaseBase
VAR
    FSuccess : AssertTrue;
    FBodyCallCount : UDINT;
    FActual : BOOL;
    FCheckPerformed : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[FBodyCallCount := FBodyCallCount + 1;
SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{5806d9ba-7bd8-4efd-8fe5-c8e3b919581b}" />
    <Method Name="AggregateResults" Id="{d534243b-6522-4452-b46c-49007135009e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Contributes the one Assertion without executing or resetting it.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FSuccess);]]></ST>
      </Implementation>
    </Method>
    <Method Name="BindPublisher" Id="{d8d223bd-5d5c-4d35-bbdb-bcd69672bf96}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Binds this real Test Case and its Assertion to the isolated capture before initialization.</summary>
*)
{endregion}
METHOD PUBLIC BindPublisher
VAR_INPUT
    Publisher : I_EventPublisher; //! Nonzero isolated event publisher retained before subject initialization; keep it alive through all subject use.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEventPublisher := Publisher;
FSuccess.BindPublisher(Publisher := Publisher);
FBodyCallCount := 0;]]></ST>
      </Implementation>
    </Method>
    <Property Name="BodyCallCount" Id="{97135034-a1d6-4d30-ba56-ef15f0478040}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Counts concrete FB calls since binding, including disabled lifecycle phases.</summary>
*)
{endregion}
{attribute 'monitoring' := 'call'}
PROPERTY PUBLIC BodyCallCount : UDINT //! Counts concrete FB calls since binding, including disabled lifecycle phases.]]></Declaration>
      <Get Name="Get" Id="{c5d39972-3ec8-49a2-b003-bc3da07067f8}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[BodyCallCount := FBodyCallCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CheckInitialization" Id="{0a7f011b-8272-409f-9348-20822d43e7b9}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Includes the owned Assertion in the base initialization checks.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := FALSE;
IF NOT SUPER^.CheckInitialization() THEN
    RETURN;
END_IF;
IF NOT FSuccess.IsInitialized THEN
    RETURN;
END_IF;

CheckInitialization := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{7b967760-e94d-48a8-afc2-6e2860f125fd}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes the minimal integration scenario and its single Assertion.</summary>
*)
{endregion}
METHOD PROTECTED Configure]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FActual := FALSE;
FCheckPerformed := FALSE;

FSuccess.Initialize(Parent := THIS^,
    AssertionName := 'Success');]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{adc27fdb-b6a6-4e0a-a001-f21e3377efaa}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes enabled aborts; the minimal integration scenario owns no resource actions.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{da60b010-3d42-4930-9b39-048b9645d8cf}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls the Assertion even while disabled and records an actual evaluation.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FSuccess(Enable := Enable,
    State := State,
    IN := FActual);

IF Enable AND FSuccess.EvaluationActive THEN
    FCheckPerformed := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{76e4dfe9-804a-4442-bbd5-7141d09ec4af}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation stage is configured for this minimal integration scenario.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required override signature; this scenario has no preparation work.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{c4548014-c0f7-492b-ac6d-dc840764e866}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clears scenario progress and requests Assertion reset before returning to Idle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FActual := FALSE;
FCheckPerformed := FALSE;
FSuccess.Reset();
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{755cc276-1f73-4426-b59e-46447e03ec77}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Supplies the success value, then completes on the call after evaluation.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FCheckPerformed THEN
    CompleteTests();
ELSE
    FActual := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>