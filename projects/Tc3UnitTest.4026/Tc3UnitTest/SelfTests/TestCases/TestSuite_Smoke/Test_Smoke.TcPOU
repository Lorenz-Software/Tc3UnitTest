<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_Smoke" Id="{6633ed41-c48b-4224-8f9a-2febcab38d3b}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Exercises the successful framework lifecycle with one Boolean Assertion.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_Smoke EXTENDS TestCaseBase
VAR
    FSuccess : AssertTrue;
    FActual : BOOL;
    FCheckPerformed : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{156a00c8-ab7e-4836-a688-939cc758bb4b}" />
    <Method Name="AggregateResults" Id="{c275a38e-0cfb-45ee-abc3-962772297b57}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Contributes the one Assertion without executing or resetting it.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FSuccess);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{976416e7-2702-4821-ac89-115b0dc518d6}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Includes the owned Assertion in the base initialization checks.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := FALSE;
IF NOT SUPER^.CheckInitialization() THEN
    RETURN;
END_IF;
IF NOT FSuccess.IsInitialized THEN
    RETURN;
END_IF;

CheckInitialization := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{7267a746-21e4-4ecc-a1a6-b68465434c37}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes the smoke scenario and its single Assertion.</summary>
*)
{endregion}
METHOD PROTECTED Configure]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FActual := FALSE;
FCheckPerformed := FALSE;

FSuccess.Initialize(Parent := THIS^,
    AssertionName := 'Success');]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{521cadb0-5ff2-4445-ac67-fe428e024b2c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes enabled aborts; the smoke scenario owns no resource actions.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{87d387c9-192e-4ba9-a86e-0e47846a6535}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls the Assertion even while disabled and records an actual evaluation.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FSuccess(Enable := Enable,
    State := State,
    IN := FActual);

IF Enable AND FSuccess.EvaluationActive THEN
    FCheckPerformed := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{f50a1e3e-b2c8-41d9-bbf4-c3a268702dfb}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation stage is configured for this smoke scenario.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required override signature; this scenario has no preparation work.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{73ce86ff-a179-440a-866e-a2451251d92a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Clears scenario progress and requests Assertion reset before returning to Idle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FActual := FALSE;
FCheckPerformed := FALSE;
FSuccess.Reset();
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{b23690d0-5f38-4517-bfc6-87c0bdc88916}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Supplies the success value, then completes on the call after evaluation.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FCheckPerformed THEN
    CompleteTests();
ELSE
    FActual := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>