  <POU Name="Test_SerialUnequalDurations" Id="{a52ee18e-16a0-4271-8320-0f04a32f04ef}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks long, immediate and shorter children; Completing is not terminal completion.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_SerialUnequalDurations EXTENDS OrchestrationTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{4d5a7881-dae9-4e40-a5e2-2dde7fa83510}" />
    <Method Name="ConfigureScenario" Id="{2a2f435d-eb02-41e5-a42d-0269b647288f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines this scenario independently of the subject's internal fields.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FArrayLayout := E_OrchestrationArrayLayout.Ordinary;
FChildCount := 3;
FStepCount := 15;

{region "Cycle 01 - Idle readiness"}
FSteps[1].Task := E_OrchestratorTask.Idle;
