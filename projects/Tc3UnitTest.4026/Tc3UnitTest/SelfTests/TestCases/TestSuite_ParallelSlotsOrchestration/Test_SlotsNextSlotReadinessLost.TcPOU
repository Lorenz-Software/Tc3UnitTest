<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_SlotsNextSlotReadinessLost" Id="{ff4da84b-6f5c-4cf2-852b-a9e4c73fc136}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Prevents dispatch when the next slot loses readiness after initially valid admission.</summary>
<description>
All children are initially ready. While slot 1 completes, child 3 loses its readiness.
Selecting slot 2 must not dispatch it; the next check reports the readiness failure.
Later readiness recovery must not clear the held Error or trigger a Start.
</description>
*)
{endregion}
FUNCTION_BLOCK Test_SlotsNextSlotReadinessLost EXTENDS OrchestrationTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{adcb4610-53ab-4cfa-8e99-000000000005}" />
    <Method Name="ConfigureScenario" Id="{adcb4620-53ab-4cfa-8e99-000000000005}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines boundary stimuli and expected child requests, reservation cleanup and isolated diagnostics.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FChildSlots[1] := 1;
FChildSlots[2] := 1;
FChildSlots[3] := 2;
FStepCount := 7;

{region "01 - Observe all children initially ready"}
FSteps[1].Task := E_OrchestratorTask.Idle;
FSteps[1].ExpectedReady := TRUE;
FSteps[1].MaxActiveChildCount := 0;
{endregion}

{region "02 - Start child 1 in slot 1"}
FSteps[2].Children[1].State := E_State.Running;
FSteps[2].Children[1].Ready := FALSE;
FSteps[2].ExpectedStartChild := 1;
FSteps[2].ExpectedSlot := 1;
FSteps[2].ExpectedReservations[1] := 1;
FSteps[2].MaxActiveChildCount := 1;
{endregion}

{region "03 - Start child 2 and complete slot 1 while child 3 loses readiness"}
FSteps[3].Children[1].State := E_State.Completed;
FSteps[3].Children[1].Ready := FALSE;
FSteps[3].Children[1].Complete := TRUE;
FSteps[3].Children[1].Result := E_Result.Passed;
FSteps[3].Children[2].State := E_State.Completed;
FSteps[3].Children[2].Ready := FALSE;
FSteps[3].Children[2].Complete := TRUE;
FSteps[3].Children[2].Result := E_Result.Passed;
FSteps[3].Children[3].Ready := FALSE;
FSteps[3].ExpectedStartChild := 2;
FSteps[3].ExpectedSlot := 1;
FSteps[3].ExpectedReservations[1] := 1;
FSteps[3].ExpectedReservations[2] := 1;
FSteps[3].MaxActiveChildCount := 2;
{endregion}

{region "04 - Release slot 1 and select slot 2 without dispatch"}
FSteps[4].Children[1].State := E_State.Completed;
FSteps[4].Children[1].Ready := FALSE;
FSteps[4].Children[1].Complete := TRUE;
FSteps[4].Children[1].Result := E_Result.Passed;
FSteps[4].Children[2].State := E_State.Completed;
FSteps[4].Children[2].Ready := FALSE;
FSteps[4].Children[2].Complete := TRUE;
FSteps[4].Children[2].Result := E_Result.Passed;
FSteps[4].Children[3].Ready := FALSE;
FSteps[4].ExpectedSlot := 2;
FSteps[4].ExpectedReleasedEntries[1] := 1;
FSteps[4].ExpectedReleasedEntries[2] := 1;
FSteps[4].MaxActiveChildCount := 0;
{endregion}

{region "05 - Reject the now unready next-slot child before Start"}
FSteps[5].Children[1].State := E_State.Completed;
FSteps[5].Children[1].Ready := FALSE;
FSteps[5].Children[1].Complete := TRUE;
FSteps[5].Children[1].Result := E_Result.Passed;
FSteps[5].Children[2].State := E_State.Completed;
FSteps[5].Children[2].Ready := FALSE;
FSteps[5].Children[2].Complete := TRUE;
FSteps[5].Children[2].Result := E_Result.Passed;
FSteps[5].Children[3].Ready := FALSE;
FSteps[5].ExpectedSlot := 2;
FSteps[5].ExpectedResult := E_Result.Error;
FSteps[5].ExpectedDiagnosticCount := 1;
FSteps[5].MaxActiveChildCount := 0;
{endregion}

{region "06 - Restore readiness without clearing the held Error"}
FSteps[6].Children[1].State := E_State.Completed;
FSteps[6].Children[1].Ready := FALSE;
FSteps[6].Children[1].Complete := TRUE;
FSteps[6].Children[1].Result := E_Result.Passed;
FSteps[6].Children[2].State := E_State.Completed;
FSteps[6].Children[2].Ready := FALSE;
FSteps[6].Children[2].Complete := TRUE;
FSteps[6].Children[2].Result := E_Result.Passed;
FSteps[6].ExpectedSlot := 2;
FSteps[6].ExpectedResult := E_Result.Error;
FSteps[6].ExpectedDiagnosticCount := 1;
FSteps[6].MaxActiveChildCount := 0;
{endregion}

{region "07 - Do not resume dispatch after readiness recovery"}
FSteps[7].Children[1].State := E_State.Completed;
FSteps[7].Children[1].Ready := FALSE;
FSteps[7].Children[1].Complete := TRUE;
FSteps[7].Children[1].Result := E_Result.Passed;
FSteps[7].Children[2].State := E_State.Completed;
FSteps[7].Children[2].Ready := FALSE;
FSteps[7].Children[2].Complete := TRUE;
FSteps[7].Children[2].Result := E_Result.Passed;
FSteps[7].ExpectedSlot := 2;
FSteps[7].ExpectedResult := E_Result.Error;
FSteps[7].ExpectedDiagnosticCount := 1;
FSteps[7].MaxActiveChildCount := 0;
{endregion}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>