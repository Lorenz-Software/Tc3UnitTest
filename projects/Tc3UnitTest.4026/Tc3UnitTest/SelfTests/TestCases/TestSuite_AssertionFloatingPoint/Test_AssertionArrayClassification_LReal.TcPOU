        FFindingHasNoNaN := E_Result.Error;
        FExpectedContainsInfinity := E_Result.Error;
        FFindingContainsInfinity := E_Result.Error;
        FExpectedHasNoInfinity := E_Result.Error;
        FFindingHasNoInfinity := E_Result.Error;
    RowStartAboveBounds:
