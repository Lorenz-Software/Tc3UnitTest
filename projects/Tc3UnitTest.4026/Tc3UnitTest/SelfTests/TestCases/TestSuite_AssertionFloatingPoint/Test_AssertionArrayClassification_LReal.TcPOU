    <Method Name="SelectRow" Id="{a6310004-0004-4000-8000-000000000009}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Supplies literal expectations; only named hold/escalation rows preserve subjects.</summary>
*)
{endregion}
METHOD PRIVATE SelectRow
