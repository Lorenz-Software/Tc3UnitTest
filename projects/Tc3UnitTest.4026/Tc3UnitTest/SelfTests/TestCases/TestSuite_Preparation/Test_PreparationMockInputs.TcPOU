<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_PreparationMockInputs" Id="{c177ecd8-c333-4bb7-94b8-e06c9734f07b}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks actual PreparationMock defaults, status priority, accepted Enable and replacement of stale flags.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_PreparationMockInputs EXTENDS TestCaseBase
VAR
    FSubject : PreparationMock;
    FDefaultSubject : PreparationMock;
    FObserved : ST_PreparationStatus;
    FExpected : ST_PreparationStatus;
    FObservedEnabled : BOOL;
    FExpectedEnabled : BOOL;
    FCheckPerformed : BOOL;
    FCheckDiagnosticState : AssertEqual_Int;
    FCheckExecutionStatus : AssertEqual_Int;
    FCheckReady : AssertEqual_Bool;
    FCheckRunning : AssertEqual_Bool;
    FCheckCompleted : AssertEqual_Bool;
    FCheckError : AssertEqual_Bool;
    FCheckEnabled : AssertEqual_Bool;
END_VAR
VAR CONSTANT
    DefaultInputs : E_State := E_State.Running;
    ErrorBeforeCompletion : E_State := E_State.Running + 1;
    EnabledNotReady : E_State := E_State.Running + 2;
    CompletedNotReady : E_State := E_State.Running + 3;
    ActiveWork : E_State := E_State.Running + 4;
    DisabledReady : E_State := E_State.Running + 5;
    DisabledNotReady : E_State := E_State.Running + 6;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{e5a9020f-3e33-4719-884c-d51185d01b86}" />
    <Method Name="AggregateResults" Id="{86e97303-fd2e-4a91-9cdb-02ad773fc5fc}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Contributes all owned Assertion results without executing the subjects.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FCheckDiagnosticState);
Aggregator.AddProvider(Provider := FCheckExecutionStatus);
Aggregator.AddProvider(Provider := FCheckReady);
Aggregator.AddProvider(Provider := FCheckRunning);
Aggregator.AddProvider(Provider := FCheckCompleted);
Aggregator.AddProvider(Provider := FCheckError);
Aggregator.AddProvider(Provider := FCheckEnabled);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{1665241b-4a37-4d5b-a594-5d30cdac2a71}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Requires valid base configuration and every owned Assertion.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := FALSE;
IF NOT SUPER^.CheckInitialization() THEN
    RETURN;
END_IF;
IF NOT FCheckDiagnosticState.IsInitialized
    OR NOT FCheckExecutionStatus.IsInitialized
    OR NOT FCheckReady.IsInitialized
    OR NOT FCheckRunning.IsInitialized
    OR NOT FCheckCompleted.IsInitialized
    OR NOT FCheckError.IsInitialized
    OR NOT FCheckEnabled.IsInitialized THEN
    RETURN;
END_IF;

CheckInitialization := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{40e79598-5021-4809-995e-e0b4cbce094e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Configures this scenario, its local subjects and named Assertions.</summary>
*)
{endregion}
METHOD PROTECTED Configure]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 7;
FCheckPerformed := FALSE;

FCheckDiagnosticState.Initialize(Parent := THIS^,
    AssertionName := 'DiagnosticState');
FCheckExecutionStatus.Initialize(Parent := THIS^,
    AssertionName := 'ExecutionStatus');
FCheckReady.Initialize(Parent := THIS^,
    AssertionName := 'Ready');
FCheckRunning.Initialize(Parent := THIS^,
    AssertionName := 'Running');
FCheckCompleted.Initialize(Parent := THIS^,
    AssertionName := 'Completed');
FCheckError.Initialize(Parent := THIS^,
    AssertionName := 'Error');
FCheckEnabled.Initialize(Parent := THIS^,
    AssertionName := 'Enabled');]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{1095e2ce-c12c-486a-8bba-c51b66926c7a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Ends scenario processing without issuing further resource commands.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{a4d5e8e4-2290-4e5e-a57c-b594fbff4ea8}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Compares independent expected values with the captured observations; called when disabled as well.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FCheckDiagnosticState(Enable := Enable,
    State := State,
    IN := TO_INT(FObserved.State),
    Expected := TO_INT(FExpected.State));

FCheckExecutionStatus(Enable := Enable,
    State := State,
    IN := TO_INT(FObserved.ExecutionStatus),
    Expected := TO_INT(FExpected.ExecutionStatus));

FCheckReady(Enable := Enable,
    State := State,
    IN := FObserved.Ready,
    Expected := FExpected.Ready);

FCheckRunning(Enable := Enable,
    State := State,
    IN := FObserved.Running,
    Expected := FExpected.Running);

FCheckCompleted(Enable := Enable,
    State := State,
    IN := FObserved.Completed,
    Expected := FExpected.Completed);

FCheckError(Enable := Enable,
    State := State,
    IN := FObserved.Error,
    Expected := FExpected.Error);

FCheckEnabled(Enable := Enable,
    State := State,
    IN := FObservedEnabled,
    Expected := FExpectedEnabled);

IF Enable
    AND FCheckDiagnosticState.EvaluationActive
    AND FCheckExecutionStatus.EvaluationActive
    AND FCheckReady.EvaluationActive
    AND FCheckRunning.EvaluationActive
    AND FCheckCompleted.EvaluationActive
    AND FCheckError.EvaluationActive
    AND FCheckEnabled.EvaluationActive THEN
    FCheckPerformed := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{ffc239d6-c3a7-4ee9-8c4f-0821317635c5}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Subjects are exercised by the test, not used as its start prerequisite.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required hook; this scenario has no Preparation phase.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{8d7cd145-0fb8-4f3c-937e-03d9c0f6cf4c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Restores repeatable fixture state and resets Assertions before returning to Idle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FCheckPerformed := FALSE;
FCheckDiagnosticState.Reset();
FCheckExecutionStatus.Reset();
FCheckReady.Reset();
FCheckRunning.Reset();
FCheckCompleted.Reset();
FCheckError.Reset();
FCheckEnabled.Reset();
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{e9bfa986-9954-47e7-810e-cca949698bee}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Exercises one named scenario step per call; advances only after actual Assertion evaluation.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FCheckPerformed THEN
    FCheckPerformed := FALSE;
    IF State = DisabledNotReady THEN
        CompleteTests();
        RETURN;
    END_IF;
    NextTestState();
    IF NOT IsTestingActive THEN
        RETURN;
    END_IF;
END_IF;

CASE State OF
    DefaultInputs:
        FDefaultSubject(Enable := FALSE);
        FObserved := FDefaultSubject.Status;
        FObservedEnabled := FDefaultSubject.Enabled;
        FExpected.State := E_State.Completed;
        FExpected.ExecutionStatus := E_ExecutionStatus.Completed;
        FExpected.Ready := TRUE;
        FExpected.Running := FALSE;
        FExpected.Completed := TRUE;
        FExpected.Error := FALSE;
        FExpectedEnabled := FALSE;

    ErrorBeforeCompletion:
        FSubject(Enable := TRUE,
            Ready := TRUE,
            Completed := TRUE,
            Error := TRUE);
        FObserved := FSubject.Status;
        FObservedEnabled := FSubject.Enabled;
        FExpected.State := E_State.Error;
        FExpected.ExecutionStatus := E_ExecutionStatus.Error;
        FExpected.Ready := TRUE;
        FExpected.Running := FALSE;
        FExpected.Completed := FALSE;
        FExpected.Error := TRUE;
        FExpectedEnabled := TRUE;

    EnabledNotReady:
        FSubject(Enable := TRUE,
            Ready := FALSE,
            Completed := FALSE,
            Error := FALSE);
        FObserved := FSubject.Status;
        FObservedEnabled := FSubject.Enabled;
        FExpected.State := E_State.Idle;
        FExpected.ExecutionStatus := E_ExecutionStatus.NotReady;
        FExpected.Ready := FALSE;
        FExpected.Running := FALSE;
        FExpected.Completed := FALSE;
        FExpected.Error := FALSE;
        FExpectedEnabled := TRUE;

    CompletedNotReady:
        FSubject(Enable := TRUE,
            Ready := FALSE,
            Completed := TRUE,
            Error := FALSE);
        FObserved := FSubject.Status;
        FObservedEnabled := FSubject.Enabled;
        FExpected.State := E_State.Completed;
        FExpected.ExecutionStatus := E_ExecutionStatus.Completed;
        FExpected.Ready := FALSE;
        FExpected.Running := FALSE;
        FExpected.Completed := TRUE;
        FExpected.Error := FALSE;
        FExpectedEnabled := TRUE;

    ActiveWork:
        FSubject(Enable := TRUE,
            Ready := TRUE,
            Completed := FALSE,
            Error := FALSE);
        FObserved := FSubject.Status;
        FObservedEnabled := FSubject.Enabled;
        FExpected.State := E_State.Running;
        FExpected.ExecutionStatus := E_ExecutionStatus.Running;
        FExpected.Ready := FALSE;
        FExpected.Running := TRUE;
        FExpected.Completed := FALSE;
        FExpected.Error := FALSE;
        FExpectedEnabled := TRUE;

    DisabledReady:
        FSubject(Enable := FALSE,
            Ready := TRUE,
            Completed := FALSE,
            Error := FALSE);
        FObserved := FSubject.Status;
        FObservedEnabled := FSubject.Enabled;
        FExpected.State := E_State.Idle;
        FExpected.ExecutionStatus := E_ExecutionStatus.Idle;
        FExpected.Ready := TRUE;
        FExpected.Running := FALSE;
        FExpected.Completed := FALSE;
        FExpected.Error := FALSE;
        FExpectedEnabled := FALSE;

    DisabledNotReady:
        FSubject(Enable := FALSE,
            Ready := FALSE,
            Completed := FALSE,
            Error := FALSE);
        FObserved := FSubject.Status;
        FObservedEnabled := FSubject.Enabled;
        FExpected.State := E_State.Idle;
        FExpected.ExecutionStatus := E_ExecutionStatus.NotReady;
        FExpected.Ready := FALSE;
        FExpected.Running := FALSE;
        FExpected.Completed := FALSE;
        FExpected.Error := FALSE;
        FExpectedEnabled := FALSE;

ELSE
    Error(Message := 'Unexpected Preparation test state.');
    RETURN;
END_CASE;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>