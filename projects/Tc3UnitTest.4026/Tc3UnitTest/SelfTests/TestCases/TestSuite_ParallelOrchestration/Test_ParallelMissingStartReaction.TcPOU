<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_ParallelMissingStartReaction" Id="{157604a6-d46d-471b-966a-b976b85e7713}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Rejects a missing same-slot Start reaction without releasing a running sibling's reservation or starting another child.</summary>
<description>
Child 1 runs when child 2 ignores Start and stays Idle. The following helper call must
release only child 2 and hold one isolated Framework diagnostic. Child 1 subsequently
completes naturally; child 3 must never receive Start.
</description>
*)
{endregion}
FUNCTION_BLOCK Test_ParallelMissingStartReaction EXTENDS OrchestrationTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{8f3bcfb0-c658-4fca-adcc-caf82649bdac}" />
    <Method Name="ConfigureScenario" Id="{f1fffd42-bf16-4399-80db-f53fa7b1fd94}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines independent per-cycle child responses and Parallel dispatch expectations.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FChildSlots[1] := 1;
FChildSlots[2] := 1;
FChildSlots[3] := 1;
FStepCount := 8;

{region "01 - Observe initial readiness"}
FSteps[1].Task := E_OrchestratorTask.Idle;
FSteps[1].ExpectedReady := TRUE;
{endregion}

{region "02 - Start child 1 normally"}
FSteps[2].Children[1].State := E_State.Running;
FSteps[2].Children[1].Ready := FALSE;
FSteps[2].ExpectedStartChild := 1;
FSteps[2].ExpectedSlot := 1;
FSteps[2].ExpectedReservations[1] := 1;
FSteps[2].MaxActiveChildCount := 1;
{endregion}

{region "03 - Request child 2 Start but keep it Idle"}
FSteps[3].Children[1].State := E_State.Running;
FSteps[3].Children[1].Ready := FALSE;
FSteps[3].ExpectedStartChild := 2;
FSteps[3].ExpectedSlot := 1;
FSteps[3].ExpectedReservations[1] := 1;
FSteps[3].ExpectedReservations[2] := 1;
FSteps[3].MaxActiveChildCount := 2;
{endregion}

{region "04 - Reject child 2 while retaining child 1 reservation"}
FSteps[4].Children[1].State := E_State.Running;
FSteps[4].Children[1].Ready := FALSE;
FSteps[4].ExpectedSlot := 1;
FSteps[4].ExpectedReservations[1] := 1;
FSteps[4].ExpectedReleasedEntries[2] := 1;
FSteps[4].MaxActiveChildCount := 1;
FSteps[4].ExpectedResult := E_Result.Error;
FSteps[4].ExpectedDiagnosticCount := 1;
{endregion}

{region "05 - Hold the error without retry or child 3 Start"}
FSteps[5].Children[1].State := E_State.Running;
FSteps[5].Children[1].Ready := FALSE;
FSteps[5].ExpectedSlot := 1;
FSteps[5].ExpectedReservations[1] := 1;
FSteps[5].MaxActiveChildCount := 1;
FSteps[5].ExpectedResult := E_Result.Error;
FSteps[5].ExpectedDiagnosticCount := 1;
{endregion}

{region "06 - Child 1 finishes independently of the held helper error"}
FSteps[6].Children[1].State := E_State.Completed;
FSteps[6].Children[1].Ready := FALSE;
FSteps[6].Children[1].Complete := TRUE;
FSteps[6].Children[1].Result := E_Result.Passed;
FSteps[6].ExpectedSlot := 1;
FSteps[6].ExpectedReservations[1] := 1;
FSteps[6].MaxActiveChildCount := 1;
FSteps[6].ExpectedResult := E_Result.Error;
FSteps[6].ExpectedDiagnosticCount := 1;
{endregion}

{region "07 - Release child 1 only after terminal observation"}
FSteps[7].Children[1].State := E_State.Completed;
FSteps[7].Children[1].Ready := FALSE;
FSteps[7].Children[1].Complete := TRUE;
FSteps[7].Children[1].Result := E_Result.Passed;
FSteps[7].ExpectedSlot := 1;
FSteps[7].ExpectedReleasedEntries[1] := 1;
FSteps[7].MaxActiveChildCount := 0;
FSteps[7].ExpectedResult := E_Result.Error;
FSteps[7].ExpectedDiagnosticCount := 1;
{endregion}

{region "08 - Keep the error without repeated diagnostics or Starts"}
FSteps[8].Children[1].State := E_State.Completed;
FSteps[8].Children[1].Ready := FALSE;
FSteps[8].Children[1].Complete := TRUE;
FSteps[8].Children[1].Result := E_Result.Passed;
FSteps[8].ExpectedSlot := 1;
FSteps[8].MaxActiveChildCount := 0;
FSteps[8].ExpectedResult := E_Result.Error;
FSteps[8].ExpectedDiagnosticCount := 1;
{endregion}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>