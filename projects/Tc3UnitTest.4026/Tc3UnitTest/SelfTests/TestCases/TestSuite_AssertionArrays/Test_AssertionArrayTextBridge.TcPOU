<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_AssertionArrayTextBridge" Id="{bd1be4ee-e7ca-4468-a4a0-97b83dabb3d9}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks BYTE/STRING and WORD/WSTRING comparisons without trimming or stopping at array zero.</summary>
<description>
Each independent scenario consumes a bound reset call before its evaluation call.
ProcessAssertions checks the observation before ProcessTests advances.
SelectScenario holds explicit expected results; no production algorithm is mirrored.
Expected findings remain in the local capture; only outer checks affect the test result.
FirstFailedScenario and FailedDuringEvaluation retain the first mismatch.
The wide text deliberately contains code units above 255 with the same low bytes as ASCII.
Input zero and trailing padding are data, not implicit string termination.
Eight simultaneous subject findings require capture headroom below the AlmostFull threshold.
</description>
*)
{endregion}
FUNCTION_BLOCK Test_AssertionArrayTextBridge EXTENDS TestCaseBase
VAR
    FEqual : AssertArrayEqualString_Byte;
    FEqualExpectedResult : E_Result;
    FEqualExpectedFinding : BOOL;
    FContains : AssertArrayContainsString_Byte;
    FContainsExpectedResult : E_Result;
    FContainsExpectedFinding : BOOL;
    FStartsWith : AssertArrayStartsWithString_Byte;
    FStartsWithExpectedResult : E_Result;
    FStartsWithExpectedFinding : BOOL;
    FEndsWith : AssertArrayEndsWithString_Byte;
    FEndsWithExpectedResult : E_Result;
    FEndsWithExpectedFinding : BOOL;
    FWideEqual : AssertArrayEqualWString_Word;
    FWideEqualExpectedResult : E_Result;
    FWideEqualExpectedFinding : BOOL;
    FWideContains : AssertArrayContainsWString_Word;
    FWideContainsExpectedResult : E_Result;
    FWideContainsExpectedFinding : BOOL;
    FWideStartsWith : AssertArrayStartsWithWString_Word;
    FWideStartsWithExpectedResult : E_Result;
    FWideStartsWithExpectedFinding : BOOL;
    FWideEndsWith : AssertArrayEndsWithWString_Word;
    FWideEndsWithExpectedResult : E_Result;
    FWideEndsWithExpectedFinding : BOOL;
    FData : ARRAY[-2..3] OF BYTE;
    FDataBefore : ARRAY[-2..3] OF BYTE;
    FWideData : ARRAY[-2..3] OF WORD;
    FWideDataBefore : ARRAY[-2..3] OF WORD;
    FExpected : STRING(Param_Assertions.AssertionStringLength);
    FExpectedBefore : STRING(Param_Assertions.AssertionStringLength);
    FWideExpected : WSTRING(Param_Assertions.AssertionWStringLength);
    FWideExpectedBefore : WSTRING(Param_Assertions.AssertionWStringLength);
    FStartIndex : DINT;
    FLength : USINT;
    FSubjectEnable : BOOL;
    FCapture : EventBuffer;
    FEvents : ARRAY[1..CaptureLength] OF ST_Event;
    FCaptureFifo : ST_FifoStatus;
    FCaptureStatus : ST_EventBufferStatus;
    FSetupValid : BOOL;
    FScenario : UINT;
    FChecked : BOOL;
    FEvaluateSubjects : BOOL;
    FObservationReady : BOOL;
    FFirstFailedScenario : UINT;
    FFailedDuringEvaluation : BOOL;
    FResultsMatch : BOOL;
    FResults : AssertTrue;
    FActivityMatch : BOOL;
    FActivity : AssertTrue;
    FInputsMatch : BOOL;
    FInputs : AssertTrue;
    FFindingsMatch : BOOL;
    FFindings : AssertTrue;
END_VAR
VAR CONSTANT
    CaptureLength : UINT := 12;
    ScenarioBothBoundaries : UINT := 1;
    ScenarioExactRegion : UINT := 2;
    ScenarioFirstOnly : UINT := 3;
    ScenarioLastOnly : UINT := 4;
    ScenarioAbsent : UINT := 5;
    ScenarioPartialAtEnd : UINT := 6;
    ScenarioMatchAfterZero : UINT := 7;
    ScenarioTrailingZeroNotPadding : UINT := 8;
    ScenarioTextLongerThanRange : UINT := 9;
    ScenarioEmptyExpected : UINT := 10;
    ScenarioEmptyRange : UINT := 11;
    ScenarioBeyondUpperBound : UINT := 12;
    ScenarioWideHighByteMismatch : UINT := 13;
    ScenarioFailedCandidateThenMatch : UINT := 14;
    LastScenario : UINT := ScenarioFailedCandidateThenMatch;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{39a9e4f5-8520-4794-aa21-e2abed44a9a2}" />
    <Method Name="AggregateResults" Id="{9e3e8b26-a2c8-4cf4-af50-72b275816d92}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Aggregates only outer checks, not intentionally failing subjects.</summary>
*)
{endregion}
METHOD PROTECTED AggregateResults
VAR_INPUT
    Aggregator : I_ResultAggregator; //! Borrowed result sink owned by the outer Test Case; add this test's checking Assertions without resetting or retaining the sink.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Aggregator.AddProvider(Provider := FResults);
Aggregator.AddProvider(Provider := FActivity);
Aggregator.AddProvider(Provider := FInputs);
Aggregator.AddProvider(Provider := FFindings);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CallSubjects" Id="{e3448c2e-606c-4265-9f66-14a0d07e7216}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls each inherited production subject once with caller-owned input storage.</summary>
*)
{endregion}
METHOD PRIVATE CallSubjects]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqual(Enable := FSubjectEnable,
    State := E_State.Running,
    StartIndex := FStartIndex,
    Length := FLength,
    IN := FData,
    Expected := FExpected);
FContains(Enable := FSubjectEnable,
    State := E_State.Running,
    StartIndex := FStartIndex,
    Length := FLength,
    IN := FData,
    Expected := FExpected);
FStartsWith(Enable := FSubjectEnable,
    State := E_State.Running,
    StartIndex := FStartIndex,
    Length := FLength,
    IN := FData,
    Expected := FExpected);
FEndsWith(Enable := FSubjectEnable,
    State := E_State.Running,
    StartIndex := FStartIndex,
    Length := FLength,
    IN := FData,
    Expected := FExpected);
FWideEqual(Enable := FSubjectEnable,
    State := E_State.Running,
    StartIndex := FStartIndex,
    Length := FLength,
    IN := FWideData,
    Expected := FWideExpected);
FWideContains(Enable := FSubjectEnable,
    State := E_State.Running,
    StartIndex := FStartIndex,
    Length := FLength,
    IN := FWideData,
    Expected := FWideExpected);
FWideStartsWith(Enable := FSubjectEnable,
    State := E_State.Running,
    StartIndex := FStartIndex,
    Length := FLength,
    IN := FWideData,
    Expected := FWideExpected);
FWideEndsWith(Enable := FSubjectEnable,
    State := E_State.Running,
    StartIndex := FStartIndex,
    Length := FLength,
    IN := FWideData,
    Expected := FWideExpected);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckFinding" Id="{1bfa9908-ad60-4446-8e07-fb9cc43d78c0}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks one subject finding in call order; expected outcomes come from the scenario.</summary>
*)
{endregion}
METHOD PRIVATE CheckFinding : BOOL //! TRUE when the required finding checks pass; calls requiring no finding also succeed.
VAR_INPUT
    Subject : I_Assertion; //! Assertion interface supplying the expected finding identity.
    ExpectedResult : E_Result; //! Independently authored result expected in the captured finding.
    ExpectedFinding : BOOL; //! TRUE when this scenario requires a finding during active evaluation.
END_VAR
VAR_IN_OUT
    Index : UINT; //! One-based next finding index; advanced when this call checks a required finding.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckFinding := TRUE;
IF FEvaluateSubjects AND ExpectedFinding THEN
    CheckFinding := (FEvents[Index].SequenceId = UINT_TO_UDINT(Index))
        AND (FEvents[Index].Name = Subject.Name)
        AND (FEvents[Index].OwnerScope = E_OwnerScope.Assertion)
        AND (FEvents[Index].EventType = E_EventType.Result)
        AND (FEvents[Index].State = E_State.Running)
        AND (FEvents[Index].Result = ExpectedResult)
        AND (FEvents[Index].Message <> '');
    Index := Index + 1;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckFindings" Id="{d6c2072d-6d09-42be-b385-7aac33fb1598}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks exact finding count and identities; at most one finding per subject.</summary>
*)
{endregion}
METHOD PRIVATE CheckFindings
VAR
    Index : UINT;
    Matches : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Index := 1;
FFindingsMatch := TRUE;
Matches := CheckFinding(Subject := FEqual,
    ExpectedResult := FEqualExpectedResult,
    ExpectedFinding := FEqualExpectedFinding,
    Index := Index);
FFindingsMatch := FFindingsMatch AND Matches;
Matches := CheckFinding(Subject := FContains,
    ExpectedResult := FContainsExpectedResult,
    ExpectedFinding := FContainsExpectedFinding,
    Index := Index);
FFindingsMatch := FFindingsMatch AND Matches;
Matches := CheckFinding(Subject := FStartsWith,
    ExpectedResult := FStartsWithExpectedResult,
    ExpectedFinding := FStartsWithExpectedFinding,
    Index := Index);
FFindingsMatch := FFindingsMatch AND Matches;
Matches := CheckFinding(Subject := FEndsWith,
    ExpectedResult := FEndsWithExpectedResult,
    ExpectedFinding := FEndsWithExpectedFinding,
    Index := Index);
FFindingsMatch := FFindingsMatch AND Matches;
Matches := CheckFinding(Subject := FWideEqual,
    ExpectedResult := FWideEqualExpectedResult,
    ExpectedFinding := FWideEqualExpectedFinding,
    Index := Index);
FFindingsMatch := FFindingsMatch AND Matches;
Matches := CheckFinding(Subject := FWideContains,
    ExpectedResult := FWideContainsExpectedResult,
    ExpectedFinding := FWideContainsExpectedFinding,
    Index := Index);
FFindingsMatch := FFindingsMatch AND Matches;
Matches := CheckFinding(Subject := FWideStartsWith,
    ExpectedResult := FWideStartsWithExpectedResult,
    ExpectedFinding := FWideStartsWithExpectedFinding,
    Index := Index);
FFindingsMatch := FFindingsMatch AND Matches;
Matches := CheckFinding(Subject := FWideEndsWith,
    ExpectedResult := FWideEndsWithExpectedResult,
    ExpectedFinding := FWideEndsWithExpectedFinding,
    Index := Index);
FFindingsMatch := FFindingsMatch AND Matches;
FFindingsMatch := FFindingsMatch
    AND (FCaptureStatus.SequenceId = UINT_TO_UDINT(Index - 1))
    AND (FCaptureStatus.LostEventCount = 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInitialization" Id="{f9138a33-9eee-4dab-a5c2-21c291b501bd}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Rejects incomplete subject, capture or outer Assertion setup.</summary>
*)
{endregion}
METHOD PROTECTED CheckInitialization : BOOL //! TRUE when the inherited initialization check and this concrete fixture check both accept the setup.]]></Declaration>
      <Implementation>
        <ST><![CDATA[CheckInitialization := SUPER^.CheckInitialization();
IF NOT CheckInitialization THEN
    RETURN;
END_IF;

CheckInitialization := (Param_Assertions.AssertionStringLength >= 2)
    AND (Param_Assertions.AssertionWStringLength >= 2)
    AND FSetupValid
    AND FResults.IsInitialized
    AND FActivity.IsInitialized
    AND FInputs.IsInitialized
    AND FFindings.IsInitialized;
IF NOT CheckInitialization THEN
    EventPublisher.PublishEvent(Event := CreateFrameworkEvent(Name := Name,
        ResourceName := '',
        State := State,
        Severity := E_EventSeverity.Error,
        Message := 'Array selftest setup failed.'));
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckInputs" Id="{84eca7d6-6634-4565-86fc-22e8ca202a0f}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Verifies input preservation without using the tested comparison algorithm.</summary>
*)
{endregion}
METHOD PRIVATE CheckInputs
VAR
    Index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FInputsMatch := TRUE;
FOR Index := -2 TO 3 DO
    FInputsMatch := FInputsMatch AND (FData[Index] = FDataBefore[Index]);
END_FOR;
FOR Index := -2 TO 3 DO
    FInputsMatch := FInputsMatch AND (FWideData[Index] = FWideDataBefore[Index]);
END_FOR;
FInputsMatch := FInputsMatch AND (FExpected = FExpectedBefore)
    AND (FWideExpected = FWideExpectedBefore);]]></ST>
      </Implementation>
    </Method>
    <Method Name="CheckResults" Id="{df777678-e4ab-40d7-b7c3-b999ccbc702a}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks literal evaluation results, or NotEvaluated on the reset call.</summary>
*)
{endregion}
METHOD PRIVATE CheckResults]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF FEvaluateSubjects THEN
    FResultsMatch := (FEqual.Result = FEqualExpectedResult)
        AND (FContains.Result = FContainsExpectedResult)
        AND (FStartsWith.Result = FStartsWithExpectedResult)
        AND (FEndsWith.Result = FEndsWithExpectedResult)
        AND (FWideEqual.Result = FWideEqualExpectedResult)
        AND (FWideContains.Result = FWideContainsExpectedResult)
        AND (FWideStartsWith.Result = FWideStartsWithExpectedResult)
        AND (FWideEndsWith.Result = FWideEndsWithExpectedResult);
ELSE
    FResultsMatch := (FEqual.Result = E_Result.NotEvaluated)
        AND (FContains.Result = E_Result.NotEvaluated)
        AND (FStartsWith.Result = E_Result.NotEvaluated)
        AND (FEndsWith.Result = E_Result.NotEvaluated)
        AND (FWideEqual.Result = E_Result.NotEvaluated)
        AND (FWideContains.Result = E_Result.NotEvaluated)
        AND (FWideStartsWith.Result = E_Result.NotEvaluated)
        AND (FWideEndsWith.Result = E_Result.NotEvaluated);
END_IF;
FActivityMatch := (FEqual.Enabled = FSubjectEnable)
    AND (FEqual.ObservationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FEqual.EvaluationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FContains.Enabled = FSubjectEnable)
    AND (FContains.ObservationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FContains.EvaluationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FStartsWith.Enabled = FSubjectEnable)
    AND (FStartsWith.ObservationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FStartsWith.EvaluationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FEndsWith.Enabled = FSubjectEnable)
    AND (FEndsWith.ObservationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FEndsWith.EvaluationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FWideEqual.Enabled = FSubjectEnable)
    AND (FWideEqual.ObservationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FWideEqual.EvaluationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FWideContains.Enabled = FSubjectEnable)
    AND (FWideContains.ObservationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FWideContains.EvaluationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FWideStartsWith.Enabled = FSubjectEnable)
    AND (FWideStartsWith.ObservationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FWideStartsWith.EvaluationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FWideEndsWith.Enabled = FSubjectEnable)
    AND (FWideEndsWith.ObservationActive = (FEvaluateSubjects AND FSubjectEnable))
    AND (FWideEndsWith.EvaluationActive = (FEvaluateSubjects AND FSubjectEnable));]]></ST>
      </Implementation>
    </Method>
    <Method Name="Configure" Id="{65d9e1ea-9cd9-4970-b471-1a636c1ed6b8}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes outer checks and isolates intentional subject findings.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR
    Initialized : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FPreparationStateCount := 0;
FTestStateCount := 1;
FResults.Initialize(Parent := THIS^,
    AssertionName := 'Results');
FActivity.Initialize(Parent := THIS^,
    AssertionName := 'Activity');
FInputs.Initialize(Parent := THIS^,
    AssertionName := 'Inputs');
FFindings.Initialize(Parent := THIS^,
    AssertionName := 'Findings');
FSetupValid := FCapture.Initialize(Buffer := FEvents,
    FifoControl := FCaptureFifo,
    Status := FCaptureStatus);
FEqual.BindPublisher(Publisher := FCapture);
Initialized := FEqual.Initialize(Parent := THIS^,
    AssertionName := 'Equal');
FSetupValid := FSetupValid AND Initialized;
FContains.BindPublisher(Publisher := FCapture);
Initialized := FContains.Initialize(Parent := THIS^,
    AssertionName := 'Contains');
FSetupValid := FSetupValid AND Initialized;
FStartsWith.BindPublisher(Publisher := FCapture);
Initialized := FStartsWith.Initialize(Parent := THIS^,
    AssertionName := 'StartsWith');
FSetupValid := FSetupValid AND Initialized;
FEndsWith.BindPublisher(Publisher := FCapture);
Initialized := FEndsWith.Initialize(Parent := THIS^,
    AssertionName := 'EndsWith');
FSetupValid := FSetupValid AND Initialized;
FWideEqual.BindPublisher(Publisher := FCapture);
Initialized := FWideEqual.Initialize(Parent := THIS^,
    AssertionName := 'WideEqual');
FSetupValid := FSetupValid AND Initialized;
FWideContains.BindPublisher(Publisher := FCapture);
Initialized := FWideContains.Initialize(Parent := THIS^,
    AssertionName := 'WideContains');
FSetupValid := FSetupValid AND Initialized;
FWideStartsWith.BindPublisher(Publisher := FCapture);
Initialized := FWideStartsWith.Initialize(Parent := THIS^,
    AssertionName := 'WideStartsWith');
FSetupValid := FSetupValid AND Initialized;
FWideEndsWith.BindPublisher(Publisher := FCapture);
Initialized := FWideEndsWith.Initialize(Parent := THIS^,
    AssertionName := 'WideEndsWith');
FSetupValid := FSetupValid AND Initialized;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAbort" Id="{0ae439d5-dc7c-4cb1-b526-177f90363be8}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Completes abort; no asynchronous resource is owned.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAbort
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
    CompleteAbort();
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessAssertions" Id="{cf93b0a9-e521-42df-9e97-8fcda72c2780}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Latches this call's checks before progression is permitted.</summary>
*)
{endregion}
METHOD PROTECTED ProcessAssertions
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR
VAR
    Check : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Check := Enable AND FObservationReady;
FResults(Enable := Check,
    State := State,
    IN := FResultsMatch);
FActivity(Enable := Check,
    State := State,
    IN := FActivityMatch);
FInputs(Enable := Check,
    State := State,
    IN := FInputsMatch);
FFindings(Enable := Check,
    State := State,
    IN := FFindingsMatch);
IF Check THEN
    FChecked := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessPreparations" Id="{8bfbe6f0-838d-46c5-994d-99a541245d7e}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>No Preparation phase is needed.</summary>
*)
{endregion}
METHOD PROTECTED ProcessPreparations
VAR_INPUT
    // SA0033: Required hook; this test has no Preparation phase.
    {attribute 'analysis' := '-33'}
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessReset" Id="{97ec6e1d-c199-4924-b52b-42dea3b0d673}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Restarts the scenario sequence and outer checks.</summary>
*)
{endregion}
METHOD PROTECTED ProcessReset]]></Declaration>
      <Implementation>
        <ST><![CDATA[FScenario := ScenarioBothBoundaries;
FChecked := FALSE;
FSubjectEnable := FALSE;
FEvaluateSubjects := FALSE;
FObservationReady := FALSE;
FFirstFailedScenario := 0;
FFailedDuringEvaluation := FALSE;
FCapture.Reset();
ResetSubjects();
FResults.Reset();
FActivity.Reset();
FInputs.Reset();
FFindings.Reset();
CompleteReset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTests" Id="{094109fe-9165-4ee9-b838-0f73f3d5f5ae}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Consumes reset, evaluates, then waits for the outer checks before advancing.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTests
VAR_INPUT
    Enable : BOOL; //! Phase permission supplied by the owning Test Case; FALSE does not authorize progression, while observation may continue.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
    RETURN;
END_IF;

IF FChecked THEN
    FChecked := FALSE;
    FObservationReady := FALSE;
    IF FEvaluateSubjects THEN
        IF FScenario = LastScenario THEN
            CompleteTests();
            RETURN;
        END_IF;
        FScenario := FScenario + 1;
    END_IF;
    FEvaluateSubjects := NOT FEvaluateSubjects;
END_IF;

IF NOT SelectScenario() THEN
    RETURN;
END_IF;
FCapture.Reset();
IF NOT FEvaluateSubjects THEN
    ResetSubjects();
END_IF;
FDataBefore := FData;
FWideDataBefore := FWideData;
FExpectedBefore := FExpected;
FWideExpectedBefore := FWideExpected;
CallSubjects();
CheckResults();
CheckInputs();
CheckFindings();
IF (FFirstFailedScenario = 0)
    AND NOT (FResultsMatch AND FActivityMatch AND FInputsMatch AND FFindingsMatch) THEN
    FFirstFailedScenario := FScenario;
    FFailedDuringEvaluation := FEvaluateSubjects;
END_IF;
FObservationReady := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetSubjects" Id="{350e4bef-348f-4bcc-a86e-2d92e926ff04}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Queues reset; the next bound FB call consumes it without evaluating.</summary>
*)
{endregion}
METHOD PRIVATE ResetSubjects]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEqual.Reset();
FContains.Reset();
FStartsWith.Reset();
FEndsWith.Reset();
FWideEqual.Reset();
FWideContains.Reset();
FWideStartsWith.Reset();
FWideEndsWith.Reset();]]></ST>
      </Implementation>
    </Method>
    <Method Name="SelectScenario" Id="{1d07d7d9-71fc-4a52-bd8b-a9ac0ebe5ff1}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Selects explicit stimuli and expected results for one scenario.</summary>
*)
{endregion}
METHOD PRIVATE SelectScenario : BOOL //! TRUE after selecting a supported scenario and its literal expectations; FALSE reports an unknown scenario.
VAR
    Index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[SelectScenario := FALSE;
FSubjectEnable := TRUE;
FData[-2] := BYTE#16#41;
FData[-1] := BYTE#16#42;
FData[0] := BYTE#16#78;
FData[1] := BYTE#16#78;
FData[2] := BYTE#16#41;
FData[3] := BYTE#16#42;
FWideData[-2] := WORD#16#0141;
FWideData[-1] := WORD#16#0242;
FWideData[0] := WORD#16#0078;
FWideData[1] := WORD#16#0078;
FWideData[2] := WORD#16#0141;
FWideData[3] := WORD#16#0242;
FExpected := 'AB';
FWideExpected := "AB";
FWideExpected[0] := WORD#16#0141;
FWideExpected[1] := WORD#16#0242;
FStartIndex := -2;
FLength := 6;
CASE FScenario OF
    ScenarioBothBoundaries:
        FEqualExpectedResult := E_Result.Failed;
        FEqualExpectedFinding := TRUE;
        FContainsExpectedResult := E_Result.Passed;
        FContainsExpectedFinding := FALSE;
        FStartsWithExpectedResult := E_Result.Passed;
        FStartsWithExpectedFinding := FALSE;
        FEndsWithExpectedResult := E_Result.Passed;
        FEndsWithExpectedFinding := FALSE;
        FWideEqualExpectedResult := E_Result.Failed;
        FWideEqualExpectedFinding := TRUE;
        FWideContainsExpectedResult := E_Result.Passed;
        FWideContainsExpectedFinding := FALSE;
        FWideStartsWithExpectedResult := E_Result.Passed;
        FWideStartsWithExpectedFinding := FALSE;
        FWideEndsWithExpectedResult := E_Result.Passed;
        FWideEndsWithExpectedFinding := FALSE;
    ScenarioExactRegion:
        FLength := 2;
        FEqualExpectedResult := E_Result.Passed;
        FEqualExpectedFinding := FALSE;
        FContainsExpectedResult := E_Result.Passed;
        FContainsExpectedFinding := FALSE;
        FStartsWithExpectedResult := E_Result.Passed;
        FStartsWithExpectedFinding := FALSE;
        FEndsWithExpectedResult := E_Result.Passed;
        FEndsWithExpectedFinding := FALSE;
        FWideEqualExpectedResult := E_Result.Passed;
        FWideEqualExpectedFinding := FALSE;
        FWideContainsExpectedResult := E_Result.Passed;
