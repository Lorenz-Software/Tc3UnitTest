<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_OrchestratorResetInterruption" Id="{cdb7a5d3-212f-440f-9e5b-ae00fd3f3fec}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Reset replaces Execution and may dispatch subsequent child resets before prior reset completion.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_OrchestratorResetInterruption EXTENDS OrchestrationTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{7332907b-492c-49d7-b30e-fcb8cbb93ad1}" />
    <Method Name="ConfigureScenario" Id="{db911133-0159-4a27-a382-a441bedc7753}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines independent stimuli and expected requests, reservations, task status and diagnostic counts.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FStepCount := 10;

{region "01 - Idle readiness before child processing"}
FSteps[1].Task := E_OrchestratorTask.Idle;
FSteps[1].ExpectedReady := TRUE;
{endregion}

{region "02 - Execution begins; other resources become not ready"}
FSteps[2].Children[1].State := E_State.Running;
FSteps[2].Children[1].Ready := FALSE;
FSteps[2].Children[2].Ready := FALSE;
FSteps[2].Children[3].Ready := FALSE;
FSteps[2].ExpectedStartChild := 1;
FSteps[2].ExpectedSlot := 1;
FSteps[2].ExpectedReservations[1] := 1;
{endregion}

{region "03 - Reset first child in the task-entry call"}
FSteps[3].Task := E_OrchestratorTask.Reset;
FSteps[3].Children[1].State := E_State.Reset;
FSteps[3].Children[1].Ready := FALSE;
FSteps[3].Children[2].Ready := FALSE;
FSteps[3].Children[3].Ready := FALSE;
FSteps[3].ExpectedResetChild := 1;
FSteps[3].ExpectedReservations[1] := 1;
{endregion}

{region "04 - Dispatch second Reset while first is still active"}
FSteps[4].Task := E_OrchestratorTask.Reset;
FSteps[4].Children[1].State := E_State.Reset;
FSteps[4].Children[1].Ready := FALSE;
FSteps[4].Children[2].State := E_State.Reset;
FSteps[4].Children[2].Ready := FALSE;
FSteps[4].Children[3].Ready := FALSE;
FSteps[4].ExpectedResetChild := 2;
FSteps[4].ExpectedReservations[1] := 1;
FSteps[4].ExpectedReservations[2] := 1;
{endregion}

{region "05 - Dispatch third Reset; first finishes afterwards"}
FSteps[5].Task := E_OrchestratorTask.Reset;
FSteps[5].Children[2].State := E_State.Reset;
FSteps[5].Children[2].Ready := FALSE;
FSteps[5].Children[3].State := E_State.Reset;
FSteps[5].Children[3].Ready := FALSE;
FSteps[5].ExpectedResetChild := 3;
FSteps[5].ExpectedReservations[1] := 1;
FSteps[5].ExpectedReservations[2] := 1;
FSteps[5].ExpectedReservations[3] := 1;
{endregion}

{region "06 - Release first; second finishes afterwards"}
FSteps[6].Task := E_OrchestratorTask.Reset;
FSteps[6].Children[3].State := E_State.Reset;
FSteps[6].Children[3].Ready := FALSE;
FSteps[6].ExpectedReservations[2] := 1;
FSteps[6].ExpectedReservations[3] := 1;
FSteps[6].ExpectedReleasedEntries[1] := 1;
{endregion}

{region "07 - Release second; third finishes afterwards"}
FSteps[7].Task := E_OrchestratorTask.Reset;
FSteps[7].ExpectedReservations[3] := 1;
FSteps[7].ExpectedReleasedEntries[2] := 1;
{endregion}

{region "08 - All reset observations are ready and reconciled"}
FSteps[8].Task := E_OrchestratorTask.Reset;
FSteps[8].ExpectedReleasedEntries[3] := 1;
FSteps[8].ExpectedResetFinished := TRUE;
{endregion}

{region "09 - Repeated Reset task does not restart dispatch"}
FSteps[9].Task := E_OrchestratorTask.Reset;
FSteps[9].ExpectedResetFinished := TRUE;
{endregion}

{region "10 - Only owner task change makes helper ready"}
FSteps[10].Task := E_OrchestratorTask.Idle;
FSteps[10].ExpectedReady := TRUE;
{endregion}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>