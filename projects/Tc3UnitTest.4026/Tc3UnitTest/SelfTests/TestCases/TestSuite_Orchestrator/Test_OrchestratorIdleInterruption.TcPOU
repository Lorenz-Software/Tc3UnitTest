<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_OrchestratorIdleInterruption" Id="{6d4f0834-e757-45cf-b11a-ccb6292cd446}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Idle stops new dispatch without forcing child Abort or releasing an unfinished reservation.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_OrchestratorIdleInterruption EXTENDS OrchestrationTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{dca3447b-ac67-4c4c-9050-c0b746f99795}" />
    <Method Name="ConfigureScenario" Id="{ce580f7e-aa89-40e8-ba65-4df3ac1c6c98}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines independent stimuli and expected requests, reservations, task status and diagnostic counts.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FStepCount := 6;

{region "01 - Idle readiness before child processing"}
FSteps[1].Task := E_OrchestratorTask.Idle;
FSteps[1].ExpectedReady := TRUE;
{endregion}

{region "02 - Start first child"}
FSteps[2].Children[1].State := E_State.Running;
FSteps[2].Children[1].Ready := FALSE;
FSteps[2].ExpectedStartChild := 1;
FSteps[2].ExpectedSlot := 1;
FSteps[2].ExpectedReservations[1] := 1;
{endregion}

{region "03 - Idle leaves running child and reservation intact"}
FSteps[3].Task := E_OrchestratorTask.Idle;
FSteps[3].Children[1].State := E_State.Running;
FSteps[3].Children[1].Ready := FALSE;
FSteps[3].ExpectedReservations[1] := 1;
{endregion}

{region "04 - Child finishes while owner remains Idle"}
FSteps[4].Task := E_OrchestratorTask.Idle;
FSteps[4].Children[1].State := E_State.Completed;
FSteps[4].Children[1].Result := E_Result.Passed;
FSteps[4].Children[1].Ready := FALSE;
FSteps[4].Children[1].Complete := TRUE;
FSteps[4].ExpectedReservations[1] := 1;
{endregion}

{region "05 - Idle releases the finished child only"}
FSteps[5].Task := E_OrchestratorTask.Idle;
FSteps[5].Children[1].State := E_State.Completed;
FSteps[5].Children[1].Result := E_Result.Passed;
FSteps[5].Children[1].Ready := FALSE;
FSteps[5].Children[1].Complete := TRUE;
FSteps[5].ExpectedReleasedEntries[1] := 1;
{endregion}

{region "06 - Idle does not start the next child"}
FSteps[6].Task := E_OrchestratorTask.Idle;
FSteps[6].Children[1].State := E_State.Completed;
FSteps[6].Children[1].Result := E_Result.Passed;
FSteps[6].Children[1].Ready := FALSE;
FSteps[6].Children[1].Complete := TRUE;
{endregion}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>