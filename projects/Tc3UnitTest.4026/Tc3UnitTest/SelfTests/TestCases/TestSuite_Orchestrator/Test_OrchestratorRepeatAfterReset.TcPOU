<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_OrchestratorRepeatAfterReset" Id="{001fd43f-51bf-4a66-b874-7c264316447f}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Runs all three children twice with intervening Reset and without reinitializing the subject or capture.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_OrchestratorRepeatAfterReset EXTENDS OrchestrationTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{db21fb39-65c3-4c0f-bad7-1b1ad413d1e3}" />
    <Method Name="ConfigureScenario" Id="{5c2ae8a2-872b-4122-9b42-0abd0927e10c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines independent stimuli and expected requests, reservations, task status and diagnostic counts.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FStepCount := 21;

{region "01 - Idle readiness before child processing"}
FSteps[1].Task := E_OrchestratorTask.Idle;
FSteps[1].ExpectedReady := TRUE;
{endregion}

{region "02 - First child completes on its Start call"}
FSteps[2].Children[1].State := E_State.Completed;
FSteps[2].Children[1].Result := E_Result.Passed;
FSteps[2].Children[1].Ready := FALSE;
FSteps[2].Children[1].Complete := TRUE;
FSteps[2].ExpectedStartChild := 1;
FSteps[2].ExpectedSlot := 1;
FSteps[2].ExpectedReservations[1] := 1;
{endregion}

{region "03 - Observe first completion"}
FSteps[3].Children[1].State := E_State.Completed;
FSteps[3].Children[1].Result := E_Result.Passed;
FSteps[3].Children[1].Ready := FALSE;
FSteps[3].Children[1].Complete := TRUE;
FSteps[3].ExpectedSlot := 2;
FSteps[3].ExpectedReleasedEntries[1] := 1;
{endregion}

{region "04 - Second child completes on its Start call"}
FSteps[4].Children[1].State := E_State.Completed;
FSteps[4].Children[1].Result := E_Result.Passed;
FSteps[4].Children[1].Ready := FALSE;
FSteps[4].Children[1].Complete := TRUE;
FSteps[4].Children[2].State := E_State.Completed;
FSteps[4].Children[2].Result := E_Result.Passed;
FSteps[4].Children[2].Ready := FALSE;
FSteps[4].Children[2].Complete := TRUE;
FSteps[4].ExpectedStartChild := 2;
FSteps[4].ExpectedSlot := 2;
FSteps[4].ExpectedReservations[2] := 1;
{endregion}

{region "05 - Observe second completion"}
FSteps[5].Children[1].State := E_State.Completed;
FSteps[5].Children[1].Result := E_Result.Passed;
FSteps[5].Children[1].Ready := FALSE;
FSteps[5].Children[1].Complete := TRUE;
FSteps[5].Children[2].State := E_State.Completed;
FSteps[5].Children[2].Result := E_Result.Passed;
FSteps[5].Children[2].Ready := FALSE;
FSteps[5].Children[2].Complete := TRUE;
FSteps[5].ExpectedSlot := 3;
FSteps[5].ExpectedReleasedEntries[2] := 1;
{endregion}

{region "06 - Third child completes on its Start call"}
FSteps[6].Children[1].State := E_State.Completed;
FSteps[6].Children[1].Result := E_Result.Passed;
FSteps[6].Children[1].Ready := FALSE;
FSteps[6].Children[1].Complete := TRUE;
FSteps[6].Children[2].State := E_State.Completed;
FSteps[6].Children[2].Result := E_Result.Passed;
FSteps[6].Children[2].Ready := FALSE;
FSteps[6].Children[2].Complete := TRUE;
FSteps[6].Children[3].State := E_State.Completed;
FSteps[6].Children[3].Result := E_Result.Passed;
FSteps[6].Children[3].Ready := FALSE;
FSteps[6].Children[3].Complete := TRUE;
FSteps[6].ExpectedStartChild := 3;
FSteps[6].ExpectedSlot := 3;
FSteps[6].ExpectedReservations[3] := 1;
{endregion}

{region "07 - Observe execution completion"}
FSteps[7].Children[1].State := E_State.Completed;
FSteps[7].Children[1].Result := E_Result.Passed;
FSteps[7].Children[1].Ready := FALSE;
FSteps[7].Children[1].Complete := TRUE;
FSteps[7].Children[2].State := E_State.Completed;
FSteps[7].Children[2].Result := E_Result.Passed;
FSteps[7].Children[2].Ready := FALSE;
FSteps[7].Children[2].Complete := TRUE;
FSteps[7].Children[3].State := E_State.Completed;
FSteps[7].Children[3].Result := E_Result.Passed;
FSteps[7].Children[3].Ready := FALSE;
FSteps[7].Children[3].Complete := TRUE;
FSteps[7].ExpectedReleasedEntries[3] := 1;
FSteps[7].ExpectedFinished := TRUE;
{endregion}

{region "08 - Completed Execution task is retained"}
FSteps[8].Children[1].State := E_State.Completed;
FSteps[8].Children[1].Result := E_Result.Passed;
FSteps[8].Children[1].Ready := FALSE;
FSteps[8].Children[1].Complete := TRUE;
FSteps[8].Children[2].State := E_State.Completed;
FSteps[8].Children[2].Result := E_Result.Passed;
FSteps[8].Children[2].Ready := FALSE;
FSteps[8].Children[2].Complete := TRUE;
FSteps[8].Children[3].State := E_State.Completed;
FSteps[8].Children[3].Result := E_Result.Passed;
FSteps[8].Children[3].Ready := FALSE;
FSteps[8].Children[3].Complete := TRUE;
FSteps[8].ExpectedFinished := TRUE;
{endregion}

{region "09 - Reset first completed child"}
FSteps[9].Task := E_OrchestratorTask.Reset;
FSteps[9].Children[2].State := E_State.Completed;
FSteps[9].Children[2].Result := E_Result.Passed;
FSteps[9].Children[2].Ready := FALSE;
FSteps[9].Children[2].Complete := TRUE;
FSteps[9].Children[3].State := E_State.Completed;
FSteps[9].Children[3].Result := E_Result.Passed;
FSteps[9].Children[3].Ready := FALSE;
FSteps[9].Children[3].Complete := TRUE;
FSteps[9].ExpectedResetChild := 1;
FSteps[9].ExpectedReservations[1] := 1;
{endregion}

{region "10 - Release first and Reset second"}
FSteps[10].Task := E_OrchestratorTask.Reset;
FSteps[10].Children[3].State := E_State.Completed;
FSteps[10].Children[3].Result := E_Result.Passed;
FSteps[10].Children[3].Ready := FALSE;
FSteps[10].Children[3].Complete := TRUE;
FSteps[10].ExpectedResetChild := 2;
FSteps[10].ExpectedReservations[2] := 1;
FSteps[10].ExpectedReleasedEntries[1] := 1;
{endregion}

{region "11 - Release second and Reset third"}
FSteps[11].Task := E_OrchestratorTask.Reset;
FSteps[11].ExpectedResetChild := 3;
FSteps[11].ExpectedReservations[3] := 1;
FSteps[11].ExpectedReleasedEntries[2] := 1;
{endregion}

{region "12 - Observe full Reset completion"}
FSteps[12].Task := E_OrchestratorTask.Reset;
FSteps[12].ExpectedReleasedEntries[3] := 1;
FSteps[12].ExpectedResetFinished := TRUE;
{endregion}

{region "13 - Holding Reset must not reissue requests"}
FSteps[13].Task := E_OrchestratorTask.Reset;
FSteps[13].ExpectedResetFinished := TRUE;
{endregion}

{region "14 - Return to ready Idle"}
FSteps[14].Task := E_OrchestratorTask.Idle;
FSteps[14].ExpectedReady := TRUE;
{endregion}

{region "15 - First child completes on its Start call"}
FSteps[15].Children[1].State := E_State.Completed;
FSteps[15].Children[1].Result := E_Result.Passed;
FSteps[15].Children[1].Ready := FALSE;
FSteps[15].Children[1].Complete := TRUE;
FSteps[15].ExpectedStartChild := 1;
FSteps[15].ExpectedSlot := 1;
FSteps[15].ExpectedReservations[1] := 1;
{endregion}

{region "16 - Observe first completion"}
FSteps[16].Children[1].State := E_State.Completed;
FSteps[16].Children[1].Result := E_Result.Passed;
FSteps[16].Children[1].Ready := FALSE;
FSteps[16].Children[1].Complete := TRUE;
FSteps[16].ExpectedSlot := 2;
FSteps[16].ExpectedReleasedEntries[1] := 1;
{endregion}

{region "17 - Second child completes on its Start call"}
FSteps[17].Children[1].State := E_State.Completed;
FSteps[17].Children[1].Result := E_Result.Passed;
FSteps[17].Children[1].Ready := FALSE;
FSteps[17].Children[1].Complete := TRUE;
FSteps[17].Children[2].State := E_State.Completed;
FSteps[17].Children[2].Result := E_Result.Passed;
FSteps[17].Children[2].Ready := FALSE;
FSteps[17].Children[2].Complete := TRUE;
FSteps[17].ExpectedStartChild := 2;
FSteps[17].ExpectedSlot := 2;
FSteps[17].ExpectedReservations[2] := 1;
{endregion}

{region "18 - Observe second completion"}
FSteps[18].Children[1].State := E_State.Completed;
FSteps[18].Children[1].Result := E_Result.Passed;
FSteps[18].Children[1].Ready := FALSE;
FSteps[18].Children[1].Complete := TRUE;
FSteps[18].Children[2].State := E_State.Completed;
FSteps[18].Children[2].Result := E_Result.Passed;
FSteps[18].Children[2].Ready := FALSE;
FSteps[18].Children[2].Complete := TRUE;
FSteps[18].ExpectedSlot := 3;
FSteps[18].ExpectedReleasedEntries[2] := 1;
{endregion}

{region "19 - Third child completes on its Start call"}
FSteps[19].Children[1].State := E_State.Completed;
FSteps[19].Children[1].Result := E_Result.Passed;
FSteps[19].Children[1].Ready := FALSE;
FSteps[19].Children[1].Complete := TRUE;
FSteps[19].Children[2].State := E_State.Completed;
FSteps[19].Children[2].Result := E_Result.Passed;
FSteps[19].Children[2].Ready := FALSE;
FSteps[19].Children[2].Complete := TRUE;
FSteps[19].Children[3].State := E_State.Completed;
FSteps[19].Children[3].Result := E_Result.Passed;
FSteps[19].Children[3].Ready := FALSE;
FSteps[19].Children[3].Complete := TRUE;
FSteps[19].ExpectedStartChild := 3;
FSteps[19].ExpectedSlot := 3;
FSteps[19].ExpectedReservations[3] := 1;
{endregion}

{region "20 - Observe execution completion"}
FSteps[20].Children[1].State := E_State.Completed;
FSteps[20].Children[1].Result := E_Result.Passed;
FSteps[20].Children[1].Ready := FALSE;
FSteps[20].Children[1].Complete := TRUE;
FSteps[20].Children[2].State := E_State.Completed;
FSteps[20].Children[2].Result := E_Result.Passed;
FSteps[20].Children[2].Ready := FALSE;
FSteps[20].Children[2].Complete := TRUE;
FSteps[20].Children[3].State := E_State.Completed;
FSteps[20].Children[3].Result := E_Result.Passed;
FSteps[20].Children[3].Ready := FALSE;
FSteps[20].Children[3].Complete := TRUE;
FSteps[20].ExpectedReleasedEntries[3] := 1;
FSteps[20].ExpectedFinished := TRUE;
{endregion}

{region "21 - Completed Execution task is retained"}
FSteps[21].Children[1].State := E_State.Completed;
FSteps[21].Children[1].Result := E_Result.Passed;
FSteps[21].Children[1].Ready := FALSE;
FSteps[21].Children[1].Complete := TRUE;
FSteps[21].Children[2].State := E_State.Completed;
FSteps[21].Children[2].Result := E_Result.Passed;
FSteps[21].Children[2].Ready := FALSE;
FSteps[21].Children[2].Complete := TRUE;
FSteps[21].Children[3].State := E_State.Completed;
FSteps[21].Children[3].Result := E_Result.Passed;
FSteps[21].Children[3].Ready := FALSE;
FSteps[21].Children[3].Complete := TRUE;
FSteps[21].ExpectedFinished := TRUE;
{endregion}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>