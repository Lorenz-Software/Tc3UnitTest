<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Test_OrchestratorChildError" Id="{ce4df53d-3f3c-40b6-8032-eb04d56f2dc6}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Holds a child Error, prevents subsequent Starts and releases only after terminal observation.</summary>
*)
{endregion}
FUNCTION_BLOCK Test_OrchestratorChildError EXTENDS OrchestrationTestBase]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{2a3168fe-6ac3-4a09-9c80-02465eeb634f}" />
    <Method Name="ConfigureScenario" Id="{f7d5b753-3d3f-43dc-93f9-7f5abcdbea82}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Defines independent stimuli and expected requests, reservations, task status and diagnostic counts.</summary>
*)
{endregion}
METHOD PROTECTED ConfigureScenario]]></Declaration>
      <Implementation>
        <ST><![CDATA[FStepCount := 8;

{region "01 - Idle readiness before child processing"}
FSteps[1].Task := E_OrchestratorTask.Idle;
FSteps[1].ExpectedReady := TRUE;
{endregion}

{region "02 - Start first child"}
FSteps[2].Children[1].State := E_State.Running;
FSteps[2].Children[1].Ready := FALSE;
FSteps[2].ExpectedStartChild := 1;
FSteps[2].ExpectedSlot := 1;
FSteps[2].ExpectedReservations[1] := 1;
{endregion}

{region "03 - Child reports Error after helper call"}
FSteps[3].Children[1].State := E_State.Running;
FSteps[3].Children[1].Result := E_Result.Error;
FSteps[3].Children[1].Ready := FALSE;
FSteps[3].ExpectedSlot := 1;
FSteps[3].ExpectedReservations[1] := 1;
{endregion}

{region "04 - Observe Error and retain active reservation"}
FSteps[4].Children[1].State := E_State.Running;
FSteps[4].Children[1].Result := E_Result.Error;
FSteps[4].Children[1].Ready := FALSE;
FSteps[4].ExpectedSlot := 1;
FSteps[4].ExpectedDiagnosticCount := 1;
FSteps[4].ExpectedReservations[1] := 1;
FSteps[4].ExpectedResult := E_Result.Error;
{endregion}

{region "05 - Failing child reaches terminal state"}
FSteps[5].Children[1].State := E_State.Completed;
FSteps[5].Children[1].Result := E_Result.Error;
FSteps[5].Children[1].Ready := FALSE;
FSteps[5].Children[1].Complete := TRUE;
FSteps[5].ExpectedSlot := 1;
FSteps[5].ExpectedDiagnosticCount := 1;
FSteps[5].ExpectedReservations[1] := 1;
FSteps[5].ExpectedResult := E_Result.Error;
{endregion}

{region "06 - Release terminal reservation without advancing execution"}
FSteps[6].Children[1].State := E_State.Completed;
FSteps[6].Children[1].Result := E_Result.Error;
FSteps[6].Children[1].Ready := FALSE;
FSteps[6].Children[1].Complete := TRUE;
FSteps[6].ExpectedSlot := 1;
FSteps[6].ExpectedDiagnosticCount := 1;
FSteps[6].ExpectedReleasedEntries[1] := 1;
FSteps[6].ExpectedResult := E_Result.Error;
{endregion}

{region "07 - Idle must not clear Error"}
FSteps[7].Task := E_OrchestratorTask.Idle;
FSteps[7].Children[1].State := E_State.Completed;
FSteps[7].Children[1].Result := E_Result.Error;
FSteps[7].Children[1].Ready := FALSE;
FSteps[7].Children[1].Complete := TRUE;
FSteps[7].ExpectedDiagnosticCount := 1;
FSteps[7].ExpectedResult := E_Result.Error;
{endregion}

{region "08 - Repeated Idle remains quiet"}
FSteps[8].Task := E_OrchestratorTask.Idle;
FSteps[8].Children[1].State := E_State.Completed;
FSteps[8].Children[1].Result := E_Result.Error;
FSteps[8].Children[1].Ready := FALSE;
FSteps[8].Children[1].Complete := TRUE;
FSteps[8].ExpectedDiagnosticCount := 1;
FSteps[8].ExpectedResult := E_Result.Error;
{endregion}]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>