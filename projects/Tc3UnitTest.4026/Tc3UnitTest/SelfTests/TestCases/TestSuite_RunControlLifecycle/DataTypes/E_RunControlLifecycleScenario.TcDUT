<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_RunControlLifecycleScenario" Id="{8b556d46-497a-4695-9e7c-b16284aa17b6}">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Root failure and Abort stimuli, including continued Reset and preserved Abort deadlines after an error.</summary>
*)
{endregion}
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_RunControlLifecycleScenario :
(
    ResetError, //! Script helper Error during owner Reset.
    ResetTimeout, //! Hold child Reset completion beyond the configured deadline.
    ResetErrorTimeout, //! Combine Reset helper Error with held Reset completion.
    ChildError, //! Script a child technical Error during execution.
    UnexpectedChildAbort, //! Script an unexpected child abort during execution.
    ExecutionError, //! Script helper Error during execution.
    ExecutionTimeout, //! Hold execution completion beyond the configured deadline.
    Abort, //! Request normal owner Abort.
    AbortError, //! Script helper Error during Abort.
    AbortTimeout, //! Hold Abort completion beyond the configured deadline.
    AbortErrorTimeout //! Combine Abort helper Error with held Abort completion.
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>