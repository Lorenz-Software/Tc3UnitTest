<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TestSuite_ParallelSlotsOrchestration" Id="{3a0dd6f6-9525-473f-ae52-935cb51f49ca}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Runs focused ParallelSlots Orchestrator scenarios serially with isolated child observations and diagnostics.</summary>
*)
{endregion}
FUNCTION_BLOCK TestSuite_ParallelSlotsOrchestration EXTENDS TestSuiteBase
VAR
    FWaitForGroupCompletion : Test_SlotsWaitForGroupCompletion;
    FFinalGroupCompletion : Test_SlotsFinalGroupCompletion;
    FFirstFittingAdmission : Test_SlotsFirstFittingAdmission;
    FMissingStartReaction : Test_SlotsMissingStartReaction;
    FNextSlotReadinessLost : Test_SlotsNextSlotReadinessLost;
    FAbortAtBoundary : Test_SlotsAbortAtBoundary;
    FTestCases : ARRAY[1..TestCaseCapacity] OF I_TestCase;
END_VAR
VAR CONSTANT
    TestCaseCapacity : UINT := 6;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{adcb4640-53ab-4cfa-8e99-000000000002}" />
    <Method Name="Configure" Id="{adcb4640-53ab-4cfa-8e99-000000000003}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes and registers the owned orchestration scenarios in deterministic order.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR_IN_OUT
    // SA0167: Borrowed builder; VAR_IN_OUT creates no temporary instance.
    {attribute 'analysis' := '-167'}
    Builder : TestSuiteConfigurationBuilder; //! Borrowed owner configuration builder used only during this Configure call; register this owner's concrete children.
END_VAR
VAR
    TestConfig : ST_TestCaseConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Builder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestCases := FTestCases);

FWaitForGroupCompletion.Initialize(Parent := THIS^,
    TestName := 'WaitForGroupCompletion',
    Config := TestConfig);
Builder.Register(TestCase := FWaitForGroupCompletion);

FFinalGroupCompletion.Initialize(Parent := THIS^,
    TestName := 'FinalGroupCompletion',
    Config := TestConfig);
Builder.Register(TestCase := FFinalGroupCompletion);

FFirstFittingAdmission.Initialize(Parent := THIS^,
    TestName := 'FirstFittingAdmission',
    Config := TestConfig);
Builder.Register(TestCase := FFirstFittingAdmission);

FMissingStartReaction.Initialize(Parent := THIS^,
    TestName := 'MissingStartReaction',
    Config := TestConfig);
Builder.Register(TestCase := FMissingStartReaction);

FNextSlotReadinessLost.Initialize(Parent := THIS^,
    TestName := 'NextSlotReadinessLost',
    Config := TestConfig);
Builder.Register(TestCase := FNextSlotReadinessLost);

FAbortAtBoundary.Initialize(Parent := THIS^,
    TestName := 'AbortAtBoundary',
    Config := TestConfig);
Builder.Register(TestCase := FAbortAtBoundary);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetTestCase" Id="{adcb4640-53ab-4cfa-8e99-000000000004}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Returns the registered Test Case from the same array used during configuration.</summary>
*)
{endregion}
METHOD PUBLIC GetTestCase : I_TestCase //! Typed child interface at the original array index; zero when no entry is available.
VAR_INPUT
    Index : DINT; //! Original occupied child-array index, rather than an ordinal position.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetTestCase := 0;
IF (ChildCount = 0) OR (Index < ChildArrayLowerBound)
    OR (DINT_TO_LINT(Index) >= DINT_TO_LINT(ChildArrayLowerBound) + UINT_TO_LINT(ChildCount)) THEN
    RETURN;
END_IF;

GetTestCase := FTestCases[Index];]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTestCases" Id="{adcb4640-53ab-4cfa-8e99-000000000005}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls each owned Test Case once per initialized Suite cycle, including completion.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTestCases]]></Declaration>
      <Implementation>
        <ST><![CDATA[FWaitForGroupCompletion();
FFinalGroupCompletion();
FFirstFittingAdmission();
FMissingStartReaction();
FNextSlotReadinessLost();
FAbortAtBoundary();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>