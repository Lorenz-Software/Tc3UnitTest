<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TestSuite_Preparation" Id="{21d11f7e-0b1a-4b22-9da1-45a58b0cdc3c}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Verifies Preparation status, resource actions and lifecycle handover in serial Test Cases.</summary>
*)
{endregion}
FUNCTION_BLOCK TestSuite_Preparation EXTENDS TestSuiteBase
VAR
    FInitialStatus : Test_PreparationInitialStatus;
    FStatusProjection : Test_PreparationStatusProjection;
    FDisabledObservation : Test_PreparationDisabledObservation;
    FReachesTarget : Test_PreparationReachesTarget;
    FDisableAndReenable : Test_PreparationDisableAndReenable;
    FCompletionTracksTarget : Test_PreparationCompletionTracksTarget;
    FResourceError : Test_PreparationResourceError;
    FMockInputs : Test_PreparationMockInputs;
    FTestCases : ARRAY[1..TestCaseCapacity] OF I_TestCase;
END_VAR
VAR CONSTANT
    TestCaseCapacity : UINT := 8;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{bee9ec6b-1c92-499f-af07-51237b78e1a4}" />
    <Method Name="Configure" Id="{730cbdb1-6a41-4835-b480-28e02a5c3075}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes all Preparation Test Cases and registers their deterministic serial order.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR_IN_OUT
    // SA0167: Borrowed builder; VAR_IN_OUT creates no temporary instance.
    {attribute 'analysis' := '-167'}
    Builder : TestSuiteConfigurationBuilder; //! Borrowed owner configuration builder used only during this Configure call; register this owner's concrete children.
END_VAR
VAR
    TestConfig : ST_TestCaseConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Builder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestCases := FTestCases);

FInitialStatus.Initialize(Parent := THIS^,
    TestName := 'InitialStatus',
    Config := TestConfig);
Builder.Register(TestCase := FInitialStatus);

FStatusProjection.Initialize(Parent := THIS^,
    TestName := 'StatusProjection',
    Config := TestConfig);
Builder.Register(TestCase := FStatusProjection);

FDisabledObservation.Initialize(Parent := THIS^,
    TestName := 'DisabledObservation',
    Config := TestConfig);
Builder.Register(TestCase := FDisabledObservation);

FReachesTarget.Initialize(Parent := THIS^,
    TestName := 'ReachesTarget',
    Config := TestConfig);
Builder.Register(TestCase := FReachesTarget);

FDisableAndReenable.Initialize(Parent := THIS^,
    TestName := 'DisableAndReenable',
    Config := TestConfig);
Builder.Register(TestCase := FDisableAndReenable);

FCompletionTracksTarget.Initialize(Parent := THIS^,
    TestName := 'CompletionTracksTarget',
    Config := TestConfig);
Builder.Register(TestCase := FCompletionTracksTarget);

FResourceError.Initialize(Parent := THIS^,
    TestName := 'ResourceError',
    Config := TestConfig);
Builder.Register(TestCase := FResourceError);

FMockInputs.Initialize(Parent := THIS^,
    TestName := 'MockInputs',
    Config := TestConfig);
Builder.Register(TestCase := FMockInputs);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetTestCase" Id="{8e2efb59-9d32-4866-a08e-2181df645ad7}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Returns the registered Test Case from the same array used during configuration.</summary>
*)
{endregion}
METHOD PUBLIC GetTestCase : I_TestCase //! Typed child interface at the original array index; zero when no entry is available.
VAR_INPUT
    Index : DINT; //! Original occupied child-array index, rather than an ordinal position.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetTestCase := 0;
IF (ChildCount = 0) OR (Index < ChildArrayLowerBound)
    OR (DINT_TO_LINT(Index) >= DINT_TO_LINT(ChildArrayLowerBound) + UINT_TO_LINT(ChildCount)) THEN
    RETURN;
END_IF;

GetTestCase := FTestCases[Index];]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTestCases" Id="{2496c205-1ca9-4084-b392-b9629e5929d2}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls each owned Test Case once per initialized Suite cycle, including completion.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTestCases]]></Declaration>
      <Implementation>
        <ST><![CDATA[FInitialStatus();
FStatusProjection();
FDisabledObservation();
FReachesTarget();
FDisableAndReenable();
FCompletionTracksTarget();
FResourceError();
FMockInputs();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>