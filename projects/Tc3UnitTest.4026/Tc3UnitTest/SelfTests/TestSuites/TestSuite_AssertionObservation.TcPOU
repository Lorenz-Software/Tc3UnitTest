<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TestSuite_AssertionObservation" Id="{a2743eb1-23b8-4895-a106-e0ff2efd9289}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Checks temporal Assertion observation with isolated, deterministic cycle traces.</summary>
*)
{endregion}
FUNCTION_BLOCK TestSuite_AssertionObservation EXTENDS TestSuiteBase
VAR
    FEdgeObservation : Test_AssertionEdgeObservation;
    FEdgeCount : Test_AssertionEdgeCount;
    FSequence : Test_AssertionSequence;
    FScalarObservation : Test_AssertionScalarObservation;
    FArraySnapshot : Test_AssertionArraySnapshot;
    FFloatingSnapshot : Test_AssertionFloatingSnapshot;
    FTestCases : ARRAY[1..TestCaseCapacity] OF I_TestCase;
END_VAR
VAR CONSTANT
    TestCaseCapacity : UINT := 6;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{c5606fa7-d727-42c1-bf47-ecb0302ee833}" />
    <Method Name="Configure" Id="{49241f70-dfb8-46f9-935c-5e0e9555455c}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes six isolated observation scenarios and registers them serially.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR_IN_OUT
    // SA0167: Borrowed owner builder; no temporary instance is created.
    {attribute 'analysis' := '-167'}
    Builder : TestSuiteConfigurationBuilder; //! Borrowed owner configuration builder used only during this Configure call; register this owner's concrete children.
END_VAR
VAR
    TestConfig : ST_TestCaseConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Builder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestCases := FTestCases);
FEdgeObservation.Initialize(Parent := THIS^,
    TestName := 'EdgeObservation',
    Config := TestConfig);
Builder.Register(TestCase := FEdgeObservation);
FEdgeCount.Initialize(Parent := THIS^,
    TestName := 'EdgeCount',
    Config := TestConfig);
Builder.Register(TestCase := FEdgeCount);
FSequence.Initialize(Parent := THIS^,
    TestName := 'Sequence',
    Config := TestConfig);
Builder.Register(TestCase := FSequence);
FScalarObservation.Initialize(Parent := THIS^,
    TestName := 'ScalarObservation',
    Config := TestConfig);
Builder.Register(TestCase := FScalarObservation);
FArraySnapshot.Initialize(Parent := THIS^,
    TestName := 'ArraySnapshot',
    Config := TestConfig);
Builder.Register(TestCase := FArraySnapshot);
FFloatingSnapshot.Initialize(Parent := THIS^,
    TestName := 'FloatingSnapshot',
    Config := TestConfig);
Builder.Register(TestCase := FFloatingSnapshot);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetTestCase" Id="{6b10f84d-4398-4698-8601-29e1013250c1}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Returns a registered scenario using its original array index.</summary>
*)
{endregion}
METHOD PUBLIC GetTestCase : I_TestCase //! Typed child interface at the original array index; zero when no entry is available.
VAR_INPUT
    Index : DINT; //! Original occupied child-array index, rather than an ordinal position.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetTestCase := 0;
IF (ChildCount = 0) OR (Index < ChildArrayLowerBound)
    OR (DINT_TO_LINT(Index) >= DINT_TO_LINT(ChildArrayLowerBound) + UINT_TO_LINT(ChildCount)) THEN
    RETURN;
END_IF;
GetTestCase := FTestCases[Index];]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTestCases" Id="{3cd027ed-51f7-484e-a661-a92d2339ec87}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls every owned scenario once per initialized Suite cycle.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTestCases]]></Declaration>
      <Implementation>
        <ST><![CDATA[FEdgeObservation();
FEdgeCount();
FSequence();
FScalarObservation();
FArraySnapshot();
FFloatingSnapshot();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>