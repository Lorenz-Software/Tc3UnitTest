<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="TestSuite_Orchestrator" Id="{8b2623af-6e53-4da6-9946-8ea0f1dd998a}" SpecialFunc="None">
    <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Verifies common Orchestrator behavior through isolated subjects with a Serial arrangement.</summary>
*)
{endregion}
FUNCTION_BLOCK TestSuite_Orchestrator EXTENDS TestSuiteBase
VAR
    FShiftedBounds : Test_OrchestratorShiftedBounds;
    FNegativeBounds : Test_OrchestratorNegativeBounds;
    FUnusedCapacity : Test_OrchestratorUnusedCapacity;
    FSingleChild : Test_OrchestratorSingleChild;
    FIdleReadiness : Test_OrchestratorIdleReadiness;
    FMissingStartReaction : Test_OrchestratorMissingStartReaction;
    FChildError : Test_OrchestratorChildError;
    FUnexpectedAbort : Test_OrchestratorUnexpectedAbort;
    FAbortInterruption : Test_OrchestratorAbortInterruption;
    FIdleInterruption : Test_OrchestratorIdleInterruption;
    FResetInterruption : Test_OrchestratorResetInterruption;
    FResetContinuesAfterError : Test_OrchestratorResetContinuesAfterError;
    FRepeatAfterReset : Test_OrchestratorRepeatAfterReset;
    FExecutionCapacityWait : Test_OrchestratorExecutionCapacityWait;
    FResetCapacityWait : Test_OrchestratorResetCapacityWait;
    FExecutionBudgetError : Test_OrchestratorExecutionBudgetError;
    FTestCases : ARRAY[1..TestCaseCapacity] OF I_TestCase;
END_VAR
VAR CONSTANT
    TestCaseCapacity : UINT := 16;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();]]></ST>
    </Implementation>
    <Folder Name="Internal" Id="{160f90b1-49a7-4da6-95d7-dfacab7a583d}" />
    <Method Name="Configure" Id="{908195b6-9494-48bb-b879-29900e5c1cab}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Initializes and registers the owned orchestration scenarios in deterministic order.</summary>
*)
{endregion}
METHOD PROTECTED Configure
VAR_IN_OUT
    // SA0167: Borrowed builder; VAR_IN_OUT creates no temporary instance.
    {attribute 'analysis' := '-167'}
    Builder : TestSuiteConfigurationBuilder; //! Borrowed owner configuration builder used only during this Configure call; register this owner's concrete children.
END_VAR
VAR
    TestConfig : ST_TestCaseConfig;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Builder.Initialize(Mode := E_OrchestrationMode.Serial,
    TestCases := FTestCases);

FShiftedBounds.Initialize(Parent := THIS^,
    TestName := 'ShiftedBounds',
    Config := TestConfig);
Builder.Register(TestCase := FShiftedBounds);

FNegativeBounds.Initialize(Parent := THIS^,
    TestName := 'NegativeBounds',
    Config := TestConfig);
Builder.Register(TestCase := FNegativeBounds);

FUnusedCapacity.Initialize(Parent := THIS^,
    TestName := 'UnusedCapacity',
    Config := TestConfig);
Builder.Register(TestCase := FUnusedCapacity);

FSingleChild.Initialize(Parent := THIS^,
    TestName := 'SingleChild',
    Config := TestConfig);
Builder.Register(TestCase := FSingleChild);

FIdleReadiness.Initialize(Parent := THIS^,
    TestName := 'IdleReadiness',
    Config := TestConfig);
Builder.Register(TestCase := FIdleReadiness);

FMissingStartReaction.Initialize(Parent := THIS^,
    TestName := 'MissingStartReaction',
    Config := TestConfig);
Builder.Register(TestCase := FMissingStartReaction);

FChildError.Initialize(Parent := THIS^,
    TestName := 'ChildError',
    Config := TestConfig);
Builder.Register(TestCase := FChildError);

FUnexpectedAbort.Initialize(Parent := THIS^,
    TestName := 'UnexpectedAbort',
    Config := TestConfig);
Builder.Register(TestCase := FUnexpectedAbort);

FAbortInterruption.Initialize(Parent := THIS^,
    TestName := 'AbortInterruption',
    Config := TestConfig);
Builder.Register(TestCase := FAbortInterruption);

FIdleInterruption.Initialize(Parent := THIS^,
    TestName := 'IdleInterruption',
    Config := TestConfig);
Builder.Register(TestCase := FIdleInterruption);

FResetInterruption.Initialize(Parent := THIS^,
    TestName := 'ResetInterruption',
    Config := TestConfig);
Builder.Register(TestCase := FResetInterruption);

FResetContinuesAfterError.Initialize(Parent := THIS^,
    TestName := 'ResetContinuesAfterError',
    Config := TestConfig);
Builder.Register(TestCase := FResetContinuesAfterError);

FRepeatAfterReset.Initialize(Parent := THIS^,
    TestName := 'RepeatAfterReset',
    Config := TestConfig);
Builder.Register(TestCase := FRepeatAfterReset);

FExecutionCapacityWait.Initialize(Parent := THIS^,
    TestName := 'ExecutionCapacityWait',
    Config := TestConfig);
Builder.Register(TestCase := FExecutionCapacityWait);

FResetCapacityWait.Initialize(Parent := THIS^,
    TestName := 'ResetCapacityWait',
    Config := TestConfig);
Builder.Register(TestCase := FResetCapacityWait);

FExecutionBudgetError.Initialize(Parent := THIS^,
    TestName := 'ExecutionBudgetError',
    Config := TestConfig);
Builder.Register(TestCase := FExecutionBudgetError);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetTestCase" Id="{d505b422-f992-4c33-bca8-2e718886b02b}">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Returns the registered Test Case from the same array used during configuration.</summary>
*)
{endregion}
METHOD PUBLIC GetTestCase : I_TestCase //! Typed child interface at the original array index; zero when no entry is available.
VAR_INPUT
    Index : DINT; //! Original occupied child-array index, rather than an ordinal position.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetTestCase := 0;
IF (ChildCount = 0) OR (Index < ChildArrayLowerBound)
    OR (DINT_TO_LINT(Index) >= DINT_TO_LINT(ChildArrayLowerBound) + UINT_TO_LINT(ChildCount)) THEN
    RETURN;
END_IF;

GetTestCase := FTestCases[Index];]]></ST>
      </Implementation>
    </Method>
    <Method Name="ProcessTestCases" Id="{2fcc2388-3d0c-4099-8979-6c805065da90}" FolderPath="Internal\">
      <Declaration><![CDATA[{region 'Documentation'}
(*!
<summary>Calls each owned Test Case once per initialized Suite cycle, including completion.</summary>
*)
{endregion}
METHOD PROTECTED ProcessTestCases]]></Declaration>
      <Implementation>
        <ST><![CDATA[FShiftedBounds();
FNegativeBounds();
FUnusedCapacity();
FSingleChild();
FIdleReadiness();
FMissingStartReaction();
FChildError();
FUnexpectedAbort();
FAbortInterruption();
FIdleInterruption();
FResetInterruption();
FResetContinuesAfterError();
FRepeatAfterReset();
FExecutionCapacityWait();
FResetCapacityWait();
FExecutionBudgetError();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>